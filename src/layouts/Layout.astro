---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  fontSource?: "google" | "local";
}

const defaultDescription = "Marker makes enterprises AI-native. AI-native competitors are coming for every legacy business. We embed, ship working automations, and leave your company running differently.";
const {
  title,
  description = defaultDescription,
  noindex = false,
  fontSource = "google",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, "https://onmarker.com").href.replace(/\/$/, "") || "https://onmarker.com";
const ogImage = "https://onmarker.com/logo.png";
const LOCAL_FONT_CSS = `
  @font-face {
    font-family: "Plus Jakarta Sans";
    src: url("/fonts/SpaceGrotesk-Regular.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Plus Jakarta Sans";
    src: url("/fonts/SpaceGrotesk-Medium.ttf") format("truetype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Plus Jakarta Sans";
    src: url("/fonts/SpaceGrotesk-SemiBold.ttf") format("truetype");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Plus Jakarta Sans";
    src: url("/fonts/SpaceGrotesk-Bold.ttf") format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FDFAF5" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@markerhq" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- DNS Prefetch -->
    <link rel="dns-prefetch" href="https://js-na2.hs-scripts.com" />
    <link rel="dns-prefetch" href="https://cdn.amplitude.com" />
    <link rel="dns-prefetch" href="https://app.termly.io" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    {fontSource === "local" ? (
      <style is:inline>{LOCAL_FONT_CSS}</style>
    ) : (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        />
      </>
    )}
    <title>{title}</title>
    <script is:inline src="https://app.termly.io/resource-blocker/12b5ead1-e229-43ff-a44c-1394e5dbbdd6?autoBlock=on"></script>
    <Analytics />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground">
      Skip to main content
    </a>
    <slot />
    <script is:inline>if ('scrollRestoration' in history) history.scrollRestoration = 'manual';</script>
    <script>
      // Scroll reveal — triggers .is-visible when elements enter viewport
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('.ink-reveal').forEach((el) => observer.observe(el));
      } else {
        // Reduced motion: make everything visible immediately
        document.querySelectorAll('.ink-reveal').forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
