---
import "../styles/global.css";

interface Props {
  title: string;
  noindex?: boolean;
  fontSource?: "google" | "local";
}

const {
  title,
  noindex = false,
  fontSource = "google",
} = Astro.props;
const LOCAL_INTER_CSS = `
  @font-face {
    font-family: "Inter";
    src: url("/fonts/Inter-Regular.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Inter";
    src: url("/fonts/Inter-Medium.ttf") format("truetype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Inter";
    src: url("/fonts/Inter-SemiBold.ttf") format("truetype");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Inter";
    src: url("/fonts/Inter-Bold.ttf") format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Marker is an AI-powered orchestrator that acts as your always-on retail supply chain coordinator. It syncs data, tracks handoffs, and moves work forward autonomously." />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {fontSource === "local" ? (
      <style is:inline>{LOCAL_INTER_CSS}</style>
    ) : (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        />
      </>
    )}
    <title>{title}</title>
    <script is:inline src="https://app.termly.io/resource-blocker/12b5ead1-e229-43ff-a44c-1394e5dbbdd6?autoBlock=on"></script>
    <script is:inline>
      (function() {
        var allowed = ['onmarker.com', 'www.onmarker.com'];
        if (allowed.indexOf(window.location.hostname) !== -1) {
          var s = document.createElement('script');
          s.type = 'text/javascript';
          s.id = 'hs-script-loader';
          s.async = true;
          s.defer = true;
          s.src = '//js-na2.hs-scripts.com/245531796.js';
          document.head.appendChild(s);
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground">
      Skip to main content
    </a>
    <slot />
  </body>
</html>
