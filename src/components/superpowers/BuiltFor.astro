<section class="relative bg-muted bg-paper py-24 md:py-32 mat-bevel" aria-labelledby="builtfor-heading">
  <div class="relative z-10 mx-auto max-w-7xl px-8">
    <div class="max-w-3xl">
      <p class="ink-reveal text-xs font-semibold uppercase tracking-[0.12em] text-primary/70 mb-4">
        Who it's for
      </p>
      <h2 id="builtfor-heading" class="ink-reveal text-3xl font-bold tracking-tight text-foreground leading-[1.15] md:text-4xl">
        Built for retail leaders who live in email.
      </h2>
      <p class="ink-reveal mt-6 text-muted-foreground md:text-lg leading-relaxed" style="--reveal-delay: 120">
        If your week disappears into supplier email — chasing replies, hunting for one buried thread, retyping the same five messages — this is your way out. Most operators feel the difference inside two weeks.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {personas.map((persona, i) => (
        <div class="ink-reveal builtfor-card" style={`--reveal-delay: ${200 + i * 100}`}>
          <div class="builtfor-icon">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={persona.icon} />
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-foreground">{persona.role}</h3>
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{persona.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .builtfor-card {
    padding: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid #E8DFD0;
    background: #FAF6F0;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .builtfor-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 16px #E8DFD060;
  }

  .builtfor-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    background: #3A7D5610;
    color: #3A7D56;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
