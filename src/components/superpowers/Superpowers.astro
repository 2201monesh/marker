---

<section id="features" class="relative py-24 md:py-32" aria-labelledby="superpowers-heading">
  <div class="relative z-10 mx-auto max-w-7xl px-8">
    <div class="max-w-3xl">
      <p class="ink-reveal text-xs font-semibold uppercase tracking-[0.12em] text-primary/70 mb-4">
        Six superpowers
      </p>
      <h2 id="superpowers-heading" class="ink-reveal text-debossed text-3xl font-bold tracking-tight text-foreground leading-[1.15] md:text-4xl">
        What your inbox does for you now.
      </h2>
      <p class="ink-reveal mt-6 text-muted-foreground md:text-lg leading-relaxed" style="--reveal-delay: 120">
        Each one earns its keep on day one. Together they collapse hours of triage and follow-up into minutes.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {powers.map((power, i) => (
        <div class="ink-reveal card-raised group relative rounded-xl bg-background p-7 transition-all duration-300 hover:-translate-y-1" style={`--reveal-delay: ${150 + i * 80}`}>
          <div class="badge-raised mb-4 flex h-10 w-10 items-center justify-center rounded-lg" style="background: rgba(58,125,86,0.08);">
            <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={power.icon} />
            </svg>
          </div>
          <p class="text-xs font-semibold uppercase tracking-[0.1em] text-primary/70">{power.name}</p>
          <h3 class="mt-1 text-lg font-semibold text-foreground leading-snug">{power.title}</h3>
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{power.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
