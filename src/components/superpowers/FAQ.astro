---
const faqs = [
  {
    q: "Do I get charged during the trial?",
    a: "No. We collect a card so we can convert seamlessly when the trial ends, but no charge happens until day 31. We email a reminder 7 days before, and you can cancel any time from inside the app — no email tag, no retention call.",
  },
  {
    q: "Can I start with a personal card and switch to a company card later?",
    a: "Yes. Plenty of people start the trial on a personal card so they can try Marker before going through procurement. Swap to your company card any time from your billing settings — before or after the first charge.",
  },
  {
    q: "What inboxes do you support?",
    a: "Gmail (Google Workspace and personal) and Outlook (Microsoft 365 and Outlook.com). The sidebar runs in Chrome, Edge, Arc, Safari, and inside the native Outlook desktop client.",
  },
  {
    q: "Will Marker auto-send anything to my suppliers?",
    a: "Never. The whole point is that nothing leaves your inbox without you reading it. Marker drafts replies in your voice and queues them for your one-click approval. You always click send.",
  },
  {
    q: "Does my IT team need to install anything?",
    a: "No IT ticket required for an individual seat. For team rollout we offer admin-managed installs in Google Workspace and Microsoft 365 — usually a 15-minute call with your admin.",
  },
  {
    q: "What does Marker actually see?",
    a: "Marker reads your supplier email to draft replies, extract structured data (tracking numbers, lab results, tech packs), and build templates from your past sent mail. Inbox data is encrypted in transit and at rest, used to personalize your Marker and improve the product over time, and you can delete it from your account any time. Full data handling details are in the Trust Center.",
  },
  {
    q: "Can I invite my teammates during the trial?",
    a: "Yes — one of the things we measure is in-team expansion during trial. Add a teammate from the sidebar and they'll be on the same trial through day 30, no extra card needed.",
  },
  {
    q: "What happens at the end of the trial?",
    a: "On day 31 we charge $49 per active seat per month and you keep going. If you cancel before then, your seats are removed and we don't charge anything.",
  },
];
---

<section id="faq" class="relative py-24 md:py-32" aria-labelledby="faq-heading">
  <div class="relative z-10 mx-auto max-w-4xl px-8">
    <p class="ink-reveal text-xs font-semibold uppercase tracking-[0.12em] text-primary/70 mb-4">
      FAQ
    </p>
    <h2 id="faq-heading" class="ink-reveal text-debossed text-3xl font-bold tracking-tight text-foreground leading-[1.15] md:text-4xl">
      Questions before the trial
    </h2>

    <div class="mt-12 space-y-3">
      {faqs.map((faq, i) => (
        <details class="ink-reveal faq-item" style={`--reveal-delay: ${100 + i * 60}`}>
          <summary class="faq-question">
            <span>{faq.q}</span>
            <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <p class="faq-answer">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item {
    border-radius: 0.75rem;
    border: 1px solid rgba(45, 36, 24, 0.08);
    background: #FFFBF5;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      0 1px 2px rgba(45, 36, 24, 0.04);
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }

  .faq-item[open] {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      0 4px 12px rgba(45, 36, 24, 0.06);
  }

  .faq-question {
    list-style: none;
    cursor: pointer;
    padding: 1.125rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--foreground, #2D2418);
    line-height: 1.4;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    width: 1rem;
    height: 1rem;
    color: var(--muted-foreground, #7D6B4F);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.25rem 1.25rem;
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted-foreground, #6B5638);
    line-height: 1.6;
  }
</style>
