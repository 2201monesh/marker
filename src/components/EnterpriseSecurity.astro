---

---

<section id="security" class="relative py-24 md:py-32" aria-labelledby="security-heading">
  <div class="relative z-10 mx-auto max-w-7xl px-8">
    <div class="max-w-3xl">
      <p class="ink-reveal text-xs font-semibold uppercase tracking-[0.12em] text-primary/70 mb-4">
        Enterprise-grade security
      </p>
      <h2 id="security-heading" class="ink-reveal text-debossed text-3xl font-bold tracking-tight text-foreground leading-[1.15] md:text-4xl">
        AI that your security team will actually approve.
      </h2>
      <p class="ink-reveal mt-6 text-muted-foreground md:text-lg leading-relaxed" style="--reveal-delay: 120">
        Intelligence and execution, kept separate. Your systems of record stay protected at every layer.
      </p>
    </div>

    <div class="mt-14 grid gap-px md:grid-cols-3 security-grid">
      <!-- Pillar 1: Separated execution -->
      <div class="ink-reveal security-pillar" style="--reveal-delay: 200">
        <div class="security-pillar-number">1</div>
        <h3 class="mt-4 text-base font-semibold text-foreground">Agents can't touch your systems</h3>
        <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
          Agents reason and recommend. A hardened execution layer handles every read and write — so a rogue agent can't act on your systems.
        </p>
      </div>

      <!-- Pillar 2: Fine-grained access -->
      <div class="ink-reveal security-pillar" style="--reveal-delay: 300">
        <div class="security-pillar-number">2</div>
        <h3 class="mt-4 text-base font-semibold text-foreground">Least-privilege by default</h3>
        <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
          Fine-grained access on every system you connect — even when the system doesn't support it natively. No more permissions than the action requires.
        </p>
      </div>

      <!-- Pillar 3: Human-in-the-loop -->
      <div class="ink-reveal security-pillar" style="--reveal-delay: 400">
        <div class="security-pillar-number">3</div>
        <h3 class="mt-4 text-base font-semibold text-foreground">You decide what needs approval</h3>
        <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
          Add approval gates at any point in any workflow. Start with approval on everything, loosen as you build trust.
        </p>
      </div>
    </div>

    <!-- Compliance badges -->
    <div class="ink-reveal mt-10 flex flex-wrap items-center gap-6" style="--reveal-delay: 500">
      <div class="security-badge">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        <span>SOC 2 Type II in progress</span>
      </div>
      <div class="security-badge">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        <span>ISO 27001 in progress</span>
      </div>
      <a href="https://trust.onmarker.com/" class="security-badge security-badge--link">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
        <span>Trust Center</span>
      </a>
    </div>
  </div>
</section>

<style>
  .security-grid {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid #E8DFD0;
    background: #E8DFD0;
  }

  .security-pillar {
    padding: 1.75rem;
    background: #FAF6F0;
  }

  .security-pillar-number {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: #3A7D56;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    border: 1px solid rgba(0, 0, 0, 0.12);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 2px 4px rgba(0, 0, 0, 0.2),
      inset 0 -1px 2px rgba(255, 255, 255, 0.08);
  }

  .security-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground, #7D6B4F);
  }

  .security-badge--link {
    color: var(--primary, #3A7D56);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .security-badge--link:hover {
    opacity: 0.7;
  }
</style>
