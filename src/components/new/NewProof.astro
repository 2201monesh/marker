---
// NewProof — light "PROOF" section with the tabbed case-study widget.
// Tab bar sits on the page background; the active tab is black and merges
// with the black frame below it (browser-tab style, with concave fillets).
// Refs: .context/attachments/w7FOib/slices/slice_4.png, slice_0.png,
//       z_tabs.png, z_proof_table.png
import { Image, getImage } from "astro:assets";
import Eyebrow from "./Eyebrow.astro";
import DotArrow from "./DotArrow.astro";
import chipBorder4 from "../../assets/landing/chip-border-4.png";
import downArrow from "../../assets/landing/down-arrow.png";

const chipBorder4Img = await getImage({ src: chipBorder4, format: "png" });
---

<section id="the-proof" class="nl-proof" aria-labelledby="new-proof-heading">
  <div class="nl-container">
    <Eyebrow label="PROOF" class="nl-proof-eyebrow" />

    <h2 id="new-proof-heading" class="nl-display nl-h2">
      What this looks like<span class="nl-hl nl-proof-hl">today</span>
    </h2>

    <div class="nl-proof-widget" data-proof-tabs>
      <div class="nl-proof-tablist" role="tablist" aria-label="Case studies">
        <button
          type="button"
          id="nl-proof-tab-retailer"
          class="nl-proof-tab nl-label"
          role="tab"
          aria-selected="true"
          aria-controls="nl-proof-panel-retailer"
        >FORTUNE 500 RETAILER</button>
        <button
          type="button"
          id="nl-proof-tab-proptech"
          class="nl-proof-tab nl-label"
          role="tab"
          aria-selected="false"
          aria-controls="nl-proof-panel-proptech"
          tabindex="-1"
        >8-FIGURE PROP-TECH COMPANY</button>
      </div>

      <div class="nl-proof-frame">
        <!-- Panel A: Fortune 500 retailer -->
        <div
          id="nl-proof-panel-retailer"
          class="nl-proof-panel"
          role="tabpanel"
          aria-labelledby="nl-proof-tab-retailer"
        >
          <div class="nl-proof-copy">
            <h3 class="nl-display nl-proof-h3">
              Manual work,<br />
              <span class="nl-proof-h3-accent">down by 80%.</span>
            </h3>
            <p class="nl-proof-body">
              <span class="nl-proof-body-dim">In product operations, automated on the systems they already run.</span>
              Next up: assortment and buying, reimagined from the ground up.
            </p>
            <dl class="nl-proof-table">
              <div class="nl-proof-row">
                <dt class="nl-label">PRODUCT OPS</dt>
                <dd class="nl-label">MANUAL WORK DOWN 80%</dd>
              </div>
              <div class="nl-proof-row">
                <dt class="nl-label">NEXT UP</dt>
                <dd class="nl-label">ASSORTMENT &amp; BUYING, REBUILT GROUND-UP</dd>
              </div>
              <div class="nl-proof-row">
                <dt class="nl-label">APPROACH</dt>
                <dd class="nl-label">EMBEDDED INSIDE, ON EXISTING SYSTEMS</dd>
              </div>
            </dl>
          </div>
          <div class="nl-proof-visual" aria-hidden="true">
            <div class="nl-proof-bar-gray nl-halftone-dark"></div>
            <div class="nl-proof-bar-orange">
              <Image src={downArrow} alt="" class="nl-proof-bar-arrow" width={86} height={86} />
              <span class="nl-display nl-proof-bar-stat">80%</span>
            </div>
          </div>
        </div>

        <!-- Panel B: 8-figure prop-tech company -->
        <div
          id="nl-proof-panel-proptech"
          class="nl-proof-panel"
          role="tabpanel"
          aria-labelledby="nl-proof-tab-proptech"
          hidden
        >
          <div class="nl-proof-copy">
            <h3 class="nl-display nl-proof-h3">
              Onboarding,<br />
              <span class="nl-proof-h3-accent">120 days to 60.</span>
            </h3>
            <p class="nl-proof-body">
              <span class="nl-proof-body-dim">Client onboarding, automated end-to-end on the systems they already run.</span>
              Next up: manual QA down 95%, and the first agent live in days.
            </p>
            <dl class="nl-proof-table">
              <div class="nl-proof-row">
                <dt class="nl-label">ONBOARDING</dt>
                <dd class="nl-label">120 DAYS <svg class="nl-proof-row-arrow" width="12" height="12" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M2.5 8.5h11.2m0 0L9.4 4.2m4.3 4.3l-4.3 4.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg> 60 DAYS</dd>
              </div>
              <div class="nl-proof-row">
                <dt class="nl-label">NEXT UP</dt>
                <dd class="nl-label">MANUAL QA, DOWN 95%</dd>
              </div>
              <div class="nl-proof-row">
                <dt class="nl-label">APPROACH</dt>
                <dd class="nl-label">EMBEDDED INSIDE, ON REAL DATA</dd>
              </div>
            </dl>
          </div>
          <div class="nl-proof-visual" aria-hidden="true">
            <div class="nl-proof-bar-gray nl-halftone-dark">
              <span class="nl-display nl-proof-bar-gray-label">120 Days</span>
            </div>
            <div class="nl-proof-bar-orange">
              <Image src={downArrow} alt="" class="nl-proof-bar-arrow" width={86} height={86} />
              <span class="nl-display nl-proof-bar-stat">60 Days</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const widgets = document.querySelectorAll<HTMLElement>("[data-proof-tabs]");

  widgets.forEach((widget) => {
    const tabs = Array.from(
      widget.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    );
    const panels = Array.from(
      widget.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    );

    const FADE_MS = 220;

    const select = (tab: HTMLButtonElement, focus = false) => {
      const targetId = tab.getAttribute("aria-controls");
      const currentPanel = panels.find((p) => !p.hidden);
      const nextPanel = panels.find((p) => p.id === targetId);

      tabs.forEach((t) => {
        const active = t === tab;
        t.setAttribute("aria-selected", String(active));
        t.tabIndex = active ? 0 : -1;
      });

      const fadeTargets = (panel: HTMLElement | undefined) =>
        panel
          ? Array.from(panel.querySelectorAll<HTMLElement>(".nl-proof-visual, .nl-proof-copy"))
          : [];

      const swapPanels = () => {
        panels.forEach((panel) => {
          panel.hidden = panel.id !== targetId;
        });
        const nextFadeEls = fadeTargets(nextPanel);
        nextFadeEls.forEach((el) => el.classList.add("is-fading"));
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            nextFadeEls.forEach((el) => el.classList.remove("is-fading"));
          });
        });
      };

      const currentFadeEls = fadeTargets(currentPanel);
      if (currentPanel && currentPanel !== nextPanel && currentFadeEls.length) {
        currentFadeEls.forEach((el) => el.classList.add("is-fading"));
        window.setTimeout(swapPanels, FADE_MS);
      } else {
        swapPanels();
      }

      if (focus) tab.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        let next: number | null = null;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") {
          next = (i + 1) % tabs.length;
        } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
          next = (i - 1 + tabs.length) % tabs.length;
        } else if (event.key === "Home") {
          next = 0;
        } else if (event.key === "End") {
          next = tabs.length - 1;
        }
        if (next !== null) {
          event.preventDefault();
          select(tabs[next], true);
        }
      });
    });
  });
</script>

<style define:vars={{ chipBorder4Url: `url(${chipBorder4Img.src})` }}>
  .nl-proof {
    background: var(--nl-bg);
    padding: 80px 0 0;
  }

  .nl-proof .nl-container {
    width: calc(100% - 160px);
    margin-inline: auto;
  }

  .nl-proof :global(.nl-proof-eyebrow) {
    margin-bottom: 24px;
    padding-left: 7px;
    background-image: var(--chipBorder4Url);
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }
  .nl-proof :global(.nl-proof-eyebrow .nl-eyebrow-chip),
  .nl-proof :global(.nl-proof-eyebrow .nl-eyebrow-pill) {
    border-color: transparent;
    background: transparent;
  }
  .nl-proof :global(.nl-proof-eyebrow .nl-eyebrow-chip) {
    width: 40px;
    height: 40px;
  }
  .nl-proof :global(.nl-proof-eyebrow .nl-eyebrow-chip svg) {
    width: 19px;
    height: 19px;
    transform: translateX(-2px);
  }
  .nl-proof :global(.nl-proof-eyebrow .nl-eyebrow-pill) {
    padding: 9px 32px 8px;
    font-family: "Geist", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #6f6f6f;
  }

  .nl-proof h2 {
    margin: 0 0 52px;
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 54px;
    line-height: 1.03;
    letter-spacing: -0.04em;
    color: #333333;
  }
  .nl-proof h2 :global(.nl-proof-hl) {
    border-radius: 8px;
    border: 1px solid #e6e6e6;
    padding-top: 0.01em;
    padding-bottom: 0.01em;
  }

  /* ── Tab bar: sits on the page background, above the black frame.
        The active tab is black and merges with the frame (browser-tab style). */
  .nl-proof-tablist {
    display: flex;
    position: relative;
    z-index: 1;
    margin-bottom: -12px; /* overlap the frame's 12px top rim */
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nl-proof-tablist::-webkit-scrollbar {
    display: none;
  }

  .nl-proof-tab {
    position: relative;
    flex: none;
    appearance: none;
    background: transparent;
    border: 0;
    margin: 0;
    padding: 0 26px 12px; /* bottom padding = frame-rim overlap */
    height: 53px; /* 41px visible above the frame + 12px overlap */
    display: inline-flex;
    align-items: center;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--nl-ink);
    white-space: nowrap;
    cursor: pointer;
    border-radius: 14px 14px 0 0;
  }
  .nl-proof-tab:focus-visible {
    outline: 2px solid var(--nl-orange);
    outline-offset: -3px;
  }
  .nl-proof-tab[aria-selected="true"] {
    background: var(--nl-ink);
    color: var(--nl-white);
  }

  /* Concave fillets where the active tab meets the frame top */
  .nl-proof-tab[aria-selected="true"]::before,
  .nl-proof-tab[aria-selected="true"]::after {
    content: "";
    position: absolute;
    bottom: 12px;
    width: 14px;
    height: 14px;
    pointer-events: none;
  }
  .nl-proof-tab[aria-selected="true"]::before {
    right: 100%;
    background: radial-gradient(circle at 0 0, transparent 13.5px, var(--nl-ink) 14px);
  }
  .nl-proof-tab[aria-selected="true"]::after {
    left: 100%;
    background: radial-gradient(circle at 100% 0, transparent 13.5px, var(--nl-ink) 14px);
  }
  /* First tab is flush with the frame's left edge: no left fillet */
  .nl-proof-tab:first-child[aria-selected="true"]::before {
    display: none;
  }

  /* ── Black frame around the case-study panel ── */
  .nl-proof-frame {
    background: var(--nl-ink);
    border-radius: 14px;
    padding: 12px;
  }
  /* When the first tab is active it merges with the frame's top-left corner,
     so that corner reads square (as in the design). */
  .nl-proof-tablist:has(.nl-proof-tab:first-child[aria-selected="true"]) + .nl-proof-frame {
    border-top-left-radius: 4px;
  }

  /* ── Panel ── */
  .nl-proof-panel {
    background: #f4f4f4;
    border-radius: 6px;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 500px) minmax(0, 1fr);
    min-height: 494px;
  }
  .nl-proof-panel[hidden] {
    display: none;
  }

  .nl-proof-copy {
    padding: 40px;
    display: flex;
    flex-direction: column;
    opacity: 1;
    transition: opacity 220ms ease;
  }
  .nl-proof-copy.is-fading {
    opacity: 0;
  }

  .nl-proof-h3 {
    margin: 0;
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    vertical-align: middle;
  }
  .nl-proof-h3-accent {
    color: var(--nl-orange);
  }

  .nl-proof-body {
    margin: 20px 0 0;
    font-family: "Archivo", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--nl-heading);
    max-width: 420px;
  }
  .nl-proof-body-dim {
    color: #8f8f8f;
  }

  /* ── Spec table pinned to the panel bottom ── */
  .nl-proof-table {
    margin: 48px 0 0;
    margin-top: auto;
    padding-top: 48px;
  }
  .nl-proof-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding: 12px 0;
    border-top: 1px solid var(--nl-line);
  }
  .nl-proof-row dt {
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--nl-ink);
  }
  .nl-proof-row dd {
    margin: 0;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.5);
    text-align: right;
    white-space: nowrap;
  }
  .nl-proof-row-arrow {
    display: inline-block;
    vertical-align: -1px;
    margin: 0 1px;
  }

  /* ── Right visual: two rounded-top bars rising from the panel bottom ── */
  .nl-proof-visual {
    position: relative;
    min-height: 300px;
    opacity: 1;
    transition: opacity 220ms ease;
  }
  .nl-proof-visual.is-fading {
    opacity: 0;
  }

  .nl-proof-bar-gray {
    position: absolute;
    bottom: 0;
    right: 47.5%;
    width: 26%;
    height: 456px;
    max-height: calc(100% - 38px);
    background-color: #e0e0e0;
    border-radius: 14px 14px 0 0;
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.65),
      inset 0 0 0 1px rgba(255, 255, 255, 0.35),
      inset 0 14px 24px rgba(255, 255, 255, 0.5),
      inset 0 -20px 32px rgba(0, 0, 0, 0.04),
      inset 0 5.73px 5.73px 0 rgba(0, 0, 0, 0.26),
      inset 0 0 20.62px 0 rgba(0, 0, 0, 0.22);
  }
  .nl-proof-bar-gray-label {
    position: absolute;
    top: 16px;
    right: 16px;
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 54px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #bfbfbf;
  }

  /* Prop-tech panel: bars stacked front-to-back (same slot) instead of
     side-by-side. Anchored with "left" (matching the Fortune tab's gray-bar
     start position: 100% - 47.5% right - 26% width = 26.5% from the left)
     since a fixed width no longer works with "right" anchoring. */
  #nl-proof-panel-proptech .nl-proof-bar-gray,
  #nl-proof-panel-proptech .nl-proof-bar-orange {
    left: 26.5%;
    right: auto;
    width: 462px;
  }

  .nl-proof-bar-orange {
    position: absolute;
    bottom: 0;
    right: 15%;
    width: 26%;
    height: 187px;
    border-radius: 14px 14px 0 0;
    /* white halftone dots over the orange fade */
    background-image:
      radial-gradient(rgba(255, 255, 255, 0.35) 1px, transparent 1px),
      linear-gradient(
        180deg,
        #ec5502 0%,
        #e86921 30%,
        #e99464 60%,
        #e8bea6 85%,
        #e2d0c5 100%
      );
    background-size:
      7px 7px,
      100% 100%;
    box-shadow:
      inset 0 5.73px 5.73px 0 rgba(0, 0, 0, 0.26),
      inset 0 0 20.62px 0 rgba(0, 0, 0, 0.22),
      0 6px 24px rgba(0, 0, 0, 0.08);
  }
  .nl-proof-bar-orange :global(.nl-proof-bar-arrow) {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 43px;
    height: 43px;
    color: var(--nl-ink);
  }
  .nl-proof-bar-stat {
    position: absolute;
    right: 16px;
    bottom: 4px;
    font-size: 54px;
    line-height: 1.05;
    color: var(--nl-ink);
  }
  /* Prop-tech panel: swap the stat/arrow corners (stat top-right, arrow bottom-right) */
  #nl-proof-panel-proptech .nl-proof-bar-orange :global(.nl-proof-bar-arrow) {
    top: auto;
    bottom: 16px;
    right: 16px;
  }
  #nl-proof-panel-proptech .nl-proof-bar-stat {
    top: 16px;
    bottom: auto;
    right: 16px;
  }

  /* ── Mobile: single column, scaled-down bars ── */
  @media (max-width: 1023px) {
    .nl-proof {
      padding: 64px 0 0;
    }
    .nl-proof h2 {
      margin-bottom: 28px;
    }
    .nl-proof-tab {
      padding: 0 18px 12px;
    }
    .nl-proof-frame {
      border-radius: 20px;
      padding: 8px;
    }
    .nl-proof-tablist {
      margin-bottom: -8px;
    }
    .nl-proof-tab {
      height: 49px;
      padding-bottom: 8px;
    }
    .nl-proof-tab[aria-selected="true"]::before,
    .nl-proof-tab[aria-selected="true"]::after {
      bottom: 8px;
    }
    .nl-proof-panel {
      grid-template-columns: 1fr;
      min-height: 0;
      border-radius: 16px;
    }
    .nl-proof-copy {
      padding: 28px;
    }
    .nl-proof-table {
      margin-top: 32px;
      padding-top: 0;
    }
    .nl-proof-visual {
      min-height: 0;
      height: 260px;
      margin-top: 8px;
    }
    .nl-proof-bar-gray {
      left: 24px;
      right: auto;
      width: 38%;
      max-width: 205px;
      height: 240px;
      max-height: none;
    }
    .nl-proof-bar-orange {
      right: 24px;
      width: 38%;
      max-width: 205px;
      height: 150px;
    }
    #nl-proof-panel-proptech .nl-proof-bar-orange {
      left: 24px;
      right: auto;
    }
    #nl-proof-panel-proptech .nl-proof-bar-gray,
    #nl-proof-panel-proptech .nl-proof-bar-orange {
      width: 38%;
      max-width: 205px;
    }
    .nl-proof-bar-stat {
      font-size: 40px;
    }
    .nl-proof-bar-orange :global(.nl-proof-bar-arrow) {
      top: 12px;
      right: 12px;
      width: 28px;
      height: 28px;
    }
  }

  /* ── Small screens (phones): tighter margins + smaller type throughout so
     the panel content (headline, tabs, table, bars) no longer overflows the
     narrow viewport, matching the mobile design ── */
  @media (max-width: 640px) {
    .nl-proof .nl-container {
      width: calc(100% - 40px);
    }
    .nl-proof h2 {
      font-size: 40px;
    }
    .nl-proof-tab {
      font-size: 10px;
      padding: 0 11px 8px;
    }
    .nl-proof-copy {
      padding: 20px;
    }
    .nl-proof-h3 {
      font-size: 28px;
    }
    .nl-proof-body {
      font-size: 14px;
      max-width: none;
    }
    .nl-proof-table {
      margin-top: 20px;
    }
    .nl-proof-row {
      gap: 12px;
      padding: 10px 0;
    }
    .nl-proof-row dt,
    .nl-proof-row dd {
      font-size: 10px;
    }
    .nl-proof-row dt {
      flex: none;
      white-space: nowrap;
    }
    .nl-proof-visual {
      height: 340px;
    }
    .nl-proof-bar-gray {
      height: 300px;
    }
    .nl-proof-bar-orange {
      height: 125px;
    }
    .nl-proof-bar-gray-label {
      font-size: 32px;
    }
    .nl-proof-bar-stat {
      font-size: 32px;
    }
  }
</style>
