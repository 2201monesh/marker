---
// Full-width lime CTA band between the proof and how-it-works sections.
// Refs: slices/slice_0.png, slices/slice_5.png (top), slices/z_banner_btn.png
import { getImage } from "astro:assets";
import CtaButton from "./CtaButton.astro";
import bookCallBtn1 from "../../assets/landing/book-call-btn-1.png";
import bookCallBtn2 from "../../assets/landing/book-call-btn-2.png";
import bannerBg from "../../assets/landing/banner-bg.png";

const bookCallBtn1Img = await getImage({ src: bookCallBtn1, format: "png" });
const bookCallBtn2Img = await getImage({ src: bookCallBtn2, format: "png" });
const bannerBgImg = await getImage({ src: bannerBg, format: "png" });
---
<section class="nl-banner-section" aria-label="Book a call">
  <div class="nl-container">
    <div class="nl-banner nl-dots-lime">
      <p class="nl-banner-text">
        Nobody hires us for just one agent. We stay embedded, <br /> and the list grows faster every time.
      </p>
      <CtaButton label="Book a call" href="https://info.onmarker.com/book-a-call" class="nl-banner-cta" />
    </div>
  </div>
</section>

<style define:vars={{
  bookCallBtn1Url: `url(${bookCallBtn1Img.src})`,
  bookCallBtn2Url: `url(${bookCallBtn2Img.src})`,
  bannerBgUrl: `url(${bannerBgImg.src})`,
}}>
  .nl-banner-section {
    background: var(--nl-bg);
    padding-top: 20px;
    padding-bottom: 28px;
  }

  .nl-banner-section .nl-container {
    width: calc(100% - 160px);
    margin-inline: auto;
  }

  .nl-banner {
    background-color: var(--nl-lime);
    background-image: var(--bannerBgUrl);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    border-radius: 14px;
    padding: 30px 40px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .nl-banner-text {
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 300;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    max-width: 640px;
    margin: 0;
  }

  .nl-banner :global(.nl-banner-cta .nl-btn-dark-label) {
    padding: 13px 14px;
    font-family: "Archivo", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    background-color: transparent;
    background-image: var(--bookCallBtn1Url);
    background-size: 100% 100%;
    clip-path: none;
  }
  .nl-banner :global(.nl-banner-cta .nl-btn-dark-chip) {
    height: auto;
    align-self: stretch;
    margin-left: 0px;
    background-color: transparent;
    background-image: var(--bookCallBtn2Url);
    background-size: 100% 100%;
    clip-path: none;
  }
  .nl-banner :global(.nl-banner-cta:hover .nl-btn-dark-label) {
    background-color: transparent;
    background-image: var(--bookCallBtn1Url);
  }
  .nl-banner :global(.nl-banner-cta:hover .nl-btn-dark-chip) {
    background-color: transparent;
    background-image: var(--bookCallBtn2Url);
  }
  .nl-banner :global(.nl-banner-cta .nl-btn-dark-chip svg) {
    transition: transform 150ms ease;
  }
  .nl-banner :global(.nl-banner-cta:hover .nl-btn-dark-chip svg) {
    transform: translateX(3px);
  }

  @media (max-width: 767px) {
    .nl-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 32px 24px;
      gap: 24px;
    }
    .nl-banner-text {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .nl-banner-section .nl-container {
      width: calc(100% - 40px);
    }
  }
</style>
