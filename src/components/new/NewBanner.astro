---
// Full-width lime CTA band between the proof and how-it-works sections.
// Refs: slices/slice_0.png, slices/slice_5.png (top), slices/z_banner_btn.png
import { getImage } from "astro:assets";
import CtaButton from "./CtaButton.astro";
import bannerBg from "../../assets/landing/banner-bg.png";

const bannerBgImg = await getImage({ src: bannerBg, format: "png" });
---
<section class="nl-banner-section" aria-label="Book a call">
  <div class="nl-container">
    <div class="nl-banner nl-dots-lime">
      <p class="nl-banner-text">
        Nobody hires us for just one agent. We stay embedded, <br /> and the list grows faster every time.
      </p>
      <CtaButton label="Book a call" href="https://info.onmarker.com/book-a-call" class="nl-banner-cta" />
    </div>
  </div>
</section>

<style define:vars={{ bannerBgUrl: `url(${bannerBgImg.src})` }}>
  .nl-banner-section {
    background: var(--nl-bg);
    padding-top: 20px;
    padding-bottom: 28px;
  }

  .nl-banner-section .nl-container {
    width: calc(100% - 160px);
    margin-inline: auto;
  }

  .nl-banner {
    background-color: var(--nl-lime);
    background-image: var(--bannerBgUrl);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    border-radius: 14px;
    padding: 30px 40px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .nl-banner-text {
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 300;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    max-width: 640px;
    margin: 0;
  }

  /* Book a call — identical treatment to the hero CTA: the label block and the
     detached arrow chip are the two vectors from Figma node 1249:1048 at their
     true size (121.436×40 and 41.418×40, both #2B2B2B), drawn as 9-slices so the
     corners and the slanted edge are never scaled and only the flat middle
     stretches with the text. Keeps the 6px corners and the notch angle
     (dx/dy 0.234, parallel between the halves) exact at any width. */
  .nl-banner :global(.nl-banner-cta .nl-btn-dark-label) {
    border-style: solid;
    border-color: transparent;
    border-width: 8px 14px 8px 8px;
    border-image: url("../../assets/landing/book-call-btn-label.svg") 8 14 8 8 fill stretch;
    border-radius: 0;
    /* border + padding = the design's insets: 14px left, 16.44px right, 13px top/bottom */
    padding: 5px 2.436px 5px 6px;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    background: none;
    clip-path: none;
  }
  .nl-banner :global(.nl-banner-cta .nl-btn-dark-chip) {
    position: relative;
    box-sizing: border-box;
    width: 41.418px;
    height: auto;
    align-self: stretch;
    margin-left: 0px;
    border-style: solid;
    border-color: transparent;
    border-width: 8px 8px 8px 14px;
    border-image: url("../../assets/landing/book-call-btn-chip.svg") 8 8 8 14 fill stretch;
    border-radius: 0;
    background: none;
    clip-path: none;
  }
  /* The design's own lucide/arrow-right export, at its design offset inside the
     chip. CtaButton's inline SVG is hidden rather than restyled so the other
     CTAs keep theirs. */
  .nl-banner :global(.nl-banner-cta .nl-btn-dark-chip svg) {
    display: none;
  }
  .nl-banner :global(.nl-banner-cta .nl-btn-dark-chip)::after {
    content: "";
    position: absolute;
    /* 13.815px from the chip's border edge; the containing block is the padding
       box, which starts after the 14px left border slice */
    left: -0.185px;
    top: calc(50% + 0.14px);
    width: 16px;
    height: 16px;
    transform: translateY(-50%);
    background: url("../../assets/landing/book-call-btn-arrow.svg") 0 0 / 16px 16px no-repeat;
    transition: transform 150ms ease;
  }
  .nl-banner :global(.nl-banner-cta:hover .nl-btn-dark-chip)::after {
    transform: translateY(-50%) translateX(3px);
  }
  /* Neutralise the shared .nl-btn-dark hover fill; only the arrow moves. */
  .nl-banner :global(.nl-banner-cta:hover .nl-btn-dark-label),
  .nl-banner :global(.nl-banner-cta:hover .nl-btn-dark-chip) {
    background: none;
  }

  @media (max-width: 767px) {
    .nl-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 32px 24px;
      gap: 24px;
    }
    .nl-banner-text {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .nl-banner-section .nl-container {
      width: calc(100% - 40px);
    }
  }
</style>
