---
// Site footer — continuation of the lime band. Inner #F7F7F7 panel with a
// 4-column link grid on top and a logo lockup + legal links row below.
// Refs: slices/slice_9.png, slices/z_footer_bottom.png, slices/z_logo_big.png
import DotArrow from "./DotArrow.astro";
import MarkerMark from "./MarkerMark.astro";

const columns = [
  { label: "About us", href: "/team", highlighted: true },
  { label: "Features", href: "/", highlighted: false },
  { label: "Articles", href: "/", highlighted: false },
  { label: "Contact", href: "mailto:founders@onmarker.com", highlighted: false },
];

const legalLinks = [
  { label: "Book a call", href: "https://info.onmarker.com/book-a-demo" },
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Cookie Policy", href: "/cookies" },
  { label: "Terms of Service", href: "/terms" },
  { label: "Trust Center", href: "https://trust.onmarker.com/" },
];
---

<footer class="nl-footer nl-dots-lime" aria-label="Footer">
  <div class="nl-container">
    <div class="nl-footer-panel">
      <nav class="nl-footer-cols" aria-label="Explore">
        {
          columns.map(({ label, href, highlighted }) => (
            <a
              href={href}
              class:list={["nl-footer-cell", highlighted && "nl-footer-cell--hl"]}
            >
              {highlighted && (
                <span class="nl-footer-cell-arrow" aria-hidden="true">
                  <DotArrow dir="ne" size={22} />
                </span>
              )}
              <span class="nl-footer-cell-label">{label}</span>
            </a>
          ))
        }
      </nav>

      <div class="nl-footer-bottom">
        <a href="/" class="nl-footer-brand" aria-label="Marker home">
          <span class="nl-footer-brandmark" aria-hidden="true">
            <MarkerMark />
          </span>
          <span class="nl-footer-wordmark" aria-hidden="true">Marker</span>
        </a>
        <nav class="nl-footer-legal" aria-label="Legal and contact">
          {legalLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
          <a
            href="#"
            onclick="if(window.displayPreferenceModal){window.displayPreferenceModal();return false;}"
          >Manage Cookies</a>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .nl-footer {
    background: var(--nl-lime);
    padding: 0 0 40px;
  }

  .nl-footer-panel {
    background: #f7f7f7;
    border-radius: 24px;
    overflow: hidden;
  }

  /* ── Top row: four equal link cells ─────────────────────────────────── */
  .nl-footer-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .nl-footer-cell {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 440px;
    padding: 26px;
    text-decoration: none;
    transition: background-color 140ms ease;
  }
  .nl-footer-cell + .nl-footer-cell {
    border-left: 1px solid var(--nl-line);
  }
  .nl-footer-cell:hover {
    background-color: #fcfcfc;
  }
  .nl-footer-cell:focus-visible {
    outline: 2px solid var(--nl-orange);
    outline-offset: -3px;
    border-radius: 4px;
  }

  .nl-footer-cell-label {
    font-size: 17px;
    line-height: 1.3;
    color: var(--nl-body);
  }

  /* Highlighted "About us" cell: white sheen + dot arrow + darker label */
  .nl-footer-cell--hl {
    background: linear-gradient(
      135deg,
      #ffffff 0%,
      rgba(255, 255, 255, 0.55) 55%,
      rgba(255, 255, 255, 0) 100%
    );
    box-shadow: 6px 0 18px rgba(0, 0, 0, 0.03);
  }
  .nl-footer-cell--hl:hover {
    background-color: transparent;
    background-image: linear-gradient(
      135deg,
      #ffffff 0%,
      rgba(255, 255, 255, 0.75) 60%,
      rgba(255, 255, 255, 0.2) 100%
    );
  }
  .nl-footer-cell--hl .nl-footer-cell-label {
    color: var(--nl-ink);
  }
  .nl-footer-cell-arrow {
    position: absolute;
    top: 24px;
    right: 24px;
    color: #1a1a1a;
    line-height: 0;
  }

  /* ── Bottom row: logo lockup + legal link grid ──────────────────────── */
  .nl-footer-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--nl-line);
  }

  .nl-footer-brand {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 28px 40px;
    color: #0a0a0a;
    text-decoration: none;
  }
  .nl-footer-brand:focus-visible {
    outline: 2px solid var(--nl-orange);
    outline-offset: -3px;
    border-radius: 4px;
  }
  .nl-footer-brandmark {
    color: #0a0a0a;
    line-height: 0;
    flex: none;
  }
  .nl-footer-brandmark :global(svg) {
    display: block;
    height: clamp(40px, 5vw, 72px);
    width: auto;
  }
  .nl-footer-wordmark {
    font-family: "Inter Tight", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2.75rem, 6.1vw, 5.5rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: #0a0a0a;
  }

  .nl-footer-legal {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    row-gap: 24px;
    column-gap: 16px;
    align-content: center;
    padding: 32px 40px;
    border-left: 1px solid var(--nl-line);
  }
  .nl-footer-legal a {
    font-size: 15px;
    line-height: 1.3;
    color: #8a8a8a;
    text-decoration: none;
    justify-self: start;
    transition: color 120ms ease;
  }
  .nl-footer-legal a:hover {
    color: #333333;
  }
  .nl-footer-legal a:focus-visible {
    outline: 2px solid var(--nl-orange);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* ── Mobile stacking ────────────────────────────────────────────────── */
  @media (max-width: 960px) {
    .nl-footer-cols {
      grid-template-columns: 1fr 1fr;
    }
    .nl-footer-cell {
      min-height: 220px;
      padding: 20px;
    }
    .nl-footer-cell:nth-child(odd) {
      border-left: 0;
    }
    .nl-footer-cell:nth-child(n + 3) {
      border-top: 1px solid var(--nl-line);
    }
    .nl-footer-bottom {
      grid-template-columns: 1fr;
    }
    .nl-footer-brand {
      padding: 28px 24px;
    }
    .nl-footer-legal {
      border-left: 0;
      border-top: 1px solid var(--nl-line);
      grid-template-columns: repeat(2, 1fr);
      padding: 28px 24px;
      row-gap: 20px;
    }
  }
</style>
