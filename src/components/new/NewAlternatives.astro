---
// "The alternatives" section — three chart cards (do nothing / hire / consultancy)
// with dotted-chevron connectors and the closing "We sold our last…" paragraph.
// Refs: slice_1.png (bottom), slice_2.png, slice_3.png (top), z_consult_chart.png
import { Image, getImage } from "astro:assets";
import Eyebrow from "./Eyebrow.astro";
import card1Src from "../../assets/landing/card-1.png";
import card2Src from "../../assets/landing/card-2.png";
import card3Src from "../../assets/landing/card-3.png";
import card1MobileSrc from "../../assets/landing/card-mobile-1.png";
import card2MobileSrc from "../../assets/landing/card-mobile-2.png";
import card3MobileSrc from "../../assets/landing/card-mobile-3.png";
import bottomArrowIcon from "../../assets/landing/bottom-arrow-icon.png";
import chipBorder2 from "../../assets/landing/chip-border-2.png";

const card1Img = await getImage({ src: card1Src, format: "png" });
const card2Img = await getImage({ src: card2Src, format: "png" });
const card3Img = await getImage({ src: card3Src, format: "png" });
const card1MobileImg = await getImage({ src: card1MobileSrc, format: "png" });
const card2MobileImg = await getImage({ src: card2MobileSrc, format: "png" });
const card3MobileImg = await getImage({ src: card3MobileSrc, format: "png" });
const chipBorder2Img = await getImage({ src: chipBorder2, format: "png" });

// ── Card 1 bar strip: ~55 thin bars, first 20 short & orange, the rest gray
//    growing exponentially from 6px to ~200px.
const BAR_COUNT = 55;
const ORANGE_COUNT = 20;
const BAR_W = 3;
const C1_W = 682;
const C1_H = 215;
const MIN_H = 10;
const MAX_H = 200;
const step = (C1_W - BAR_W) / (BAR_COUNT - 1);
const bars = Array.from({ length: BAR_COUNT }, (_, i) => {
  const x = +(i * step).toFixed(1);
  if (i < ORANGE_COUNT) return { x, h: MIN_H, orange: true };
  const t = (i - ORANGE_COUNT) / (BAR_COUNT - 1 - ORANGE_COUNT);
  const h = +(MIN_H * Math.pow(MAX_H / MIN_H, t)).toFixed(1);
  return { x, h, orange: false };
});

// ── Card 2 scatter: 14 gray dots in Q1, 4 in Q2, one orange "HIRED" dot in Q3.
const q1Dots = [
  [16, 24], [46, 30], [120, 34], [152, 44], [28, 60], [66, 86], [140, 82],
  [172, 54], [42, 88], [78, 112], [112, 94], [30, 128], [92, 132], [148, 120],
];
const q2Dots = [
  [252, 50], [420, 46], [364, 96], [232, 112],
];

// Closing line: the dimmed run is split into words so each can be
// progressively re-colored (staggered) as the reader scrolls past it.
const closingDimWords = "company to Gap and founded their Office of AI. That expertise embeds with you on day one, and the first agents are live in weeks.".split(" ");
---
<section class="nl-alt" aria-labelledby="nl-alt-heading">
  <div class="nl-container nl-alt-grid">
    <div class="nl-alt-head">
      <Eyebrow label="THE ALTERNATIVES" class="nl-alt-eyebrow" />
      <h2 id="nl-alt-heading" class="nl-display nl-h2 nl-alt-title">
        The usual paths<br /><span class="nl-hl nl-alt-hl">don't ship</span>
      </h2>
    </div>

    <div class="nl-alt-content">
      <!-- Card 1 — Do nothing -->
      <article class="nl-alt-card nl-alt-card--nothing">
        <p class="nl-alt-lead"><strong>Do nothing.</strong> <span class="nl-dim">The gap compounds. Against you.</span></p>
        <svg
          class="nl-alt-chart nl-alt-chart--bars"
          viewBox={`0 0 ${C1_W} ${C1_H}`}
          role="img"
          aria-label="Bar chart: a short, flat orange strip of effort while the cost of waiting grows exponentially"
        >
          {bars.map((b) => (
            <rect
              class="nl-alt-bar"
              x={b.x}
              y={+(C1_H - b.h).toFixed(1)}
              width={BAR_W}
              height={b.h}
              rx="1.5"
              fill={b.orange ? "var(--nl-orange)" : "#D9D9D9"}
              style={`--ox:${+(b.x + BAR_W / 2).toFixed(1)}px;--oy:${C1_H}px;`}
            />
          ))}
        </svg>
      </article>

      <!-- Card 2 — Hire for it -->
      <article class="nl-alt-card nl-alt-card--hire">
        <span class="nl-alt-connector" aria-hidden="true">
          <Image src={bottomArrowIcon} alt="" class="nl-alt-connector-icon" width={100} height={56} />
        </span>
        <p class="nl-alt-lead"><strong>Hire for it.</strong> <span class="nl-dim">The people who have actually done this are rare. Recruiting them takes quarters.</span></p>
        <svg
          class="nl-alt-chart nl-alt-chart--scatter"
          viewBox="0 0 682 210"
          role="img"
          aria-label="Scatter chart: many candidates across Q1 and Q2; a single hire finally lands in Q3"
        >
          <line class="nl-alt-hire-chrome" x1="205" y1="4" x2="205" y2="206" stroke="#DDDDDD" stroke-width="1" stroke-dasharray="3 5" />
          <line class="nl-alt-hire-chrome" x1="478" y1="4" x2="478" y2="206" stroke="#DDDDDD" stroke-width="1" stroke-dasharray="3 5" />
          {q1Dots.map(([cx, cy]) => (
            <circle class="nl-alt-hdot" data-q="0" cx={cx} cy={cy} r="3.5" fill="#C9C9C9" style={`--ox:${cx}px;--oy:${cy}px;`} />
          ))}
          {q2Dots.map(([cx, cy]) => (
            <circle class="nl-alt-hdot" data-q="1" cx={cx} cy={cy} r="3.5" fill="#C9C9C9" style={`--ox:${cx}px;--oy:${cy}px;`} />
          ))}
          <circle class="nl-alt-hdot" data-q="2" cx="590" cy="84" r="8" fill="var(--nl-orange-deep)" style="--ox:590px;--oy:84px;" />
          <text class="nl-alt-svg-label nl-alt-hire-chrome" x="590" y="112" text-anchor="middle">HIRED</text>
          <text class="nl-alt-svg-label nl-alt-hire-chrome" x="102" y="198" text-anchor="middle">Q1</text>
          <text class="nl-alt-svg-label nl-alt-hire-chrome" x="341" y="160" text-anchor="middle">Q2</text>
          <text class="nl-alt-svg-label nl-alt-hire-chrome" x="590" y="198" text-anchor="middle">Q3</text>
        </svg>
      </article>

      <!-- Card 3 — Call in a consultancy -->
      <article class="nl-alt-card nl-alt-card--consult">
        <span class="nl-alt-connector" aria-hidden="true">
          <Image src={bottomArrowIcon} alt="" class="nl-alt-connector-icon" width={100} height={56} />
        </span>
        <p class="nl-alt-lead"><strong>Call in a consultancy.</strong> <span class="nl-dim">The good ones ship </br> real systems now. In quarters. </br> And they leave.</span></p>
        <svg
          class="nl-alt-chart nl-alt-chart--steps"
          viewBox="0 0 682 235"
          role="img"
          aria-label="Line chart: an engagement climbs in steps, then flattens the day they leave while the gap keeps compounding"
        >
          <!-- faint dashed vertical gridlines -->
          <line class="nl-alt-consult-tick" x1="136" y1="96" x2="136" y2="222" stroke="#E6E6E6" stroke-width="1" stroke-dasharray="3 5" />
          <line class="nl-alt-consult-tick" x1="272" y1="96" x2="272" y2="222" stroke="#E6E6E6" stroke-width="1" stroke-dasharray="3 5" />
          <line class="nl-alt-consult-tick" x1="544" y1="96" x2="544" y2="222" stroke="#E6E6E6" stroke-width="1" stroke-dasharray="3 5" />
          <line class="nl-alt-consult-tick" x1="640" y1="96" x2="640" y2="222" stroke="#E6E6E6" stroke-width="1" stroke-dasharray="3 5" />
          <!-- the gap keeps compounding: dashed rising curve, revealed by a sliding wipe -->
          <defs>
            <clipPath id="nl-alt-pace-clip">
              <rect id="nl-alt-pace-wipe" x="-10" y="0" width="0" height="240" />
            </clipPath>
          </defs>
          <g clip-path="url(#nl-alt-pace-clip)">
            <path d="M 24 206 C 300 200, 520 168, 682 74" fill="none" stroke="#D0D0D0" stroke-width="1.5" stroke-dasharray="5 5" />
          </g>
          <!-- stepped engagement line; flat after the leave point; drawn on via stroke-dashoffset (path length = 708) -->
          <path id="nl-alt-consult-step" d="M 24 196 H 96 V 178 H 205 V 164 H 315 V 152 H 400 V 146 H 682" fill="none" stroke="#C4C4C4" stroke-width="1.5" stroke-dasharray="708 708" stroke-dashoffset="708" />
          <!-- they-leave vertical marker -->
          <line id="nl-alt-consult-leave" x1="423" y1="118" x2="423" y2="220" stroke="#C4C4C4" stroke-width="1.5" />
          <circle class="nl-alt-consult-dot" data-d="1" cx="423" cy="146" r="4.5" fill="var(--nl-orange-deep)" style="--ox:423px;--oy:146px;" />
          <g class="nl-alt-consult-leave-label">
            <circle cx="435" cy="104" r="6" fill="none" stroke="var(--nl-orange)" stroke-width="1.3" />
            <line x1="435" y1="100.6" x2="435" y2="105.4" stroke="var(--nl-orange)" stroke-width="1.4" stroke-linecap="round" />
            <circle cx="435" cy="107.7" r="0.9" fill="var(--nl-orange)" />
            <text class="nl-alt-svg-label" x="447" y="108" text-anchor="start">THEY LEAVE</text>
          </g>
          <!-- engaged start -->
          <circle class="nl-alt-consult-dot" data-d="0" cx="24" cy="196" r="4.5" fill="var(--nl-orange-deep)" style="--ox:24px;--oy:196px;" />
          <text id="nl-alt-consult-engaged" class="nl-alt-svg-label" x="17" y="226" text-anchor="start">ENGAGED</text>
        </svg>
      </article>

      <noscript>
        <style>
          .nl-alt-bar,
          .nl-alt-hdot,
          .nl-alt-hire-chrome,
          .nl-alt-consult-tick,
          .nl-alt-consult-dot,
          #nl-alt-consult-engaged,
          .nl-alt-consult-leave-label,
          #nl-alt-consult-leave { opacity: 1 !important; transform: none !important; }
          #nl-alt-consult-step { stroke-dashoffset: 0 !important; }
          #nl-alt-pace-wipe { width: 702px !important; }
        </style>
      </noscript>

      <!-- Closing paragraph -->
      <p class="nl-alt-closing" data-scroll-reveal><span>We sold our last</span> <span class="nl-alt-closing-dim">{closingDimWords.map((word) => (
        <span class="nl-alt-closing-word">{word} </span>
      ))}</span></p>
    </div>
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>("[data-scroll-reveal]");
  if (el) {
    const words = Array.from(el.querySelectorAll<HTMLElement>(".nl-alt-closing-word"));

    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = el.getBoundingClientRect();
      const rangeStart = window.innerHeight * 0.9;
      const rangeEnd = window.innerHeight * 0.4;
      const progress = Math.min(
        1,
        Math.max(0, (rangeStart - rect.top) / (rangeStart - rangeEnd)),
      );
      const revealCount = Math.round(progress * words.length);
      words.forEach((word, i) => {
        word.classList.toggle("is-revealed", i < revealCount);
      });
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }
</script>

<script>
  // "Do nothing" card (card 1): bars rise from the baseline, left to right,
  // with a slight overshoot — ported from marker-dn-animation.html's runDN().
  const dnCard = document.querySelector<HTMLElement>(".nl-alt-card--nothing");
  if (dnCard && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const bars = Array.from(dnCard.querySelectorAll<SVGRectElement>(".nl-alt-bar"));
    const RISE = 770; // ms
    const STAGGER = 26; // ms per bar
    const OVERSHOOT = 1.08; // scaleY peak before settling
    const FADE_AT = 0.55; // offset at which the bar has fully faded in

    let played = false;
    function playBars() {
      if (played) return;
      played = true;
      bars.forEach((bar, i) => {
        bar.animate(
          [
            { transform: "scaleY(0)", opacity: 0 },
            { opacity: 1, offset: FADE_AT },
            { transform: `scaleY(${OVERSHOOT})`, offset: 0.78 },
            { transform: "scaleY(1)", opacity: 1 },
          ],
          { duration: RISE, delay: i * STAGGER, fill: "both", easing: "cubic-bezier(.22,1,.32,1)" }
        );
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          playBars();
          observer.disconnect();
        }
      },
      { threshold: 0.25 }
    );
    observer.observe(dnCard);
  }
</script>

<script>
  // "Hire for it" card (card 2): dividers/labels fade in, then candidate dots
  // pop in per quarter (shuffled order), then the "HIRED" dot lands in Q3 —
  // ported from marker-hire-animation.html's runHire().
  const hireCard = document.querySelector<HTMLElement>(".nl-alt-card--hire");
  if (hireCard && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const chrome = Array.from(hireCard.querySelectorAll<SVGElement>(".nl-alt-hire-chrome"));
    const dots = Array.from(hireCard.querySelectorAll<SVGElement>(".nl-alt-hdot"));
    const POP = 520; // ms
    const STAGGER = 45; // ms per dot within a quarter
    const Q_GAP = 420; // ms pause between quarters
    const OVERSHOOT = 1.22; // scale peak before settling

    function shuffle(arr: SVGElement[]) {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    let played = false;
    function playHire() {
      if (played) return;
      played = true;

      chrome.forEach((el, i) => {
        el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 420, delay: i * 30, fill: "both" });
      });

      let t = 0;
      [0, 1, 2].forEach((q) => {
        const group = shuffle(dots.filter((d) => d.dataset.q === String(q)));
        let last = 0;
        group.forEach((dot, i) => {
          const delay = t + i * STAGGER;
          last = Math.max(last, delay + POP);
          dot.animate(
            [
              { opacity: 0, transform: "scale(0)" },
              { opacity: 1, transform: `scale(${OVERSHOOT})`, offset: 0.62 },
              { opacity: 1, transform: "scale(1)" },
            ],
            { duration: POP, delay, fill: "both", easing: "cubic-bezier(.22,1,.32,1)" }
          );
        });
        t = last + Q_GAP;
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          playHire();
          observer.disconnect();
        }
      },
      { threshold: 0.25 }
    );
    observer.observe(hireCard);
  }
</script>

<script>
  // "Call in a consultancy" card (card 3): the stepped engagement line and the
  // dashed "gap compounds" curve draw on together, gridlines fade in, the
  // engaged dot lands, then at the leave point a vertical marker rises, the
  // leave dot lands, and the "THEY LEAVE" label follows — ported from
  // marker-consult-animation.html's runCons().
  const consultCard = document.querySelector<HTMLElement>(".nl-alt-card--consult");
  if (consultCard && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const stepPath = consultCard.querySelector<SVGPathElement>("#nl-alt-consult-step");
    const paceWipe = consultCard.querySelector<SVGRectElement>("#nl-alt-pace-wipe");
    const ticks = Array.from(consultCard.querySelectorAll<SVGElement>(".nl-alt-consult-tick"));
    const engagedDot = consultCard.querySelector<SVGElement>('.nl-alt-consult-dot[data-d="0"]');
    const engagedText = consultCard.querySelector<SVGElement>("#nl-alt-consult-engaged");
    const leaveLine = consultCard.querySelector<SVGElement>("#nl-alt-consult-leave");
    const leaveDot = consultCard.querySelector<SVGElement>('.nl-alt-consult-dot[data-d="1"]');
    const leaveLabel = consultCard.querySelector<SVGElement>(".nl-alt-consult-leave-label");

    const DRAW = 2600; // ms — step line + pace curve draw-on
    const LEAVE_AT = 0.6; // fraction of DRAW at which the leave marker rises
    const V_GROW = 520; // ms — leave marker rise duration
    const LABEL_LEAD = 140; // ms after the leave dot before the label follows
    const STEP_LEN = 708; // pre-computed total length of the stepped path

    let played = false;
    function playConsult() {
      if (played) return;
      played = true;

      stepPath?.animate([{ strokeDashoffset: STEP_LEN }, { strokeDashoffset: 0 }], {
        duration: DRAW,
        fill: "both",
        easing: "cubic-bezier(.35,.02,.28,1)",
      });
      paceWipe?.animate([{ width: "0px" }, { width: "702px" }], {
        duration: DRAW,
        fill: "both",
        easing: "cubic-bezier(.35,.02,.28,1)",
      });
      ticks.forEach((tick, i) => {
        tick.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 400, delay: 120 + i * 70, fill: "both" });
      });
      engagedDot?.animate(
        [
          { opacity: 0, transform: "scale(0)" },
          { opacity: 1, transform: "scale(1.25)", offset: 0.62 },
          { opacity: 1, transform: "scale(1)" },
        ],
        { duration: 420, delay: 80, fill: "both", easing: "cubic-bezier(.22,1,.32,1)" }
      );
      engagedText?.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 380, delay: 180, fill: "both" });

      const leaveAt = DRAW * LEAVE_AT;
      leaveLine?.animate(
        [
          { opacity: 0, transform: "scaleY(0)" },
          { opacity: 1, transform: "scaleY(1)" },
        ],
        { duration: V_GROW, delay: leaveAt, fill: "both", easing: "cubic-bezier(.2,.8,.26,1)" }
      );
      leaveDot?.animate(
        [
          { opacity: 0, transform: "scale(0)" },
          { opacity: 1, transform: "scale(1.25)", offset: 0.62 },
          { opacity: 1, transform: "scale(1)" },
        ],
        { duration: 420, delay: leaveAt + V_GROW * 0.55, fill: "both", easing: "cubic-bezier(.22,1,.32,1)" }
      );
      leaveLabel?.animate(
        [
          { opacity: 0, transform: "translateY(4px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 420, delay: leaveAt + V_GROW * 0.55 + LABEL_LEAD, fill: "both", easing: "cubic-bezier(.22,1,.32,1)" }
      );
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          playConsult();
          observer.disconnect();
        }
      },
      { threshold: 0.25 }
    );
    observer.observe(consultCard);
  }
</script>

<style define:vars={{
  altCard1Url: `url(${card1Img.src})`,
  altCard2Url: `url(${card2Img.src})`,
  altCard3Url: `url(${card3Img.src})`,
  altCard1MobileUrl: `url(${card1MobileImg.src})`,
  altCard2MobileUrl: `url(${card2MobileImg.src})`,
  altCard3MobileUrl: `url(${card3MobileImg.src})`,
  chipBorder2Url: `url(${chipBorder2Img.src})`,
}}>
  .nl-alt {
    background: var(--nl-bg);
    padding-top: 80px;
    padding-bottom: 96px;
  }

  .nl-alt-grid {
    width: calc(100% - 160px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 738px);
    column-gap: 40px;
    align-items: start;
  }

  .nl-alt-head {
    align-self: start;
    position: sticky;
    top: 96px;
  }

  .nl-alt-head :global(.nl-alt-eyebrow) {
    padding-left: 7px;
    background-image: var(--chipBorder2Url);
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }
  .nl-alt-head :global(.nl-alt-eyebrow .nl-eyebrow-chip),
  .nl-alt-head :global(.nl-alt-eyebrow .nl-eyebrow-pill) {
    border-color: transparent;
    background: transparent;
  }
  .nl-alt-head :global(.nl-alt-eyebrow .nl-eyebrow-chip) {
    width: 40px;
    height: 40px;
  }
  .nl-alt-head :global(.nl-alt-eyebrow .nl-eyebrow-chip svg) {
    width: 19px;
    height: 19px;
    
  }
  .nl-alt-head :global(.nl-alt-eyebrow .nl-eyebrow-pill) {
    padding: 9px 32px 8px;
    font-family: "Geist", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #6f6f6f;
  }

  .nl-alt-title {
    margin-top: 14px;
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 54px;
    letter-spacing: -0.04em;
    color: #333333;
  }
  .nl-alt-title :global(.nl-alt-hl) {
    border-radius: 8px;
    border: 1px solid #e6e6e6;
    padding-top: 0;
    padding-bottom: 0;
  }

  /* Content column starts just after the heading text ends (no overlap) */
  .nl-alt-content { margin-top: 184px; }

  .nl-alt-card {
    position: relative;
    box-sizing: border-box;
    height: 324px;
    padding: 28px;
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }
  .nl-alt-card--nothing {
    padding: 44px 32px 48px;
    background-image: var(--altCard1Url);
  }
  .nl-alt-card--hire {
    padding-top: 44px;
    padding-left: 32px;
    padding-right: 32px;
    background-image: var(--altCard2Url);
  }
  .nl-alt-card--consult {
    padding-top: 44px;
    background-image: var(--altCard3Url);
  }
  .nl-alt-card + .nl-alt-card { margin-top: 28px; }

  /* White connector circle bridging the 28px gap (overlaps both cards by 18px) */
  .nl-alt-connector {
    position: absolute;
    top: -46px;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    z-index: 2;
  }
  .nl-alt-connector :global(.nl-alt-connector-icon) {
    width: 50px;
    height: 28px;
  }

  .nl-alt-lead {
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--nl-ink);
    position: relative;
    z-index: 1;
  }
  .nl-alt-lead strong { font-weight: 500; color: var(--nl-ink); }
  .nl-alt-card--nothing .nl-alt-lead { max-width: 250px; }
  .nl-alt-card--hire .nl-alt-lead { max-width: 240px; }
  .nl-alt-card--consult .nl-alt-lead { max-width: 330px; }

  .nl-alt-chart {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Tall right-side bars rise alongside the lead, as in the design */
