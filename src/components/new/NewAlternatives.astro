---
// "The alternatives" section — three chart cards (do nothing / hire / consultancy)
// with dotted-chevron connectors and the closing "We sold our last…" paragraph.
// Refs: slice_1.png (bottom), slice_2.png, slice_3.png (top), z_consult_chart.png
import Eyebrow from "./Eyebrow.astro";

// ── Card 1 bar strip: ~55 thin bars, first 20 short & orange, the rest gray
//    growing exponentially from 6px to ~200px.
const BAR_COUNT = 55;
const ORANGE_COUNT = 20;
const BAR_W = 3;
const C1_W = 682;
const C1_H = 215;
const MIN_H = 6;
const MAX_H = 200;
const step = (C1_W - BAR_W) / (BAR_COUNT - 1);
const bars = Array.from({ length: BAR_COUNT }, (_, i) => {
  const x = +(i * step).toFixed(1);
  if (i < ORANGE_COUNT) return { x, h: 14, orange: true };
  const t = (i - ORANGE_COUNT) / (BAR_COUNT - 1 - ORANGE_COUNT);
  const h = +(MIN_H * Math.pow(MAX_H / MIN_H, t)).toFixed(1);
  return { x, h, orange: false };
});

// ── Card 2 scatter: 14 gray dots in Q1, 4 in Q2, one orange "HIRED" dot in Q3.
const q1Dots = [
  [16, 24], [46, 30], [120, 34], [152, 44], [28, 60], [66, 86], [140, 82],
  [172, 54], [42, 88], [78, 112], [112, 94], [30, 128], [92, 132], [148, 120],
];
const q2Dots = [
  [252, 50], [420, 46], [364, 96], [232, 112],
];
---
<section class="nl-alt" aria-labelledby="nl-alt-heading">
  <div class="nl-container nl-alt-grid">
    <div class="nl-alt-head">
      <Eyebrow label="THE ALTERNATIVES" />
      <h2 id="nl-alt-heading" class="nl-display nl-h2 nl-alt-title">
        The usual paths<br /><span class="nl-hl">don't realize</span>
      </h2>
    </div>

    <div class="nl-alt-content">
      <!-- Card 1 — Do nothing -->
      <article class="nl-card nl-alt-card nl-alt-card--nothing">
        <p class="nl-alt-lead"><strong>Do nothing.</strong> <span class="nl-dim">The gap compounds. Against you.</span></p>
        <svg
          class="nl-alt-chart nl-alt-chart--bars"
          viewBox={`0 0 ${C1_W} ${C1_H}`}
          role="img"
          aria-label="Bar chart: a short, flat orange strip of effort while the cost of waiting grows exponentially"
        >
          {bars.map((b) => (
            <rect
              x={b.x}
              y={+(C1_H - b.h).toFixed(1)}
              width={BAR_W}
              height={b.h}
              rx="1.5"
              fill={b.orange ? "var(--nl-orange)" : "#D9D9D9"}
            />
          ))}
        </svg>
      </article>

      <!-- Card 2 — Hire for it -->
      <article class="nl-card nl-alt-card nl-alt-card--hire">
        <span class="nl-alt-connector" aria-hidden="true">
          <svg viewBox="0 0 24 18" width="24" height="18" fill="#9A9A9A">
            <circle cx="3" cy="4" r="1.5" />
            <circle cx="6.7" cy="7.3" r="1.5" />
            <circle cx="9.4" cy="10.6" r="1.5" />
            <circle cx="12" cy="13.9" r="1.5" />
            <circle cx="14.6" cy="10.6" r="1.5" />
            <circle cx="17.3" cy="7.3" r="1.5" />
            <circle cx="21" cy="4" r="1.5" />
          </svg>
        </span>
        <p class="nl-alt-lead"><strong>Hire for it.</strong> <span class="nl-dim">The people who have actually done this are rare. Recruiting them takes quarters.</span></p>
        <svg
          class="nl-alt-chart nl-alt-chart--scatter"
          viewBox="0 0 682 210"
          role="img"
          aria-label="Scatter chart: many candidates across Q1 and Q2; a single hire finally lands in Q3"
        >
          <line x1="205" y1="4" x2="205" y2="206" stroke="#DDDDDD" stroke-width="1" stroke-dasharray="3 5" />
          <line x1="478" y1="4" x2="478" y2="206" stroke="#DDDDDD" stroke-width="1" stroke-dasharray="3 5" />
          {q1Dots.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.5" fill="#C9C9C9" />)}
          {q2Dots.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.5" fill="#C9C9C9" />)}
          <circle cx="590" cy="84" r="8" fill="var(--nl-orange-deep)" />
          <text class="nl-alt-svg-label" x="590" y="112" text-anchor="middle">HIRED</text>
          <text class="nl-alt-svg-label" x="102" y="198" text-anchor="middle">Q1</text>
          <text class="nl-alt-svg-label" x="341" y="198" text-anchor="middle">Q2</text>
          <text class="nl-alt-svg-label" x="590" y="198" text-anchor="middle">Q3</text>
        </svg>
      </article>

      <!-- Card 3 — Call in a consultancy -->
      <article class="nl-card nl-alt-card nl-alt-card--consult">
        <span class="nl-alt-connector" aria-hidden="true">
          <svg viewBox="0 0 24 18" width="24" height="18" fill="#9A9A9A">
            <circle cx="3" cy="4" r="1.5" />
            <circle cx="6.7" cy="7.3" r="1.5" />
            <circle cx="9.4" cy="10.6" r="1.5" />
            <circle cx="12" cy="13.9" r="1.5" />
            <circle cx="14.6" cy="10.6" r="1.5" />
            <circle cx="17.3" cy="7.3" r="1.5" />
            <circle cx="21" cy="4" r="1.5" />
          </svg>
        </span>
        <p class="nl-alt-lead"><strong>Call in a consultancy.</strong> <span class="nl-dim">The good ones ship real systems now. In quarters. But then they leave.</span></p>
        <svg
          class="nl-alt-chart nl-alt-chart--steps"
          viewBox="0 0 682 235"
          role="img"
          aria-label="Line chart: an engagement climbs in steps, then flattens the day they leave while the gap keeps compounding"
        >
          <!-- faint dashed vertical gridlines -->
          <line x1="136" y1="96" x2="136" y2="222" stroke="#E6E6E6" stroke-width="1" stroke-dasharray="3 5" />
          <line x1="272" y1="96" x2="272" y2="222" stroke="#E6E6E6" stroke-width="1" stroke-dasharray="3 5" />
          <line x1="544" y1="96" x2="544" y2="222" stroke="#E6E6E6" stroke-width="1" stroke-dasharray="3 5" />
          <line x1="640" y1="96" x2="640" y2="222" stroke="#E6E6E6" stroke-width="1" stroke-dasharray="3 5" />
          <!-- the gap keeps compounding: dashed rising curve -->
          <path d="M 24 206 C 300 200, 520 168, 682 74" fill="none" stroke="#D0D0D0" stroke-width="1.5" stroke-dasharray="5 5" />
          <!-- stepped engagement line; flat after the leave point -->
          <path d="M 24 196 H 96 V 178 H 205 V 164 H 315 V 152 H 400 V 146 H 682" fill="none" stroke="#C4C4C4" stroke-width="1.5" />
          <!-- they-leave vertical marker -->
          <line x1="423" y1="118" x2="423" y2="220" stroke="#C4C4C4" stroke-width="1.5" />
          <circle cx="423" cy="146" r="4.5" fill="var(--nl-orange-deep)" />
          <circle cx="435" cy="104" r="6" fill="none" stroke="var(--nl-orange)" stroke-width="1.3" />
          <line x1="435" y1="100.6" x2="435" y2="105.4" stroke="var(--nl-orange)" stroke-width="1.4" stroke-linecap="round" />
          <circle cx="435" cy="107.7" r="0.9" fill="var(--nl-orange)" />
          <text class="nl-alt-svg-label" x="447" y="108" text-anchor="start">THEY LEAVE</text>
          <!-- engaged start -->
          <circle cx="24" cy="196" r="4.5" fill="var(--nl-orange-deep)" />
          <text class="nl-alt-svg-label" x="17" y="226" text-anchor="start">ENGAGED</text>
        </svg>
      </article>

      <!-- Closing paragraph -->
      <p class="nl-alt-closing"><span>We sold our last</span><span class="nl-dim"> company to Gap and founded their Office of AI. That expertise embeds with you on day one, and the first agents are live in weeks.</span></p>
    </div>
  </div>
</section>

<style>
  .nl-alt {
    background: var(--nl-bg);
    padding-block: 96px;
  }

  .nl-alt-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 738px);
    column-gap: 40px;
    align-items: start;
  }

  .nl-alt-head { align-self: start; }

  .nl-alt-title { margin-top: 24px; }

  /* Content column starts lower so the heading overlaps the first card, as in the design */
  .nl-alt-content { margin-top: 148px; }

  .nl-alt-card {
    position: relative;
    padding: 28px;
  }
  .nl-alt-card + .nl-alt-card { margin-top: 28px; }

  /* White connector circle bridging the 28px gap (overlaps both cards by 18px) */
  .nl-alt-connector {
    position: absolute;
    top: -46px;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 64px;
    border-radius: 999px;
    background: var(--nl-white);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 12px 32px rgba(0, 0, 0, 0.06);
    display: grid;
    place-items: center;
    z-index: 2;
  }

  .nl-alt-lead {
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--nl-ink);
    position: relative;
    z-index: 1;
  }
  .nl-alt-lead strong { font-weight: 500; color: var(--nl-ink); }
  .nl-alt-card--nothing .nl-alt-lead { max-width: 250px; }
  .nl-alt-card--hire .nl-alt-lead { max-width: 240px; }
  .nl-alt-card--consult .nl-alt-lead { max-width: 330px; }

  .nl-alt-chart {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Tall right-side bars rise alongside the lead, as in the design */
  .nl-alt-chart--bars { margin-top: -28px; }
  .nl-alt-chart--scatter { margin-top: 40px; }
  .nl-alt-chart--steps { margin-top: 24px; }

  .nl-alt-svg-label {
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    fill: #9a9a9a;
  }

  .nl-alt-closing {
    margin-top: 72px;
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: clamp(1.5rem, 2.4vw, 2.125rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--nl-heading);
  }
  /* The gray run keeps the display weight; only the color dims */
  .nl-alt-closing :global(.nl-dim) { font-weight: inherit; }

  @media (max-width: 1023px) {
    .nl-alt { padding-block: 64px; }
    .nl-alt-grid { grid-template-columns: minmax(0, 1fr); }
    .nl-alt-content { margin-top: 48px; }
    .nl-alt-card { padding: 20px; }
    .nl-alt-chart--bars { margin-top: 16px; }
    .nl-alt-closing { margin-top: 48px; }
  }
</style>
