---
// Closing "Is this you?" section: lime full-bleed band containing a white
// panel with eyebrow, heading, checklist, and two giant CTA cells.
import Eyebrow from "./Eyebrow.astro";
import DotArrow from "./DotArrow.astro";

const BOOK_A_CALL = "https://info.onmarker.com/book-a-demo";
const EMAIL = "mailto:founders@onmarker.com";

// Rendered row-major in a 2-col grid:
// col1 = items 0 & 2, col2 = items 1 & 3 (matches the design).
const checklist = [
  "A critical process runs on email and spreadsheets.",
  "A team you rely on is buried in manual work.",
  "An AI pilot exists, and never reached production.",
  "You know you need to become AI-native. Nobody can tell you where to start.",
];
---
<section class="nl-closing nl-dots-lime" aria-labelledby="closing-heading">
  <div class="nl-container">
    <div class="nl-closing-panel">
      <div class="nl-closing-top">
        <Eyebrow label="IS THIS YOU?" theme="light" />
        <h2 id="closing-heading" class="nl-display nl-h2 nl-closing-heading">
          You'll know in <span class="nl-hl">thirty seconds</span>
        </h2>
        <p class="nl-closing-sub">
          Working systems in your business in weeks. The first conversation costs thirty minutes.
        </p>
        <ul class="nl-closing-list" role="list">
          {checklist.map((item) => (
            <li class="nl-closing-item">
              <svg
                class="nl-closing-check"
                width="17"
                height="17"
                viewBox="0 0 17 17"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  d="M2.6 9.4l3.6 3.7L14.4 4"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="nl-closing-ctas">
        <a href={BOOK_A_CALL} class="nl-closing-cta">
          <DotArrow dir="ne" size={20} class="nl-closing-cta-arrow" />
          <span class="nl-display nl-closing-cta-label">Book a call</span>
        </a>
        <a href={EMAIL} class="nl-closing-cta nl-closing-cta--divided">
          <DotArrow dir="ne" size={20} class="nl-closing-cta-arrow" />
          <span class="nl-display nl-closing-cta-label">founders@onmarker.com</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .nl-closing {
    background: var(--nl-lime);
    padding-block: 56px;
  }

  .nl-closing-panel {
    background: #f7f7f7;
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .nl-closing-top {
    padding: 56px 48px 72px;
  }

  .nl-closing-heading {
    margin-top: 22px;
  }

  .nl-closing-sub {
    margin-top: 24px;
    font-size: 1.0625rem; /* 17px */
    color: var(--nl-body);
    max-width: 640px;
  }

  .nl-closing-list {
    margin-top: 52px;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 48px;
    row-gap: 20px;
    max-width: 1050px;
  }

  .nl-closing-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    font-size: 0.96875rem; /* 15.5px */
    line-height: 1.35;
    color: var(--nl-body);
  }

  .nl-closing-check {
    flex: none;
    margin-top: 2px;
    color: var(--nl-orange);
  }

  /* ── Giant CTA cells ─────────────────────────────────────────────────── */
  .nl-closing-ctas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--nl-line);
  }

  .nl-closing-cta {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    min-height: 220px;
    padding: 32px;
    text-decoration: none;
    background-color: #f7f7f7;
    background-image: linear-gradient(
      135deg,
      #ffffff 0%,
      rgba(255, 255, 255, 0) 62%
    );
    transition: background-color 140ms ease;
  }

  .nl-closing-cta--divided {
    border-left: 1px solid var(--nl-line);
  }

  .nl-closing-cta:hover {
    background-color: #ffffff;
  }

  .nl-closing-cta:focus-visible {
    outline: 2px solid var(--nl-orange);
    outline-offset: -3px;
  }

  .nl-closing-cta-label {
    font-size: 2rem; /* 32px */
    color: #1a1a1a;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  :global(.nl-closing-cta-arrow) {
    position: absolute;
    top: 30px;
    right: 32px;
    color: #1a1a1a;
  }

  @media (prefers-reduced-motion: reduce) {
    .nl-closing-cta {
      transition: none;
    }
  }

  /* ── Mobile stacking ─────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .nl-closing {
      padding-block: 32px;
    }
    .nl-closing-top {
      padding: 36px 24px 48px;
    }
    .nl-closing-list {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }
    .nl-closing-ctas {
      grid-template-columns: 1fr;
    }
    .nl-closing-cta {
      min-height: 170px;
      padding: 24px;
    }
    .nl-closing-cta--divided {
      border-left: none;
      border-top: 1px solid var(--nl-line);
    }
    .nl-closing-cta-label {
      font-size: 1.5rem;
    }
    :global(.nl-closing-cta-arrow) {
      top: 22px;
      right: 24px;
    }
  }
</style>
