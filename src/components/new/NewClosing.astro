---
// Closing "Is this you?" section: lime full-bleed band containing a white
// panel with eyebrow, heading, checklist, and two giant CTA cells.
import { Image, getImage } from "astro:assets";
import Eyebrow from "./Eyebrow.astro";
import DotArrow from "./DotArrow.astro";
import chipBorder7 from "../../assets/landing/chip-border-7.png";
import upArrow from "../../assets/landing/up-arrow.png";

const chipBorder7Img = await getImage({ src: chipBorder7, format: "png" });

const BOOK_A_CALL = "https://info.onmarker.com/book-a-call";
const EMAIL = "mailto:founders@onmarker.com";

// Rendered row-major in a 2-col grid:
// col1 = items 0 & 2, col2 = items 1 & 3 (matches the design).
const checklist = [
  "A critical process runs on email and spreadsheets.",
  "A team you rely on is buried in manual work.",
  "An AI pilot exists, but never reached production.",
  "You know you need to become AI-native to thrive.",
];
---
<section class="nl-closing nl-dots-lime" aria-labelledby="closing-heading">
  <div class="nl-container">
    <div class="nl-closing-panel">
      <div class="nl-closing-top">
        <Eyebrow label="IS THIS YOU?" theme="light" class="nl-closing-eyebrow" />
        <h2 id="closing-heading" class="nl-display nl-h2 nl-closing-heading">
          You'll know in<br class="nl-closing-break" /> <span class="nl-hl nl-closing-hl">thirty seconds</span>
        </h2>
        <p class="nl-closing-sub">
          Working systems in your business in weeks. The first conversation costs thirty minutes.
        </p>
        <ul class="nl-closing-list" role="list">
          {checklist.map((item) => (
            <li class="nl-closing-item">
              <svg
                class="nl-closing-check"
                width="18"
                height="18"
                viewBox="0 0 17 17"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  d="M2.6 9.4l3.6 3.7L14.4 4"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="nl-closing-ctas">
        <a href={BOOK_A_CALL} class="nl-closing-cta">
          <Image src={upArrow} alt="" class="nl-closing-cta-arrow" width={48} height={48} />
          <span class="nl-display nl-closing-cta-label">Book a call</span>
        </a>
        <a href={EMAIL} class="nl-closing-cta nl-closing-cta--divided">
          <Image src={upArrow} alt="" class="nl-closing-cta-arrow" width={48} height={48} />
          <span class="nl-display nl-closing-cta-label">founders@onmarker.com</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style define:vars={{ chipBorder7Url: `url(${chipBorder7Img.src})` }}>
  .nl-closing {
    background-color: var(--nl-lime);
    padding-block: 56px;
  }

  .nl-closing .nl-container {
    width: calc(100% - 184px);
    margin-inline: auto;
  }

  .nl-closing :global(.nl-closing-eyebrow) {
    padding-left: 7px;
    background-image: var(--chipBorder7Url);
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }
  .nl-closing :global(.nl-closing-eyebrow .nl-eyebrow-chip),
  .nl-closing :global(.nl-closing-eyebrow .nl-eyebrow-pill) {
    border-color: transparent;
    background: transparent;
  }
  .nl-closing :global(.nl-closing-eyebrow .nl-eyebrow-chip) {
    width: 40px;
    height: 40px;
  }
  .nl-closing :global(.nl-closing-eyebrow .nl-eyebrow-chip svg) {
    width: 19px;
    height: 19px;
    transform: translateX(-2px);
  }
  .nl-closing :global(.nl-closing-eyebrow .nl-eyebrow-pill) {
    padding: 9px 32px 8px;
    font-family: "Geist", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #6f6f6f;
  }

  .nl-closing-panel {
    background: #f7f7f7;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .nl-closing-top {
    padding: 80px 48px 72px;
  }

  .nl-closing-heading {
    margin-top: 24px;
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 64px;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  .nl-closing-heading :global(.nl-closing-hl) {
    border-radius: 8px;
    border: 1px solid #e6e6e6;
    padding-top: 0.01em;
    padding-bottom: 0.01em;
  }
  .nl-closing-break {
    display: none;
  }

  .nl-closing-sub {
    margin-top: 24px;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--nl-body);
    max-width: 760px;
  }

  .nl-closing-list {
    margin-top: 48px;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 48px;
    row-gap: 20px;
    max-width: 1050px;
  }

  .nl-closing-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--nl-body);
  }

  .nl-closing-check {
    flex: none;
    margin-top: 2px;
    color: var(--nl-orange);
  }

  /* ── Giant CTA cells ─────────────────────────────────────────────────── */
  .nl-closing-ctas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--nl-line);
  }

  .nl-closing-cta {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    min-height: 220px;
    padding: 32px;
    padding-left: 24px;
    padding-bottom: 24px;
    text-decoration: none;
    background-color: #f7f7f7;
    transition: background-color 140ms ease;
  }

  .nl-closing-cta--divided {
    border-left: 1px solid var(--nl-line);
  }

  .nl-closing-cta:hover {
    background-color: #ffffff;
    background-image: linear-gradient(
      135deg,
      #ffffff 0%,
      rgba(255, 255, 255, 0) 62%
    );
    box-shadow:
      inset 0 3.22px 7.22px 0 rgba(0, 0, 0, 0.06),
      inset 0 0 11.58px 0 rgba(0, 0, 0, 0.03);
  }

  .nl-closing-cta:focus-visible {
    outline: 2px solid var(--nl-orange);
    outline-offset: -3px;
  }

  .nl-closing-cta-label {
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 300;
    font-size: 32px;
    color: #1a1a1a;
    line-height: 1;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  :global(.nl-closing-cta-arrow) {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 24px;
    height: 24px;
    color: #1a1a1a;
  }

  @media (prefers-reduced-motion: reduce) {
    .nl-closing-cta {
      transition: none;
    }
  }

  /* ── Desktop: center the top section's content ──────────────────────── */
  @media (min-width: 768px) {
    .nl-closing-top {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .nl-closing-sub,
    .nl-closing-list {
      margin-inline: auto;
    }
  }

  /* ── Mobile stacking ─────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .nl-closing {
      padding-block: 32px;
    }
    .nl-closing-top {
      padding: 36px 24px 48px;
    }
    .nl-closing-list {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }
    .nl-closing-ctas {
      grid-template-columns: 1fr;
    }
    .nl-closing-cta {
      min-height: 170px;
      padding: 24px;
    }
    .nl-closing-cta--divided {
      border-left: none;
      border-top: 1px solid var(--nl-line);
    }
    .nl-closing-cta-label {
      font-size: 1.5rem;
    }
    :global(.nl-closing-cta-arrow) {
      top: 22px;
      right: 24px;
    }
  }

  /* ── Small screens (phones): tighter outer margin + smaller headline so it
     no longer overflows the panel, matching the mobile design ── */
  @media (max-width: 640px) {
    .nl-closing .nl-container {
      width: calc(100% - 40px);
    }
    .nl-closing-cta {
      min-height: 140px;
    }
    .nl-closing-heading {
      font-size: 40px;
    }
    .nl-closing-break {
      display: block;
    }
    .nl-closing-heading :global(.nl-closing-hl) {
      display: inline-block;
      
    }
  }
</style>
