---
// Section 8 — "WHO WE ARE": founder credentials on dark.
// Refs: slices/slice_7.png, slices/slice_8.png (top), slices/z_who_cards.png
import Eyebrow from "./Eyebrow.astro";
---

<section class="nl-founders nl-dots-dark" aria-labelledby="founders-heading">
  <div class="nl-container founders-grid">
    <!-- Left: eyebrow + heading + sub -->
    <div class="founders-intro">
      <Eyebrow label="WHO WE ARE" theme="dark" />
      <h2 id="founders-heading" class="nl-display nl-h2 nl-display--ondark founders-heading">
        We’ve sat on<br /><span class="nl-hl">every side</span> of this
      </h2>
      <p class="founders-sub">
        We’re Will, Richard, and David.<br />Building together for 15 years.
      </p>
    </div>

    <!-- Right: stacked credential cards -->
    <ul class="founders-cards" role="list">
      <li class="founders-card">
        <h3 class="founders-card-title">Backed by Y Combinator</h3>
        <span class="who-icon who-icon--y" aria-hidden="true">Y</span>
      </li>

      <li class="founders-card">
        <h3 class="founders-card-title">2-time YC founders</h3>
        <span class="who-icon" aria-hidden="true">
          <svg width="30" height="24" viewBox="0 0 27 22" fill="#6FB5F0" xmlns="http://www.w3.org/2000/svg">
            <circle cx="6" cy="4.5" r="4.5" />
            <path d="M0 22v-1.9c0-3.8 2.7-6.6 6-6.6s6 2.8 6 6.6V22H0Z" />
            <circle cx="20.5" cy="4.5" r="4.5" />
            <path d="M14.5 22v-1.9c0-3.8 2.7-6.6 6-6.6s6 2.8 6 6.6V22h-12Z" />
          </svg>
        </span>
      </li>

      <li class="founders-card">
        <h3 class="founders-card-title">2 previous exits</h3>
        <span class="who-icon who-icon--exit" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2.5 8h10.4m0 0L8.8 3.9M12.9 8l-4.1 4.1" stroke="#0A0A0A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </li>

      <li class="founders-card">
        <h3 class="founders-card-title">Founded Gap's Office of AI</h3>
        <span class="who-icon" aria-hidden="true">
          <svg width="24" height="30" viewBox="0 0 22 28" xmlns="http://www.w3.org/2000/svg">
            <!-- pair of jeans -->
            <path d="M3.5 1 H18.5 L19.6 27 H13.1 L11 13.2 L8.9 27 H2.4 Z" fill="#5B8FD4" />
            <path d="M3.3 5.5 H18.7" stroke="#0F0F0F" stroke-width="1.1" />
            <path d="M11 5.5 V10" stroke="#0F0F0F" stroke-width="1.1" />
            <path d="M3.6 8.5 L7 12 M18.4 8.5 L15 12" stroke="#0F0F0F" stroke-width="1.1" />
          </svg>
        </span>
      </li>

      <li class="founders-card founders-card--lime">
        <p class="founders-quote">Marker is the company we wish we could have hired at Gap.</p>
      </li>
    </ul>
  </div>
</section>

<style>
  .nl-founders {
    background: var(--nl-black);
    padding-block: 96px;
  }

  .founders-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 630px;
    gap: 48px;
    align-items: start;
  }

  /* ── Left column ── */
  .founders-heading {
    margin-top: 28px;
  }

  .founders-sub {
    margin-top: 22px;
    max-width: 420px;
    font-size: 16px;
    line-height: 1.5;
    color: #b9b9b9;
  }

  /* ── Right column: stacked cards ── */
  .founders-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .founders-card {
    background: var(--nl-card-dark);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 20px;
    padding: 28px;
    min-height: 130px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .founders-card-title {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--nl-white);
    letter-spacing: -0.01em;
  }

  /* Right-side icons */
  .who-icon {
    flex: none;
    display: grid;
    place-items: center;
  }

  .who-icon--y {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--nl-orange);
    color: var(--nl-white);
    font-weight: 700;
    font-size: 19px;
    line-height: 1;
  }

  .who-icon--exit {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: #4fcb6b;
  }

  /* Lime closing card */
  .founders-card--lime {
    background: var(--nl-lime);
    border: none;
  }

  .founders-quote {
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: #1a1a1a;
    max-width: 520px;
  }

  /* ── Mobile: stack the two columns ── */
  @media (max-width: 1023px) {
    .nl-founders {
      padding-block: 64px;
    }
    .founders-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .founders-card {
      min-height: 110px;
      padding: 24px;
    }
    .founders-card-title {
      font-size: 19px;
    }
    .founders-quote {
      font-size: 20px;
    }
  }
</style>
