---
// Section 8 — "WHO WE ARE": founder credentials on dark.
// Refs: slices/slice_7.png, slices/slice_8.png (top), slices/z_who_cards.png
import { Image, getImage } from "astro:assets";
import Eyebrow from "./Eyebrow.astro";
import ycLogo from "../../assets/landing/y-combinator-logo.png";
import twoTimesYcLogo from "../../assets/landing/two-times-yc-logo.png";
import previousExitLogo from "../../assets/landing/previous-exit-logo.png";
import gapLogo from "../../assets/landing/gap-logo.png";
import chipBorder6 from "../../assets/landing/chip-border-6.png";

const chipBorder6Img = await getImage({ src: chipBorder6, format: "png" });
---

<section id="who-we-are" class="nl-founders nl-dots-dark" aria-labelledby="founders-heading">
  <div class="nl-container founders-grid">
    <!-- Left: eyebrow + heading + sub -->
    <div class="founders-intro">
      <Eyebrow label="WHO WE ARE" theme="dark" class="founders-eyebrow" />
      <h2 id="founders-heading" class="nl-display nl-h2 nl-display--ondark founders-heading">
        We’ve sat on<br /><span class="nl-hl founders-hl">every side</span>of this
      </h2>
      <p class="founders-sub">
        We’re Will, Richard, and David. Building together <br /> for 15 years.
      </p>
    </div>

    <!-- Right: stacked credential cards -->
    <ul class="founders-cards" role="list">
      <li class="founders-card">
        <h3 class="founders-card-title">Backed by Y Combinator</h3>
        <Image src={ycLogo} alt="" class="who-icon who-icon--y" width={48} height={48} />
      </li>

      <li class="founders-card">
        <h3 class="founders-card-title">2-time YC founders</h3>
        <Image src={twoTimesYcLogo} alt="" class="who-icon who-icon--two-time" width={64} height={64} />
      </li>

      <li class="founders-card">
        <h3 class="founders-card-title">2 previous exits</h3>
        <Image src={previousExitLogo} alt="" class="who-icon who-icon--exit" width={64} height={64} />
      </li>

      <li class="founders-card">
        <h3 class="founders-card-title">Founded Gap's Office of AI</h3>
        <Image src={gapLogo} alt="" class="who-icon who-icon--gap" width={71} height={64} />
      </li>

      <li class="founders-card founders-card--lime">
        <p class="founders-quote">Marker is the company we wish we could have hired at Gap.</p>
      </li>
    </ul>
  </div>
</section>

<style define:vars={{ chipBorder6Url: `url(${chipBorder6Img.src})` }}>
  .nl-founders {
    background-color: var(--nl-black);
    padding-top: 80px;
    padding-bottom: 96px;
  }

  .nl-founders :global(.founders-eyebrow) {
    padding-left: 7px;
    background-image: var(--chipBorder6Url);
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }
  .nl-founders :global(.founders-eyebrow .nl-eyebrow-chip),
  .nl-founders :global(.founders-eyebrow .nl-eyebrow-pill) {
    border-color: transparent;
    background: transparent;
  }
  .nl-founders :global(.founders-eyebrow .nl-eyebrow-chip) {
    width: 40px;
    height: 40px;
  }
  .nl-founders :global(.founders-eyebrow .nl-eyebrow-chip svg) {
    width: 19px;
    height: 19px;
    transform: translateX(-2.5px);
  }
  .nl-founders :global(.founders-eyebrow .nl-eyebrow-pill) {
    padding: 9px 32px 8px;
    font-family: "Geist", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #cccccc;
  }

  .founders-grid {
    width: calc(100% - 160px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 630px;
    gap: 48px;
    align-items: start;
  }

  /* ── Left column ── */
  .founders-heading {
    margin-top: 24px;
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 54px;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  .founders-heading :global(.founders-hl) {
    border-radius: 8px;
    border: 1px solid #e6e6e6;
    padding-top: 0;
    padding-bottom: 0;
  }

  .founders-sub {
    margin-top: 24px;
    max-width: 420px;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #b9b9b9;
  }

  /* ── Right column: stacked cards ── */
  .founders-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .founders-card {
    background: var(--nl-card-dark);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 32px;
    min-height: 130px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .founders-card-title {
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--nl-white);
    letter-spacing: -0.03em;
  }

  /* Right-side icons */
  .who-icon {
    flex: none;
    display: grid;
    place-items: center;
  }

  .who-icon--y,
  .who-icon--two-time,
  .who-icon--exit {
    width: 32px;
    height: 32px;
  }

  .who-icon--gap {
    width: 35px;
    height: 32px;
  }

  /* Lime closing card */
  .founders-card--lime {
    background: var(--nl-lime);
    align-items: center;
    padding: 32px;
  }

  .founders-quote {
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 32px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.7px;
    color: #1a1a1a;
    max-width: 520px;
  }

  /* ── Mobile: stack the two columns ── */
  @media (max-width: 1023px) {
    .nl-founders {
      padding-block: 64px;
    }
    .founders-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .founders-card {
      min-height: 110px;
      padding: 24px;
    }
    .founders-card-title {
      font-size: 19px;
    }
    .founders-quote {
      font-size: 20px;
    }
  }

  /* ── Small screens (phones): tighter margins, smaller headline, and
     credential cards stacked icon-on-top instead of icon-beside-title,
     matching the mobile design ── */
  @media (max-width: 640px) {
    .nl-founders .nl-container {
      width: calc(100% - 40px);
    }
    .founders-heading {
      font-size: 40px;
    }
    .founders-sub {
      font-size: 16px;
    }
    .founders-card {
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      min-height: 160px;
      padding: 24px;
    }
    .founders-card .who-icon {
      order: -1;
    }
    .founders-card-title {
      font-size: 20px;
    }
    .founders-card--lime {
      align-items: flex-start;
    }
    .founders-quote {
      font-size: 24px;
    }
  }
</style>
