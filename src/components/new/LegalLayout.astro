---
// Shell for the /new legal pages: ink frame + logo tab (as on the landing
// hero), display heading with lime highlight, restyled Termly content slot,
// and the /new footer. Content components carry inline Termly styles, so the
// overrides below use !important to win over them.
import Layout from "../../layouts/Layout.astro";
import "../../styles/new-landing.css";
import MarkerMark from "./MarkerMark.astro";
import Eyebrow from "./Eyebrow.astro";
import NewFooter from "./NewFooter.astro";

interface Props {
  metaTitle: string;
  description: string;
  titlePre: string;
  titleHl: string;
}
const { metaTitle, description, titlePre, titleHl } = Astro.props;
---

<Layout title={metaTitle} description={description} noindex={true} favicon="/favicon-new">
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700&display=swap"
  />
  <div class="nl-page nll">
    <main id="main-content">
      <section class="nll-frame">
        <a href="/new" class="nll-tab" aria-label="Marker — back to landing page">
          <MarkerMark class="nll-tab-mark" title="Marker" />
        </a>
        <span class="nll-tab-corner nll-tab-corner--right" aria-hidden="true"></span>
        <span class="nll-tab-corner nll-tab-corner--below" aria-hidden="true"></span>

        <div class="nll-panel">
          <header class="nl-container nll-header">
            <Eyebrow label="LEGAL" />
            <h1 class="nl-display nl-h2 nll-title">
              {titlePre} <span class="nl-hl">{titleHl}</span>
            </h1>
          </header>
          <div class="nll-content">
            <slot />
          </div>
        </div>
      </section>
    </main>
    <NewFooter />
  </div>
</Layout>

<style>
  /* ── Ink frame + tab (same treatment as the landing hero) ─────────────── */
  .nll-frame {
    position: relative;
    background: var(--nl-ink);
    padding: 12px 12px 0;
  }
  .nll-panel {
    background: var(--nl-bg);
    overflow: hidden;
  }
  .nll-tab {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    width: 168px;
    height: 110px;
    background: var(--nl-ink);
    border-bottom-right-radius: 11px;
    display: grid;
    place-items: center;
    color: var(--nl-white);
  }
  .nll-tab:focus-visible {
    outline: 2px solid var(--nl-orange);
    outline-offset: -4px;
  }
  .nll-tab :global(.nll-tab-mark) {
    width: 78px;
    height: auto;
  }
  .nll-tab-corner {
    position: absolute;
    z-index: 3;
    width: 12px;
    height: 12px;
    pointer-events: none;
    background: radial-gradient(circle 12px at 100% 100%, transparent 11.3px, var(--nl-ink) 11.8px);
  }
  .nll-tab-corner--right {
    top: 12px;
    left: 168px;
  }
  .nll-tab-corner--below {
    top: 110px;
    left: 12px;
  }

  /* ── Page header ──────────────────────────────────────────────────────── */
  .nll-header {
    padding-top: 190px;
    padding-bottom: 24px;
  }
  .nll-title {
    margin: 28px 0 0;
  }

  /* ── Termly content, restyled to the landing design ───────────────────── */
  /* The shared content components carry inline Arial/gray styles from
     Termly, hence !important throughout. */
  .nll-content {
    max-width: 880px;
    margin-inline: auto;
    padding: 24px 24px 112px;
  }
  .nll-content :global(*) {
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif !important;
    background: transparent !important;
  }
  /* We render our own page title above */
  .nll-content :global([data-custom-class="title"]),
  .nll-content :global([data-custom-class="title"] *) {
    display: none !important;
  }
  .nll-content :global([data-custom-class="subtitle"]),
  .nll-content :global([data-custom-class="subtitle"] *) {
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: #6b6b6b !important;
  }
  .nll-content :global([data-custom-class="heading_1"]),
  .nll-content :global([data-custom-class="heading_1"] *) {
    font-family: "Inter Tight", "Inter", ui-sans-serif, system-ui, sans-serif !important;
    font-size: 24px !important;
    font-weight: 600 !important;
    letter-spacing: -0.02em !important;
    line-height: 1.2 !important;
    color: var(--nl-heading) !important;
  }
  .nll-content :global([data-custom-class="heading_2"]),
  .nll-content :global([data-custom-class="heading_2"] *) {
    font-family: "Inter Tight", "Inter", ui-sans-serif, system-ui, sans-serif !important;
    font-size: 18px !important;
    font-weight: 600 !important;
    letter-spacing: -0.01em !important;
    color: var(--nl-heading) !important;
  }
  .nll-content :global([data-custom-class="body_text"]),
  .nll-content :global([data-custom-class="body_text"] *),
  .nll-content :global(li),
  .nll-content :global(td),
  .nll-content :global(td *) {
    font-size: 15.5px !important;
    line-height: 1.7 !important;
    color: var(--nl-body) !important;
  }
  .nll-content :global(strong),
  .nll-content :global(strong *) {
    color: var(--nl-heading) !important;
    font-weight: 600 !important;
  }
  .nll-content :global(a),
  .nll-content :global(a *),
  .nll-content :global([data-custom-class="link"]),
  .nll-content :global([data-custom-class="link"] *) {
    /* Darker take on --nl-orange: brand #F35901 is 3.1:1 on this bg,
       below the 4.5:1 WCAG AA minimum for body-size text */
    color: #c24601 !important;
    text-decoration: underline !important;
    word-break: break-word !important;
  }
  .nll-content :global(a:focus-visible) {
    outline: 2px solid var(--nl-orange);
    outline-offset: 2px;
    border-radius: 2px;
  }
  /* Original list markers, kept from the legacy pages */
  .nll-content :global(ul) {
    list-style-type: square;
    padding-left: 1.4em;
  }
  .nll-content :global(ul > li > ul) {
    list-style-type: circle;
  }
  .nll-content :global(ul > li > ul > li > ul) {
    list-style-type: square;
  }
  .nll-content :global(table) {
    border-collapse: collapse;
  }

  /* Footer needs breathing room after the content panel */
  .nll :global(.nl-footer) {
    padding-top: 48px;
  }

  @media (max-width: 640px) {
    .nll-tab {
      width: 128px;
      height: 86px;
    }
    .nll-tab :global(.nll-tab-mark) {
      width: 52px;
    }
    .nll-tab-corner--right {
      left: 128px;
    }
    .nll-tab-corner--below {
      top: 86px;
    }
    .nll-header {
      padding-top: 140px;
    }
  }
</style>
