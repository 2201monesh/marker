---
// Section 4 — "THE SOLUTION". Dark section with the pixel-blob graphic and
// two floating annotations. Refs: slice_3.png (bottom), slice_4.png (top),
// z_solution_blob.png.
import { Image, getImage } from "astro:assets";
import Eyebrow from "./Eyebrow.astro";
import unionBlob from "../../assets/landing/Union.png";
import chipBorder3 from "../../assets/landing/chip-border-3.png";

const chipBorder3Img = await getImage({ src: chipBorder3, format: "png" });
---
<section id="the-solution" class="nl-solution nl-dots-dark" aria-labelledby="nl-solution-title">
  <div class="nl-container">
    <Eyebrow label="THE SOLUTION" theme="dark" class="nl-solution-eyebrow" />

    <h2 id="nl-solution-title" class="nl-display nl-h2 nl-display--ondark nl-solution-heading">
      AI agents that <span class="nl-hl nl-solution-hl nl-solution-hl--left">understand your</span><br /><span class="nl-hl nl-solution-hl nl-solution-hl--right">company,</span> then transform it
    </h2>

    <p class="nl-solution-sub">
      We embed with your teams, learn how the work actually happens, and build custom
      agents on the Marker Command Center.
    </p>

    <div class="nl-solution-comp">
      <p class="nl-solution-note nl-solution-note--right">
        <strong>The first agents go live in weeks. Then a week. Then days.</strong>
        <span>We keep going until you're running an AI-native organization.</span>
      </p>

      <div class="nl-solution-blob-wrap">
        <Image src={unionBlob} alt="" class="nl-solution-blob" width={833} height={286} />
      </div>

      <p class="nl-solution-note nl-solution-note--left">
        <strong>They work the way you already work.</strong>
        <span>The spreadsheets, reports, and queues your team already knows. No new software to learn.</span>
      </p>
    </div>
  </div>
</section>

<style define:vars={{ chipBorder3Url: `url(${chipBorder3Img.src})` }}>
  .nl-solution {
    background-color: var(--nl-black);
    padding-top: 80px;
    padding-bottom: 96px;
  }

  .nl-solution .nl-container {
    width: calc(100% - 160px);
    margin-inline: auto;
  }

  .nl-solution :global(.nl-solution-eyebrow) {
    padding-left: 7px;
    background-image: var(--chipBorder3Url);
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }
  .nl-solution :global(.nl-solution-eyebrow .nl-eyebrow-chip),
  .nl-solution :global(.nl-solution-eyebrow .nl-eyebrow-pill) {
    border-color: transparent;
    background: transparent;
  }
  .nl-solution :global(.nl-solution-eyebrow .nl-eyebrow-chip) {
    width: 40px;
    height: 40px;
  }
  .nl-solution :global(.nl-solution-eyebrow .nl-eyebrow-chip svg) {
    width: 19px;
    height: 19px;
    transform: translateX(-2px);
  }
  .nl-solution :global(.nl-solution-eyebrow .nl-eyebrow-pill) {
    padding: 9px 32px 8px;
    font-family: "Geist", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #cccccc;
  }

  .nl-solution-heading {
    max-width: 800px;
    margin-top: 24px;
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 54px;
    line-height: 1.3;
    letter-spacing: -0.04em;
  }
  .nl-solution-heading :global(.nl-solution-hl) {
    padding-top: 0.01em;
    padding-bottom: 0.01em;
    border: 1px solid #e6e6e6;
    border-radius: 8px;
  }
  .nl-solution-heading :global(.nl-solution-hl--left) {
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
  }
  .nl-solution-heading :global(.nl-solution-hl--right) {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 0;
    padding-bottom: 0;
  }

  .nl-solution-sub {
    margin-top: 24px;
    max-width: 560px;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #dcdcdc;
  }

  /* ── Composition: mobile-first stacked flow ─────────────────────────── */
  .nl-solution-comp {
    margin-top: 49px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Transparent wrapper: keeps the mobile-only grid placement/rotation off
     the tablet (flex) and desktop (absolute) layouts, which target the img
     itself unchanged. */
  .nl-solution-blob-wrap {
    display: contents;
  }

  .nl-solution-blob {
    display: block;
    width: min(100%, 440px);
    height: auto;
    align-self: center;
    /* soft halo around the shape, as in the design */
    filter: drop-shadow(0 0 18px rgba(255, 255, 255, 0.15));
  }

  .nl-solution-note {
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 18px;
    line-height: 1.4;
    letter-spacing: -0.03em;
    max-width: 400px;
  }
  .nl-solution-note strong,
  .nl-solution-note span {
    font-weight: 500;
  }
  .nl-solution-note strong {
    display: block;
    color: var(--nl-white);
  }
  .nl-solution-note span {
    display: block;
    font-weight: 400;
    color: #9a9a9a;
  }

  /* ── Desktop (1440 design): absolutely-positioned composition ───────── */
  @media (min-width: 1024px) {
    .nl-solution {
      padding-top: 112px;
      padding-bottom: 128px;
    }
    .nl-solution-comp {
      display: block;
      position: relative;
      min-height: 340px;
    }

    .nl-solution-blob {
      position: absolute;
      top: 44px;
      right: 220px;
      width: 440px;
    }

    .nl-solution-note--right {
      position: absolute;
      top: 0;
      right: 8px;
      width: 280px;
    }

    .nl-solution-note--left {
      position: absolute;
      top: 206px;
      right: 300px;
      width: 340px;
    }
  }

  /* ── Small screens (phones): tighter margins, smaller heading, and the
     two notes stacked left with the chain graphic rotated upright beside
     them, matching the mobile design ── */
  @media (max-width: 640px) {
    .nl-solution .nl-container {
      width: calc(100% - 40px);
    }
    .nl-solution-heading {
      font-size: 44px;
    }
    .nl-solution-heading :global(.nl-solution-hl--right) {
      display: inline-block;
      margin-top: 5px;
    }
    .nl-solution-comp {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "noteRight blob"
        "noteLeft  blob";
      column-gap: 20px;
      row-gap: 32px;
    }
    .nl-solution-note {
      font-size: 15px;
    }
    .nl-solution-note--right {
      grid-area: noteRight;
      max-width: none;
    }
    .nl-solution-note--left {
      grid-area: noteLeft;
      max-width: none;
    }
    .nl-solution-blob-wrap {
      display: grid;
      place-items: center;
      grid-area: blob;
      align-self: center;
      width: 90px;
      height: 260px;
    }
    .nl-solution-blob-wrap .nl-solution-blob {
      width: 260px !important;
      height: auto;
      transform: rotate(90deg);
    }
  }
</style>
