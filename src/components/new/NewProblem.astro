---
// NewProblem — dark "THE PROBLEM" section.
// Heading row (h2 left, intro paragraph right), then a 2-col grid:
// orange gradient quote card (left) + two stacked white label cards (right).
// Refs: .context/attachments/w7FOib/slices/slice_1.png, z_eyebrow.png, z_dark_labels.png
import { Image, getImage } from "astro:assets";
import Eyebrow from "./Eyebrow.astro";
import commaLogo from "../../assets/landing/comma-logo.png";
import chipBorder1 from "../../assets/landing/chip-border-1.png";
import orangeGradientBg from "../../assets/landing/orange-gradient-bg.png";

const chipBorder1Img = await getImage({ src: chipBorder1, format: "png" });
const orangeGradientBgImg = await getImage({ src: orangeGradientBg, format: "png" });
---

<section id="the-problem" class="nl-problem nl-dots-dark" aria-labelledby="new-problem-heading">
  <div class="nl-container">
    <Eyebrow label="THE PROBLEM" theme="dark" class="nl-problem-eyebrow" />

    <div class="nl-problem-head">
      <h2 id="new-problem-heading" class="nl-display nl-h2 nl-display--ondark">
        You can see<br />
        <span class="nl-hl nl-problem-hl">where this is going</span>
      </h2>
      <p class="nl-problem-intro">
        You know AI should transform how your company works.<br />
        95% of AI initiatives still fail. We watched why from inside Gap.
      </p>
    </div>

    <div class="nl-problem-grid">
      <figure class="nl-problem-quote">
        <Image
          src={commaLogo}
          alt=""
          class="nl-problem-quote-glyph"
          width={152}
          height={116}
        />
        <blockquote>
          You're not short on ambition. You're short on time, expertise, and a map of what's possible.
        </blockquote>
      </figure>

      <div class="nl-problem-cards">
        <article class="nl-card nl-problem-card">
          <h3 class="nl-label nl-problem-card-label">CONDITION</h3>
          <p>How work really happens lives in people's heads, not documentation.</p>
        </article>
        <article class="nl-card nl-problem-card">
          <h3 class="nl-label nl-problem-card-label">PRESENT</h3>
          <p>Knowing what AI can actually do, and getting it all the way into production.</p>
        </article>
      </div>
    </div>
  </div>
</section>

<style define:vars={{
  chipBorder1Url: `url(${chipBorder1Img.src})`,
  orangeGradientBgUrl: `url(${orangeGradientBgImg.src})`,
}}>
  .nl-problem {
    background-color: var(--nl-black);
    padding: 80px 0 96px;
  }

  .nl-problem :global(.nl-problem-eyebrow) {
    margin-bottom: 24px;
    padding-left: 7px;
    background-image: var(--chipBorder1Url);
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }
  .nl-problem :global(.nl-problem-eyebrow .nl-eyebrow-chip),
  .nl-problem :global(.nl-problem-eyebrow .nl-eyebrow-pill) {
    border-color: transparent;
    background: transparent;
  }
  .nl-problem :global(.nl-problem-eyebrow .nl-eyebrow-chip) {
    width: 40px;
    height: 40px;
  }
  .nl-problem :global(.nl-problem-eyebrow .nl-eyebrow-chip svg) {
    width: 19px;
    height: 19px;
    transform: translateX(-2px);
  }
  .nl-problem :global(.nl-problem-eyebrow .nl-eyebrow-pill) {
    padding: 9px 32px 8px;
    font-family: "Geist", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #cccccc;
  }

  /* ── Heading row: h2 left, intro paragraph bottom-aligned on the right ── */
  .nl-problem-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 56px;
  }
  .nl-problem-head h2 {
    margin: 0;
    font-size: 54px;
    
    letter-spacing: -0.04em;
  }
  .nl-problem-head :global(.nl-problem-hl) {
    border-radius: 9px;
    border: 1px solid #e6e6e6;
    padding-top: 0.01em;
    padding-bottom: 0.01em;
  }
  .nl-problem-intro {
    margin: 0 0 6px;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #dcdcdc;
    max-width: 520px;
  }

  /* ── Card grid ── */
  .nl-problem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  /* Orange gradient quote card */
  .nl-problem-quote {
    position: relative;
    margin: 0;
    min-height: 440px;
    padding: 24px;
    border-radius: 14px;
    overflow: hidden;
    background-color: #f25001;
    background-image: var(--orangeGradientBgUrl);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 12px 32px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .nl-problem-quote-glyph {
    position: relative;
    flex: none;
    width: 75.6px;
    height: 57.84px;
  }
  .nl-problem-quote blockquote {
    position: relative;
    margin: 0;
    font-family: "Stack Sans Headline", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 32px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: #1a1a1a;
    max-width: 470px;
  }

  /* Two stacked white cards: label pinned top, copy pinned bottom */
  .nl-problem-cards {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 24px;
  }
  .nl-problem-card {
    border-radius: 14px;
    padding: 24px;
    min-height: 208px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .nl-problem-card-label {
    margin: 0;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.6);
  }
  .nl-problem-card p {
    margin: 0;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: #1a1a1a;
    max-width: 620px;
  }

  /* ── Mobile: stack everything ── */
  @media (max-width: 1023px) {
    .nl-problem {
      padding: 64px 0;
    }
    .nl-problem-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 36px;
    }
    .nl-problem-intro {
      margin-bottom: 0;
    }
    .nl-problem-grid {
      grid-template-columns: 1fr;
    }
    .nl-problem-quote {
      min-height: 360px;
    }
    .nl-problem-cards {
      grid-template-rows: none;
    }
    .nl-problem-card {
      min-height: 176px;
    }
  }
</style>
