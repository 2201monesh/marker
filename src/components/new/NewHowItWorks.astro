---
// Section 7 — "How Marker works": four numbered process rows, each with a
// recreated graphic card (molecules / ranked pills / ship grid / bars).
import Eyebrow from "./Eyebrow.astro";

// 01 UNDERSTAND — diagram is an inline SVG asset exported from Figma

// 02 FIND — ranked opportunity pill rows. Pastel inset discs with uniform
// dark-charcoal glyphs, colors sampled from the Figma export.
const ranks = [
  {
    label: "Growth",
    score: 91,
    bg: "#C5ECCF",
    glyph:
      '<rect x="2.4" y="7.2" width="2.5" height="4.6" rx="1"/><rect x="5.8" y="4.2" width="2.5" height="7.6" rx="1"/><rect x="9.2" y="6" width="2.5" height="5.8" rx="1"/>',
  },
  {
    label: "Opportunity",
    score: 87,
    bg: "#F6E6CF",
    glyph:
      '<circle cx="7" cy="7" r="4.3" fill="none" stroke="currentColor" stroke-width="1.3"/><circle cx="7" cy="7" r="1.7"/><path d="M7 .9v2.2M7 10.9v2.2M.9 7h2.2M10.9 7h2.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none"/>',
  },
  {
    label: "Capacity",
    score: 76,
    bg: "#ECE0F1",
    glyph:
      '<circle cx="7" cy="7" r="5.3" fill="none" stroke="currentColor" stroke-width="1.3"/><circle cx="7" cy="7" r="1.4"/><path d="M7.9 6.1 10 3.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>',
  },
  {
    label: "Speed",
    score: 64,
    bg: "#EEF3A9",
    glyph: '<path d="M7.9 1 3.2 7.7h3L5.6 13l4.9-6.9H7.6L7.9 1Z"/>',
  },
  {
    label: "Cost",
    score: 42,
    bg: "#F5B995",
    glyph:
      '<circle cx="7" cy="7" r="5.8"/><path d="M7 3.6v6.8M8.8 5.1c-.4-.6-2.8-.9-3.2.3-.4 1.5 3.2 1.1 2.8 2.7-.3 1.2-2.6 1-3.2.2" fill="none" stroke="#F5B995" stroke-width="1.1" stroke-linecap="round"/>',
  },
];

// 03 BUILD & SHIP — 5×5 tile grid: 7 shipped (checks), 2 escalations, rest idle
const cells = Array.from({ length: 25 }, (_, i) =>
  i < 7 ? "check" : i === 8 || i === 16 ? "alert" : "dot"
);

// 04 COMPOUND — descending rounded bars (% of the track height), last one green
const bars = [96, 73, 53, 42, 36];
