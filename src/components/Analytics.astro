---
const enableAnalytics = import.meta.env.PUBLIC_ENABLE_ANALYTICS === 'true';
const allowedHosts = ['onmarker.com', 'www.onmarker.com'];
---

<!-- Analytics hostname check -->
<script is:inline define:vars={{ allowedHosts, enableAnalytics }}>
  window.__isAnalyticsAllowed = function() {
    // PUBLIC_ENABLE_ANALYTICS=true allows analytics on any host
    // (used for localhost dev, Firebase preview deploys, and CI tests)
    if (enableAnalytics) return true;
    return allowedHosts.indexOf(window.location.hostname) !== -1;
  };
</script>

<!-- HubSpot -->
<script is:inline>
  (function() {
    if (window.__isAnalyticsAllowed()) {
      var s = document.createElement('script');
      s.type = 'text/javascript';
      s.id = 'hs-script-loader';
      s.async = true;
      s.defer = true;
      s.src = '//js-na2.hs-scripts.com/245531796.js';
      document.head.appendChild(s);
    }
  })();
</script>

<!-- Amplitude -->
<script is:inline>
  (function() {
    if (window.__isAnalyticsAllowed()) {
      var s = document.createElement('script');
      s.src = 'https://cdn.amplitude.com/script/f5e0953df77a321bb7647f2268a9ed7b.js';
      s.onload = function() {
        // Tag all events with the environment they came from
        var h = window.location.hostname;
        var env = (h === 'onmarker.com' || h === 'www.onmarker.com')
          ? 'production'
          : h === 'localhost'
            ? 'development'
            : 'preview';
        window.amplitude.add({
          name: 'environment-tagger',
          type: 'enrichment',
          execute: function(event) {
            event.event_properties = Object.assign({}, event.event_properties, {
              environment: env
            });
            return event;
          }
        });
        window.amplitude.add(window.sessionReplay.plugin({sampleRate: 1}));
        var isDebug = env !== 'production';
        window.amplitude.init('f5e0953df77a321bb7647f2268a9ed7b', {
          fetchRemoteConfig: true,
          logLevel: 0, // keep console clean; our custom [Amplitude Debug] log is enough
          autocapture: {
            attribution: true,
            fileDownloads: true,
            formInteractions: true,
            pageViews: true,
            sessions: true,
            elementInteractions: true,
            networkTracking: true,
            webVitals: true,
            frustrationInteractions: {
              thrashedCursor: true,
              errorClicks: true,
              deadClicks: true,
              rageClicks: true
            }
          }
        });

        // Log debug info once Amplitude has fully initialized
        if (isDebug) {
          var debugPoll = setInterval(function() {
            var deviceId = window.amplitude.getDeviceId();
            if (deviceId) {
              clearInterval(debugPoll);
              console.log(
                '%c[Amplitude Debug]',
                'color: #7c3aed; font-weight: bold;',
                '\n  Environment:', env,
                '\n  Device ID:', deviceId,
                '\n  Session ID:', window.amplitude.getSessionId(),
                '\n  User ID:', window.amplitude.getUserId() || '(anonymous)'
              );
            }
          }, 200);
          // Stop polling after 10s to avoid leaking
          setTimeout(function() { clearInterval(debugPoll); }, 10000);
        }
      };
      document.head.appendChild(s);
    }
  })();
</script>

<!-- LinkedIn Insight Tag -->
<script is:inline>
  (function() {
    if (!window.__isAnalyticsAllowed()) return;
    window._linkedin_partner_id = "9264476";
    window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
    window._linkedin_data_partner_ids.push(window._linkedin_partner_id);
    (function(l) {
      if (!l) {
        window.lintrk = function(a, b) { window.lintrk.q.push([a, b]); };
        window.lintrk.q = [];
      }
      var s = document.getElementsByTagName("script")[0];
      var b = document.createElement("script");
      b.type = "text/javascript";
      b.async = true;
      b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
      s.parentNode.insertBefore(b, s);
    })(window.lintrk);
  })();
</script>
<noscript>
  <img height="1" width="1" style="display:none;" alt="" src="https://px.ads.linkedin.com/collect/?pid=9264476&fmt=gif" />
</noscript>

<!-- Amplitude cross-domain tracking: append device/session IDs to info.onmarker.com links -->
<script is:inline>
  document.addEventListener('click', function(e) {
    var link = e.target.closest('a[href*="info.onmarker.com"]');
    if (!link || !window.amplitude) return;

    var deviceId = window.amplitude.getDeviceId();
    var sessionId = window.amplitude.getSessionId();
    if (!deviceId || !sessionId) return;

    var url = new URL(link.href);
    url.searchParams.set('ampDeviceId', deviceId);
    url.searchParams.set('ampSessionId', sessionId);
    url.searchParams.set('ampTimestamp', String(Date.now() + 60000));
    link.href = url.toString();
  });
</script>
