---
import HumanHub from "./HumanHub.astro";
---

<section class="relative bg-muted bg-paper wash-ochre-bl mat-bevel" aria-labelledby="problem-heading" id="problem-section">
  <!-- Extra height creates scroll room for the transition -->
  <div class="problem-scroll-spacer">
    <div class="problem-sticky">
      <div class="relative z-10 mx-auto max-w-7xl px-8 py-16 md:py-20">
        <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">

          <!-- Left column: text -->
          <div class="max-w-xl">
            <h2 id="problem-heading" class="ink-reveal text-3xl font-bold tracking-tight text-foreground leading-[1.15] md:text-4xl">
              Your team is the glue between your systems.
              <br />
              It shouldn't be.
            </h2>
            <p class="ink-reveal mt-6 text-muted-foreground md:text-lg leading-relaxed" style="--reveal-delay: 120">
              Your team chases updates, syncs spreadsheets, and nudges work across ERPs, PLM, messengers, and email. Deadlines slip. Handoffs get dropped. It only gets worse as you scale.
            </p>
          </div>

          <!-- Right column: Human Hub graphic -->
          <HumanHub />

        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .problem-scroll-spacer {
    height: 200vh;
    position: relative;
  }

  .problem-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
  }

  /* On mobile, reduce scroll room since the graphic is smaller */
  @media (max-width: 767px) {
    .problem-scroll-spacer {
      height: 180vh;
    }
  }
</style>
