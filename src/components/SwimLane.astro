---
/*  Swim Lane Section
    Two-lane visualization: Marker handles the systems work, your team makes the decisions.
    Horizontal layout that extends full-width and clips at viewport edge. */

interface Task {
  title: string;
  role?: string;
}

// Marker lane — systems-heavy, click-heavy, tedious
const markerTasks: Task[] = [
  { title: "Create purchase orders in ERP" },
  { title: "Update PO dates from supplier emails" },
  { title: "Build tech packs from assets" },
  { title: "Request vendor costing" },
  { title: "Distribute tech packs to factories" },
  { title: "Sync spec revisions across systems" },
  { title: "Compile weekly status reports" },
  { title: "Track shipment ETAs" },
  { title: "Send sample requests to vendors" },
  { title: "Cross-reference data across tools" },
  { title: "Update costing spreadsheets" },
  { title: "Chase vendor responses" },
];

// Your team lane — high-value human expertise
const teamTasks: Task[] = [
  { title: "Set design direction", role: "Design" },
  { title: "Select fabrics and trims", role: "PD" },
  { title: "Build the buy plan", role: "Merch" },
  { title: "Evaluate proto fit", role: "TD" },
  { title: "Sign off final styles", role: "Merch" },
  { title: "Negotiate with suppliers", role: "PD" },
  { title: "Approve costing", role: "PD" },
];
---

<section class="relative py-24 md:py-32 overflow-hidden" aria-labelledby="swimlane-heading">
  <div class="mx-auto max-w-7xl px-8">
    <div class="max-w-2xl mb-14">
      <h2 id="swimlane-heading" class="ink-reveal text-3xl font-bold tracking-tight text-foreground leading-[1.15] md:text-4xl">
        Marker handles the work.<br />
        <span class="text-primary">Your team makes the calls.</span>
      </h2>
      <p class="ink-reveal mt-5 text-muted-foreground md:text-lg leading-relaxed" style="--reveal-delay: 100">
        Most of your supply chain calendar is coordination — syncing data, chasing updates, distributing documents. Marker runs those steps automatically. When something needs human judgment — a mismatch, an exception, a decision — the right person knows immediately. Your team stays focused on the calls that actually matter.
      </p>
    </div>
  </div>

  <!-- Swim lane visualization — full width, clips at edge -->
  <div class="swimlane-outer">
    <!-- Marker lane -->
    <div class="swimlane-lane swimlane-lane--agent">
      <div class="swimlane-label">
        <div class="swimlane-label-icon swimlane-label-icon--agent">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <line x1="12" y1="2" x2="12" y2="5" stroke="currentColor" stroke-linecap="round"/>
            <circle cx="12" cy="2" r="1" fill="currentColor" stroke="none"/>
            <rect x="4" y="5" width="16" height="14" rx="3" stroke="currentColor"/>
            <rect x="7" y="9" width="3" height="2" rx="0.5" fill="currentColor" stroke="none"/>
            <rect x="14" y="9" width="3" height="2" rx="0.5" fill="currentColor" stroke="none"/>
            <path d="M9 14h6" stroke="currentColor" stroke-linecap="round"/>
          </svg>
        </div>
        <span class="swimlane-label-text swimlane-label-text--agent">Marker</span>
      </div>
      <div class="swimlane-track">
        {markerTasks.map((task, i) => (
          <div class="swimlane-card swimlane-card--agent" style={`--card-index: ${i}`}>
            <div class="swimlane-card-icon swimlane-card-icon--agent">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                <line x1="12" y1="2" x2="12" y2="5" stroke="currentColor" stroke-linecap="round"/>
                <circle cx="12" cy="2" r="1" fill="currentColor" stroke="none"/>
                <rect x="4" y="5" width="16" height="14" rx="3" stroke="currentColor"/>
                <rect x="7" y="9" width="3" height="2" rx="0.5" fill="currentColor" stroke="none"/>
                <rect x="14" y="9" width="3" height="2" rx="0.5" fill="currentColor" stroke="none"/>
                <path d="M9 14h6" stroke="currentColor" stroke-linecap="round"/>
              </svg>
            </div>
            <span class="swimlane-card-label">{task.title}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Your team lane -->
    <div class="swimlane-lane swimlane-lane--team">
      <div class="swimlane-label">
        <div class="swimlane-label-icon swimlane-label-icon--team">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 21v-1a6 6 0 0112 0v1"/>
          </svg>
        </div>
        <span class="swimlane-label-text swimlane-label-text--team">Your team</span>
      </div>
      <div class="swimlane-track">
        {teamTasks.map((task, i) => (
          <div class="swimlane-card swimlane-card--team" style={`--card-index: ${i + markerTasks.length}`}>
            <div class="swimlane-card-icon swimlane-card-icon--team">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 21v-1a6 6 0 0112 0v1"/>
              </svg>
            </div>
            <span class="swimlane-card-role">{task.role}</span>
            <span class="swimlane-card-label">{task.title}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Fade-out on right edge -->
  <div class="swimlane-fade" aria-hidden="true"></div>

  <!-- Stats bar -->
  <div class="mx-auto max-w-7xl px-8 mt-10">
    <div class="ink-reveal flex flex-wrap items-center gap-6" style="--reveal-delay: 250">
      <div class="swimlane-stat">
        <div class="swimlane-stat-dot swimlane-stat-dot--agent"></div>
        <span class="swimlane-stat-count">12</span>
        <span class="swimlane-stat-label">automated steps</span>
      </div>
      <div class="swimlane-stat">
        <div class="swimlane-stat-dot swimlane-stat-dot--team"></div>
        <span class="swimlane-stat-count">7</span>
        <span class="swimlane-stat-label">human decisions</span>
      </div>
      <div class="swimlane-stat-bar-wrap">
        <div class="swimlane-stat-bar">
          <div class="swimlane-stat-bar-fill" style="width: 63%"></div>
        </div>
        <span class="swimlane-stat-pct">63% automated</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Outer — no box, just stacked lanes */
  .swimlane-outer {
    display: flex;
    flex-direction: column;
    padding: 0 2rem;
  }

  /* Each lane */
  .swimlane-lane {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
  }
  .swimlane-lane--agent {
    border-bottom: 1px solid #E8DFD0;
  }

  /* Label */
  .swimlane-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    min-width: 100px;
  }

  .swimlane-label-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .swimlane-label-icon svg {
    width: 14px;
    height: 14px;
  }
  .swimlane-label-icon--agent {
    background: #E8F5EC;
    color: #3A7D56;
  }
  .swimlane-label-icon--team {
    background: #FBF5E6;
    color: #B8860B;
  }

  .swimlane-label-text {
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .swimlane-label-text--agent { color: #3A7D56; }
  .swimlane-label-text--team { color: #B8860B; }

  /* Track — horizontal, no wrap, no scroll */
  .swimlane-track {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
  }

  /* Cards */
  .swimlane-card {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 11px;
    line-height: 1.3;
    white-space: nowrap;
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(8px);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .swimlane-card:hover {
    transform: translateY(-2px) !important;
  }

  .swimlane-card--agent {
    background: #E8F5EC;
    border: 1.5px solid #A8D5BA;
    border-left: 3px solid #3A7D56;
  }
  .swimlane-card--agent:hover {
    box-shadow: 0 2px 8px rgba(58, 125, 86, 0.18);
  }

  .swimlane-card--team {
    background: #FFFBF5;
    border: 1px solid #E8DFD0;
  }
  .swimlane-card--team:hover {
    box-shadow: 0 2px 8px rgba(184, 134, 11, 0.12);
  }

  .swimlane-card-icon {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .swimlane-card-icon svg {
    width: 9px;
    height: 9px;
  }
  .swimlane-card-icon--agent {
    background: #3A7D56;
    color: #fff;
  }
  .swimlane-card-icon--team {
    background: #D4A574;
    color: #fff;
  }

  .swimlane-card-role {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #B8860B;
    flex-shrink: 0;
  }

  .swimlane-card-label {
    font-weight: 500;
    color: #2D2418;
  }

  /* Animated appearance */
  .swimlane-card.visible {
    opacity: 1;
    transform: translateX(0);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  /* Fade overlay on right edge */
  .swimlane-fade {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 120px;
    pointer-events: none;
    background: linear-gradient(to right, transparent, var(--color-background));
  }

  /* Stats */
  .swimlane-stat {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .swimlane-stat-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .swimlane-stat-dot--agent { background: #3A7D56; }
  .swimlane-stat-dot--team { background: #B8860B; }
  .swimlane-stat-count {
    font-size: 18px;
    font-weight: 600;
    color: #2D2418;
  }
  .swimlane-stat-label {
    font-size: 13px;
    color: #6B5638;
  }

  .swimlane-stat-bar-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .swimlane-stat-bar {
    width: 90px;
    height: 5px;
    border-radius: 3px;
    background: #E8DFD0;
    overflow: hidden;
  }
  .swimlane-stat-bar-fill {
    height: 100%;
    border-radius: 3px;
    background: #3A7D56;
    transition: width 1s ease-out 0.5s;
  }
  .swimlane-stat-pct {
    font-size: 12px;
    color: #6B5638;
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .swimlane-card {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Staggered reveal of swim lane cards on scroll
  const section = document.getElementById('swimlane-heading')?.closest('section');
  if (section) {
    const cards = section.querySelectorAll<HTMLElement>('.swimlane-card');

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          cards.forEach((card, i) => {
            const delay = i * 50 + 100;
            setTimeout(() => {
              card.classList.add('visible');
            }, delay);
          });
          observer.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    observer.observe(section);
  }
</script>
