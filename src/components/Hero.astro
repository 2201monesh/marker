---

---

<section class="relative overflow-hidden hero-bloom">
  <canvas
    id="hero-marker-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none"
    aria-hidden="true"
  ></canvas>
  <div class="relative z-10 mx-auto max-w-7xl px-8 py-28 md:py-36">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left column: text -->
      <div>
        <h1 id="hero-heading" class="text-5xl font-bold tracking-tight text-foreground leading-[1.1] md:text-6xl lg:text-7xl">
          Your always-on
          <br />
          <span data-marker-line>supply chain</span>
          <br />
          <span data-marker-line>coordinator</span>
        </h1>
        <p id="hero-subtext" class="mt-10 mb-2 text-lg text-muted-foreground md:text-xl leading-relaxed">
          Marker connects your systems and moves work forward automatically — so your team can focus on decisions, not follow-ups.
        </p>
        <div id="hero-cta" class="mt-10 flex flex-wrap items-center gap-6">
          <a
            href="https://info.onmarker.com/book-a-demo"
            class="btn-molding inline-flex h-11 items-center justify-center px-8 text-sm font-semibold tracking-wide text-primary transition-colors cursor-pointer"
          >
            Book a Demo
          </a>
        </div>

        <!-- Trust badges -->
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <span class="trust-badge">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            SOC 2 in progress
          </span>
          <span class="trust-badge">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            ISO 27001 in progress
          </span>
        </div>
      </div>

      <!-- Right column: Gantt chart snapshot — bleeds off right edge -->
      <div class="hero-gantt-wrap" aria-hidden="true">
        <div class="hero-gantt-frame">

          <!-- Window chrome dots -->
          <div class="gantt-chrome">
            <span class="gantt-dot" style="background:#E8DFD0"></span>
            <span class="gantt-dot" style="background:#E8DFD0"></span>
            <span class="gantt-dot" style="background:#E8DFD0"></span>
            <span class="gantt-chrome-title">SS26 wovens — sourcing calendar</span>
          </div>

          <!-- Board -->
          <div class="gantt-board">
            <!-- Phase header row -->
            <div class="gantt-phase-row">
              <div class="gantt-lane-hd"></div>
              <div class="gantt-phase-label" style="left:56px">Development</div>
              <div class="gantt-phase-label" style="left:calc(56px + 5 * var(--col-w))">Costing + spec</div>
            </div>

            <!-- Lane: PD -->
            <div class="gantt-lane">
              <div class="gantt-lane-hd"><span class="gantt-lane-name">PD</span></div>
              <div class="gantt-lane-track">
                <div class="gc gc-agent gc-done" style="--gc-col:0">
                  <div class="gc-icon gc-icon-agent"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="4" y="5" width="16" height="14" rx="3"/><rect x="7" y="9" width="3" height="2" rx="0.5" fill="#fff" stroke="none"/><rect x="14" y="9" width="3" height="2" rx="0.5" fill="#fff" stroke="none"/><path d="M9 14h6" stroke-linecap="round"/></svg></div>
                  <div class="gc-text"><span class="gc-who">Agent</span><span class="gc-name">Collect fabric data</span></div>
                  <div class="gc-check"><svg viewBox="0 0 24 24" fill="none" stroke="#3A7D56" stroke-width="3"><polyline points="5 12 10 17 19 7"/></svg></div>
                </div>
                <div class="gc gc-human gc-done" style="--gc-col:1">
                  <div class="gc-icon gc-icon-human"><svg viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0112 0v1"/></svg></div>
                  <div class="gc-text"><span class="gc-who">PD</span><span class="gc-name">Review fabric details</span></div>
                  <div class="gc-check"><svg viewBox="0 0 24 24" fill="none" stroke="#3A7D56" stroke-width="3"><polyline points="5 12 10 17 19 7"/></svg></div>
                </div>
                <div class="gc gc-human gc-done" style="--gc-col:2">
                  <div class="gc-icon gc-icon-human"><svg viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0112 0v1"/></svg></div>
                  <div class="gc-text"><span class="gc-who">PD</span><span class="gc-name">Collect trim details</span></div>
                  <div class="gc-check"><svg viewBox="0 0 24 24" fill="none" stroke="#3A7D56" stroke-width="3"><polyline points="5 12 10 17 19 7"/></svg></div>
                </div>
                <div class="gc gc-agent gc-active" style="--gc-col:6">
                  <div class="gc-icon gc-icon-agent"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="4" y="5" width="16" height="14" rx="3"/><rect x="7" y="9" width="3" height="2" rx="0.5" fill="#fff" stroke="none"/><rect x="14" y="9" width="3" height="2" rx="0.5" fill="#fff" stroke="none"/><path d="M9 14h6" stroke-linecap="round"/></svg></div>
                  <div class="gc-text"><span class="gc-who">Agent</span><span class="gc-name">Request vendor costing</span></div>
                </div>
              </div>
            </div>

            <!-- Lane: Design -->
            <div class="gantt-lane">
              <div class="gantt-lane-hd"><span class="gantt-lane-name">Design</span></div>
              <div class="gantt-lane-track">
                <div class="gc gc-human gc-done" style="--gc-col:1">
                  <div class="gc-icon gc-icon-human"><svg viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0112 0v1"/></svg></div>
                  <div class="gc-text"><span class="gc-who">Design</span><span class="gc-name">Design direction</span></div>
                  <div class="gc-check"><svg viewBox="0 0 24 24" fill="none" stroke="#3A7D56" stroke-width="3"><polyline points="5 12 10 17 19 7"/></svg></div>
                </div>
                <div class="gc gc-agent gc-done" style="--gc-col:3">
                  <div class="gc-icon gc-icon-agent"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="4" y="5" width="16" height="14" rx="3"/><rect x="7" y="9" width="3" height="2" rx="0.5" fill="#fff" stroke="none"/><rect x="14" y="9" width="3" height="2" rx="0.5" fill="#fff" stroke="none"/><path d="M9 14h6" stroke-linecap="round"/></svg></div>
                  <div class="gc-text"><span class="gc-who">Agent</span><span class="gc-name">Assign style numbers</span></div>
                  <div class="gc-check"><svg viewBox="0 0 24 24" fill="none" stroke="#3A7D56" stroke-width="3"><polyline points="5 12 10 17 19 7"/></svg></div>
                </div>
                <div class="gc gc-human gc-done" style="--gc-col:4">
                  <div class="gc-icon gc-icon-human"><svg viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0112 0v1"/></svg></div>
                  <div class="gc-text"><span class="gc-who">Design</span><span class="gc-name">Front + back sketches</span></div>
                  <div class="gc-check"><svg viewBox="0 0 24 24" fill="none" stroke="#3A7D56" stroke-width="3"><polyline points="5 12 10 17 19 7"/></svg></div>
                </div>
                <div class="gc gc-human gc-pending" style="--gc-col:5">
                  <div class="gc-icon gc-icon-human"><svg viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0112 0v1"/></svg></div>
                  <div class="gc-text"><span class="gc-who">Design</span><span class="gc-name">Build bill of materials</span></div>
                </div>
              </div>
            </div>

            <!-- Lane: TD -->
            <div class="gantt-lane">
              <div class="gantt-lane-hd"><span class="gantt-lane-name">TD</span></div>
              <div class="gantt-lane-track">
                <div class="gc gc-agent gc-done" style="--gc-col:4">
                  <div class="gc-icon gc-icon-agent"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="4" y="5" width="16" height="14" rx="3"/><rect x="7" y="9" width="3" height="2" rx="0.5" fill="#fff" stroke="none"/><rect x="14" y="9" width="3" height="2" rx="0.5" fill="#fff" stroke="none"/><path d="M9 14h6" stroke-linecap="round"/></svg></div>
                  <div class="gc-text"><span class="gc-who">Agent</span><span class="gc-name">Load spec templates</span></div>
                  <div class="gc-check"><svg viewBox="0 0 24 24" fill="none" stroke="#3A7D56" stroke-width="3"><polyline points="5 12 10 17 19 7"/></svg></div>
                </div>
                <div class="gc gc-human gc-pending" style="--gc-col:5">
                  <div class="gc-icon gc-icon-human"><svg viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0112 0v1"/></svg></div>
                  <div class="gc-text"><span class="gc-who">TD</span><span class="gc-name">Build initial spec pkg</span></div>
                </div>
              </div>
            </div>

            <!-- Lane: Merch -->
            <div class="gantt-lane">
              <div class="gantt-lane-hd"><span class="gantt-lane-name">Merch</span></div>
              <div class="gantt-lane-track">
                <div class="gc gc-human gc-waiting" style="--gc-col:5">
                  <div class="gc-icon gc-icon-human"><svg viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0112 0v1"/></svg></div>
                  <div class="gc-text"><span class="gc-who">Merch</span><span class="gc-name">Seasonal buy plan</span></div>
                </div>
              </div>
            </div>

            <!-- Lane: Prod -->
            <div class="gantt-lane">
              <div class="gantt-lane-hd"><span class="gantt-lane-name">Prod</span></div>
              <div class="gantt-lane-track">
                <!-- empty at this stage -->
              </div>
            </div>

            <!-- Now-cursor -->
            <div class="gantt-cursor"></div>
          </div>

          <!-- Activity log feed -->
          <div class="hero-feed">
            <div class="hero-feed-title">Activity log</div>
            <div class="hero-fi">
              <div class="hero-fic hero-fic-agent">
                <svg viewBox="0 0 24 24" fill="none" stroke="#3A7D56" stroke-width="2"><rect x="4" y="5" width="16" height="14" rx="3"/><rect x="7" y="9" width="3" height="2" rx="0.5" fill="#3A7D56" stroke="none"/><rect x="14" y="9" width="3" height="2" rx="0.5" fill="#3A7D56" stroke="none"/><path d="M9 14h6" stroke-linecap="round"/></svg>
              </div>
              <span>Agent updated spec package templates</span>
            </div>

            <div class="hero-fi">
              <div class="hero-fic hero-fic-agent">
                <svg viewBox="0 0 24 24" fill="none" stroke="#3A7D56" stroke-width="2"><rect x="4" y="5" width="16" height="14" rx="3"/><rect x="7" y="9" width="3" height="2" rx="0.5" fill="#3A7D56" stroke="none"/><rect x="14" y="9" width="3" height="2" rx="0.5" fill="#3A7D56" stroke="none"/><path d="M9 14h6" stroke-linecap="round"/></svg>
              </div>
              <span>Agent requested costing from 3 vendors</span>
            </div>

            <div class="hero-fi">
              <div class="hero-fic hero-fic-human">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0112 0v1"/></svg>
              </div>
              <span>Sarah merged seasonal buy plan</span>
            </div>

            <div class="hero-fi hero-fi-fade">
              <div class="hero-fic hero-fic-agent">
                <svg viewBox="0 0 24 24" fill="none" stroke="#3A7D56" stroke-width="2"><rect x="4" y="5" width="16" height="14" rx="3"/><rect x="7" y="9" width="3" height="2" rx="0.5" fill="#3A7D56" stroke="none"/><rect x="14" y="9" width="3" height="2" rx="0.5" fill="#3A7D56" stroke="none"/><path d="M9 14h6" stroke-linecap="round"/></svg>
              </div>
              <span>Collected data sheets from 8 mills</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Trust badges */
  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-foreground, #7D6B4F);
    opacity: 0.7;
  }

  /* ── Gantt snapshot ── */
  .hero-gantt-wrap {
    opacity: 0;
    animation: gantt-fade-in 0.8s ease-out 0.15s forwards;
    overflow: hidden;
    filter: drop-shadow(0 12px 40px rgba(45, 36, 24, 0.25));
    /* Fixed width clips at ~75% of blinking card; JS pushes right edge to viewport edge */
    max-width: 596px;
    position: relative;
  }

  @keyframes gantt-fade-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-gantt-frame {
    background: #FAF6F0;
    border: 1px solid #E8DFD0;
    border-radius: 12px 0 0 12px;
    border-right: none;
    overflow: hidden;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  /* Chrome bar */
  .gantt-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: #F5EDE0;
    border-bottom: 1px solid #E8DFD0;
  }
  .gantt-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .gantt-chrome-title {
    margin-left: 8px;
    font-size: 10px;
    font-weight: 600;
    color: #7D6B4F;
  }

  /* Metrics */
  .gantt-metrics {
    display: flex;
    gap: 8px;
    padding: 8px 12px;
    border-bottom: 1px solid #E8DFD0;
  }
  .gantt-met {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    background: #F5EDE0;
  }
  .gantt-met-n {
    font-size: 16px;
    font-weight: 500;
    min-width: 16px;
  }
  .gantt-met-l {
    font-size: 9px;
    color: #7D6B4F;
    line-height: 1.3;
  }

  /* Board */
  .gantt-board {
    --col-w: 80px;
    position: relative;
    overflow: hidden;
    min-width: 0;
  }

  /* Phase header */
  .gantt-phase-row {
    display: flex;
    height: 22px;
    border-bottom: 1px solid #E8DFD0;
    background: #F5EDE0;
    position: relative;
  }
  .gantt-lane-hd {
    width: 56px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid #E8DFD0;
    background: #F5EDE0;
  }
  .gantt-phase-label {
    position: absolute;
    top: 0;
    height: 100%;
    display: flex;
    align-items: center;
    padding-left: 6px;
    font-size: 9px;
    font-weight: 500;
    color: #7D6B4F;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .gantt-phase-label:not(:first-of-type) {
    border-left: 1px dashed #E8DFD080;
    padding-left: 6px;
  }

  .gantt-lane-name {
    font-size: 10px;
    font-weight: 500;
    color: #2D2418;
  }

  /* Lanes */
  .gantt-lane {
    display: flex;
    min-height: 56px;
    border-bottom: 1px solid #E8DFD0;
  }
  .gantt-lane:last-of-type {
    border-bottom: none;
  }
  .gantt-lane-track {
    flex: 1;
    position: relative;
    min-height: 56px;
    min-width: calc(8 * var(--col-w));
  }

  /* Gantt cards */
  .gc {
    position: absolute;
    left: calc(var(--gc-col) * var(--col-w) + 4px);
    top: 4px;
    width: calc(var(--col-w) - 6px);
    height: calc(100% - 8px);
    border-radius: 6px;
    padding: 4px 6px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-size: 9px;
    transition: opacity 0.4s, box-shadow 0.4s;
    overflow: hidden;
  }

  .gc-human {
    background: #FFFBF5;
    border: 1px solid #E8DFD0;
  }
  .gc-agent {
    background: #E8F5EC;
    border: 1.5px solid #A8D5BA;
    border-left: 3px solid #3A7D56;
  }

  .gc-done.gc-human {
    background: #F5EDE0;
  }
  .gc-done.gc-agent {
    background: #E8F5EC;
  }

  .gc-active {
    animation: gantt-pulse-green 1.5s ease-in-out infinite;
  }
  @keyframes gantt-pulse-green {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 0 3px rgba(58,125,86,0.2); }
  }

  .gc-pending {
    border-color: #B8860B40;
    opacity: 0.7;
  }
  .gc-waiting {
    opacity: 0.25;
  }

  .gc-icon {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .gc-icon svg {
    width: 10px;
    height: 10px;
  }
  .gc-icon-agent {
    background: #3A7D56;
  }
  .gc-icon-human {
    background: #D4A574;
  }

  .gc-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .gc-who {
    font-size: 7px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    color: #7D6B4F;
  }
  .gc-agent .gc-who {
    color: #3A7D56;
  }
  .gc-name {
    font-size: 8px;
    font-weight: 500;
    color: #2D2418;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gc-check {
    position: absolute;
    top: 2px;
    right: 3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #E8F5EC;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gc-check svg {
    width: 8px;
    height: 8px;
  }

  /* Now cursor */
  .gantt-cursor {
    position: absolute;
    top: 22px;
    bottom: 0;
    left: calc(56px + 5.8 * var(--col-w));
    width: 2px;
    background: #3A7D56;
    opacity: 0.35;
    border-radius: 1px;
    pointer-events: none;
  }

  /* Bottom stat */
  .gantt-stat {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-top: 1px solid #E8DFD0;
    font-size: 10px;
    color: #7D6B4F;
  }
  .gantt-stat-bar {
    width: 60px;
    height: 4px;
    border-radius: 2px;
    background: #E8DFD0;
    overflow: hidden;
  }
  .gantt-stat-fill {
    height: 100%;
    border-radius: 2px;
    background: #3A7D56;
  }

  /* ── Activity log feed ── */
  .hero-feed {
    padding: 8px 12px 0;
    border-top: 1px solid #E8DFD0;
    max-height: 120px;
    overflow: hidden;
  }
  .hero-feed-title {
    font-size: 9px;
    font-weight: 500;
    color: #7D6B4F;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    margin-bottom: 2px;
  }

  .hero-fi {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 5px 0;
    font-size: 11px;
    color: #5A4D42;
    line-height: 1.3;
  }
  .hero-fi-fade {
    opacity: 0.25;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.4), transparent);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.4), transparent);
  }

  .hero-fic {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .hero-fic svg {
    width: 10px;
    height: 10px;
  }
  .hero-fic-agent {
    background: #E8F5EC;
  }
  .hero-fic-human {
    background: #D4A574;
  }


  /* Mobile: stack and show gantt below, still bleeds right */
  @media (max-width: 767px) {
    .hero-gantt-wrap {
      margin-top: 2rem;
      margin-right: -2rem;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-gantt-wrap {
      opacity: 1;
      animation: none;
    }
    .gc-active {
      animation: none;
    }
  }
</style>

<script>
  import { drawCleanUnderline } from '../lib/marker-background.js';

  const HIGHLIGHT_COLOR = '#3A7D56';

  function getStrokeParams(section: HTMLElement) {
    const sectionRect = section.getBoundingClientRect();
    const lines = section.querySelectorAll('[data-marker-line]');
    if (!lines.length) return [];

    const angleRad = -0.3 * (Math.PI / 180);

    return Array.from(lines).map((line) => {
      const rect = line.getBoundingClientRect();
      const thickness = 14;
      const cy = rect.bottom - sectionRect.top + 2;
      const sx = rect.left - sectionRect.left - 8;
      const ex = rect.right - sectionRect.left + 8;
      const strokeLen = ex - sx;
      const rise = Math.sin(angleRad) * strokeLen * 0.5;

      return {
        sx,
        sy: cy - rise,
        ex,
        ey: cy + rise,
        color: HIGHLIGHT_COLOR,
        thickness,
        opacity: 1,
      };
    });
  }

  // Instant render (used on resize and when motion is reduced)
  function renderFull() {
    const canvas = document.getElementById('hero-marker-canvas') as HTMLCanvasElement;
    const section = canvas?.closest('section');
    if (!canvas || !section) return;

    const dpr = window.devicePixelRatio || 1;
    const W = section.clientWidth;
    const H = section.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    getStrokeParams(section).forEach(p => drawCleanUnderline(ctx, p));
  }

  // Animated draw-in: strokes reveal left-to-right like a hand drawing them
  function renderAnimated() {
    const canvas = document.getElementById('hero-marker-canvas') as HTMLCanvasElement;
    const section = canvas?.closest('section');
    if (!canvas || !section) return;

    const dpr = window.devicePixelRatio || 1;
    const W = section.clientWidth;
    const H = section.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const params = getStrokeParams(section);

    // Render each stroke to its own offscreen canvas (prevents vertical overlap bleed)
    const offscreens = params.map(p => {
      const off = document.createElement('canvas');
      off.width = canvas.width;
      off.height = canvas.height;
      const octx = off.getContext('2d')!;
      octx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawCleanUnderline(octx, p);
      return off;
    });

    const DURATION = 650;
    const GAP = 80; // brief pause between strokes, like lifting and repositioning
    const INITIAL_DELAY = 1000; // wait for Gantt fade-in to finish first
    const startTime = performance.now() + INITIAL_DELAY;

    function ease(t: number) {
      return t < 0.15
        ? t * t / 0.15
        : 1 - Math.pow(1 - t, 2.5);
    }

    function animate(now: number) {
      ctx.clearRect(0, 0, W, H);
      let allDone = true;

      params.forEach((p, i) => {
        const elapsed = now - startTime - i * (DURATION + GAP);
        if (elapsed <= 0) { allDone = false; return; }
        const t = Math.min(1, elapsed / DURATION);
        if (t < 1) allDone = false;
        const eased = ease(t);

        const revealWidth = (p.ex - p.sx) * eased;
        if (revealWidth <= 0) return;

        // Horizontal clip — each stroke is on its own canvas, no vertical bleed
        ctx.save();
        ctx.beginPath();
        ctx.rect(p.sx - 2, 0, revealWidth + 4, H);
        ctx.clip();
        ctx.drawImage(offscreens[i], 0, 0, offscreens[i].width, offscreens[i].height, 0, 0, W, H);
        ctx.restore();
      });

      if (!allDone) {
        requestAnimationFrame(animate);
      }
    }

    requestAnimationFrame(animate);
  }

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    renderFull();
  } else {
    renderAnimated();
  }
  window.addEventListener('resize', renderFull);

  // ── Gantt right-edge clipping ──
  // The wrap bleeds to the viewport edge via negative margin-right.
  // We want the card content to clip ~75% through the blinking card (col 6),
  // while the frame background fills the remaining space to the viewport edge.
  // CSS alone can't do this because the frame only sizes to its content.
  // So we use JS to stretch the frame to fill the wrap and clip the board.
  function clipGantt() {
    const wrap = document.querySelector('.hero-gantt-wrap') as HTMLElement;
    if (!wrap) return;
    // Reset to measure natural position
    wrap.style.left = '0px';
    const rect = wrap.getBoundingClientRect();
    // Shift wrap right so its right edge is flush with the viewport right edge
    const shift = window.innerWidth - rect.right;
    wrap.style.left = shift + 'px';
  }
  clipGantt();
  window.addEventListener('resize', clipGantt);
</script>
