---

---

<section class="relative overflow-visible hero-bloom">
  <canvas
    id="hero-marker-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none"
    aria-hidden="true"
  ></canvas>
  <div class="relative z-10 mx-auto max-w-7xl px-8 py-32 md:py-44">
    <div class="max-w-3xl">
      <h1 id="hero-heading" class="text-5xl font-bold tracking-tight text-foreground leading-[1.1] md:text-6xl lg:text-7xl">
        <span data-marker-line>Your always-on</span>
        <br />
        <span class="text-accent-light"><span data-marker-line>supply chain</span>
        <br />
        <span data-marker-line>coordinator</span></span>
      </h1>
      <p class="mt-8 text-lg text-muted-foreground md:text-xl leading-relaxed">
        Marker is an AI-powered orchestrator that keeps things moving before
        you have to. It syncs data across your systems, tracks handoffs and
        deadlines, and moves work forward autonomously.
      </p>
      <div class="mt-12">
        <a
          href="https://info.onmarker.com/book-a-demo"
          class="btn-circled relative inline-flex items-center px-10 py-3 text-lg font-bold text-primary transition-colors hover:text-primary/80 cursor-pointer"
        >
          <svg class="absolute inset-[-5px] w-[calc(100%+10px)] h-[calc(100%+10px)]" viewBox="0 0 200 56" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Faint fill so the button lifts off any background -->
            <path d="M 4,3.5 L 196.5,3 L 197,52.5 L 3.5,53 Z" fill="white" opacity="0.45" />
            <!-- Primary rectangle — very slight imperfections in the corners -->
            <path d="M 4,3.5 L 196.5,3 L 197,52.5 L 3.5,53 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" opacity="0.55" />
            <!-- Second pass — barely offset, confident redraw -->
            <path d="M 3.5,4 L 196,3.5 L 196.5,52 L 4,52.5 Z" stroke="currentColor" stroke-width="0.8" stroke-linejoin="round" opacity="0.22" />
          </svg>
          <span class="relative z-10">Book a Demo</span>
        </a>
      </div>
    </div>
  </div>

</section>

<script>
  import { drawHighlightStroke } from '../lib/marker-background.js';

  const COLORS = ['#e8dcc8', '#dfd3bc', '#ede2d0'];

  // Each stroke: y position, angle, thickness, x start/end (% of width)
  const STROKES = [
    { yPct: 0.18, angle: -1.8, thickPct: 0.30, x0: -0.05, x1: 1.05 },
    { yPct: 0.48, angle:  1.3, thickPct: 0.32, x0: -0.05, x1: 1.05 },
    { yPct: 0.78, angle: -0.8, thickPct: 0.30, x0: -0.05, x1: 1.05 },
  ];

  function render() {
    const canvas = document.getElementById('hero-marker-canvas') as HTMLCanvasElement;
    const section = canvas?.closest('section');
    if (!canvas || !section) return;

    const dpr = window.devicePixelRatio || 1;
    const W = section.clientWidth;
    const H = section.clientHeight;

    canvas.width = W * dpr;
    canvas.height = H * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    STROKES.forEach((s, i) => {
      const cy = H * s.yPct;
      const angleRad = s.angle * (Math.PI / 180);
      const sx = W * s.x0;
      const ex = W * s.x1;
      const strokeLen = ex - sx;
      const rise = Math.sin(angleRad) * strokeLen * 0.5;

      drawHighlightStroke(ctx, {
        sx,
        sy: cy - rise,
        ex,
        ey: cy + rise,
        color: COLORS[i % COLORS.length],
        thickness: H * s.thickPct,
        opacity: 0.13,
      });
    });
  }

  render();
  window.addEventListener('resize', render);
</script>
