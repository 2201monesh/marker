---

<section class="relative overflow-visible hero-bloom">
  <canvas
    id="hero-marker-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none"
    aria-hidden="true"
  ></canvas>
  <div class="relative z-10 mx-auto max-w-7xl px-8 py-28 md:py-36">
    <div class="max-w-4xl">
      <h1 id="hero-heading" class="text-5xl font-bold tracking-tight text-foreground leading-[1.1] md:text-6xl lg:text-7xl">
        <span data-marker-line>Your always-on</span>
        <br />
        <span class="text-primary"><span data-marker-line>supply chain coordinator</span></span>
      </h1>
      <p class="mt-8 text-lg text-muted-foreground md:text-xl leading-relaxed">
        Marker is an AI-powered orchestrator that keeps things moving before
        you have to. It syncs data across your systems, tracks handoffs and
        deadlines, and moves work forward autonomously.
      </p>
      <div class="mt-12 flex flex-wrap items-center gap-6">
        <a
          href="https://info.onmarker.com/book-a-demo"
          class="btn-molding btn-molding-flip inline-flex h-12 items-center justify-center px-10 text-sm font-extrabold uppercase tracking-[0.08em] text-primary transition-colors hover:text-primary/80 cursor-pointer"
        >
          Book a Demo
        </a>
      </div>
    </div>
  </div>

</section>

<script>
  import { drawHighlightStroke } from '../lib/marker-background.js';

  const COLORS = ['#e8d4b8', '#dfc8a8', '#edd5b5'];

  const STROKES = [
    { yPct: 0.20, angle: -0.5, thickPct: 0.30, x0: -0.05, x1: 0.68 },
    { yPct: 0.48, angle:  1.3, thickPct: 0.38, x0: -0.05, x1: 0.72 },
    { yPct: 0.78, angle: -0.8, thickPct: 0.30, x0: -0.05, x1: 0.65 },
  ];

  function getStrokeParams(W: number, H: number) {
    return STROKES.map((s, i) => {
      const cy = H * s.yPct;
      const angleRad = s.angle * (Math.PI / 180);
      const sx = W * s.x0;
      const ex = W * s.x1;
      const strokeLen = ex - sx;
      const rise = Math.sin(angleRad) * strokeLen * 0.5;
      return {
        sx, sy: cy - rise, ex, ey: cy + rise,
        color: COLORS[i % COLORS.length],
        thickness: H * s.thickPct,
        opacity: 0.17,
        cy, halfClip: H * s.thickPct * 0.8,
      };
    });
  }

  // Instant render (used on resize and when motion is reduced)
  function renderFull() {
    const canvas = document.getElementById('hero-marker-canvas') as HTMLCanvasElement;
    const section = canvas?.closest('section');
    if (!canvas || !section) return;

    const dpr = window.devicePixelRatio || 1;
    const W = section.clientWidth;
    const H = section.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    getStrokeParams(W, H).forEach(p => drawHighlightStroke(ctx, p));
  }

  // Animated draw-in: strokes reveal left-to-right like a hand drawing them
  function renderAnimated() {
    const canvas = document.getElementById('hero-marker-canvas') as HTMLCanvasElement;
    const section = canvas?.closest('section');
    if (!canvas || !section) return;

    const dpr = window.devicePixelRatio || 1;
    const W = section.clientWidth;
    const H = section.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const params = getStrokeParams(W, H);

    // Render each stroke to its own offscreen canvas (prevents vertical overlap bleed)
    const offscreens = params.map(p => {
      const off = document.createElement('canvas');
      off.width = canvas.width;
      off.height = canvas.height;
      const octx = off.getContext('2d')!;
      octx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawHighlightStroke(octx, p);
      return off;
    });

    const DURATION = 650;
    const STAGGER = 600;
    const INITIAL_DELAY = 150;
    const startTime = performance.now() + INITIAL_DELAY;

    function ease(t: number) {
      return t < 0.15
        ? t * t / 0.15
        : 1 - Math.pow(1 - t, 2.5);
    }

    function animate(now: number) {
      ctx.clearRect(0, 0, W, H);
      let allDone = true;

      params.forEach((p, i) => {
        const elapsed = now - startTime - i * STAGGER;
        if (elapsed <= 0) { allDone = false; return; }
        const t = Math.min(1, elapsed / DURATION);
        if (t < 1) allDone = false;
        const eased = ease(t);

        const revealWidth = (p.ex - p.sx) * eased;
        if (revealWidth <= 0) return;

        // Horizontal clip — each stroke is on its own canvas, no vertical bleed
        ctx.save();
        ctx.beginPath();
        ctx.rect(p.sx - 2, 0, revealWidth + 4, H);
        ctx.clip();
        ctx.drawImage(offscreens[i], 0, 0, offscreens[i].width, offscreens[i].height, 0, 0, W, H);
        ctx.restore();
      });

      if (!allDone) {
        requestAnimationFrame(animate);
      }
    }

    requestAnimationFrame(animate);
  }

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    renderFull();
  } else {
    renderAnimated();
  }
  window.addEventListener('resize', renderFull);
</script>
