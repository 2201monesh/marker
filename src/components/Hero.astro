---

---

<section class="relative overflow-visible hero-bloom">
  <canvas
    id="hero-marker-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none"
    aria-hidden="true"
  ></canvas>
  <div class="relative z-10 mx-auto max-w-7xl px-8 py-32 md:py-44">
    <div class="max-w-3xl">
      <h1 id="hero-heading" class="text-5xl font-bold tracking-tight text-foreground leading-[1.1] md:text-6xl lg:text-7xl">
        <span data-marker-line>Your always-on</span>
        <br />
        <span class="text-primary"><span data-marker-line>supply chain</span>
        <br />
        <span data-marker-line>coordinator</span></span>
      </h1>
      <p class="mt-8 text-lg text-muted-foreground md:text-xl leading-relaxed">
        Marker is an AI-powered orchestrator that keeps things moving before
        you have to. It syncs data across your systems, tracks handoffs and
        deadlines, and moves work forward autonomously.
      </p>
      <div class="mt-12 flex flex-wrap items-center gap-6">
        <!-- Molding border — normal variant -->
        <a
          href="https://info.onmarker.com/book-a-demo"
          class="btn-molding inline-flex h-12 items-center justify-center px-10 text-sm font-semibold uppercase tracking-[0.08em] text-primary transition-colors hover:text-primary/80 cursor-pointer"
        >
          Book a Demo
        </a>
        <!-- Molding border — flipped variant -->
        <a
          href="https://info.onmarker.com/book-a-demo"
          class="btn-molding btn-molding-flip inline-flex h-12 items-center justify-center px-10 text-sm font-semibold uppercase tracking-[0.08em] text-primary transition-colors hover:text-primary/80 cursor-pointer"
        >
          Book a Demo
        </a>
      </div>
    </div>
  </div>

</section>

<script>
  import { drawHighlightStroke } from '../lib/marker-background.js';

  const COLORS = ['#e8dcc8', '#dfd3bc', '#ede2d0'];

  // Each stroke: y position, angle, thickness, x start/end (% of width)
  const STROKES = [
    { yPct: 0.20, angle: -0.5, thickPct: 0.30, x0: -0.05, x1: 0.68 },
    { yPct: 0.48, angle:  1.3, thickPct: 0.32, x0: -0.05, x1: 0.72 },
    { yPct: 0.78, angle: -0.8, thickPct: 0.30, x0: -0.05, x1: 0.65 },
  ];

  function render() {
    const canvas = document.getElementById('hero-marker-canvas') as HTMLCanvasElement;
    const section = canvas?.closest('section');
    const heading = document.getElementById('hero-heading');
    if (!canvas || !section || !heading) return;

    const dpr = window.devicePixelRatio || 1;
    const W = section.clientWidth;
    const H = section.clientHeight;
    const sectionTop = section.getBoundingClientRect().top;
    const headingRect = heading.getBoundingClientRect();

    // Center of the heading relative to the section
    const headingCenterY = (headingRect.top + headingRect.height / 2) - sectionTop;

    canvas.width = W * dpr;
    canvas.height = H * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    // Space strokes evenly: one above heading, one on heading, one below
    const spacing = H * 0.28;
    const positions = [
      headingCenterY - spacing,
      headingCenterY,
      headingCenterY + spacing,
    ];

    STROKES.forEach((s, i) => {
      const cy = positions[i];
      const angleRad = s.angle * (Math.PI / 180);
      const sx = W * s.x0;
      const ex = W * s.x1;
      const strokeLen = ex - sx;
      const rise = Math.sin(angleRad) * strokeLen * 0.5;

      drawHighlightStroke(ctx, {
        sx,
        sy: cy - rise,
        ex,
        ey: cy + rise,
        color: COLORS[i % COLORS.length],
        thickness: H * s.thickPct,
        opacity: 0.13,
      });
    });
  }

  render();
  window.addEventListener('resize', render);
</script>
