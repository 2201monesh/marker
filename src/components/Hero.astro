---

---

<section class="relative overflow-hidden hero-bloom">
  <canvas
    id="hero-marker-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none"
    aria-hidden="true"
  ></canvas>
  <div class="relative z-10 mx-auto max-w-7xl px-8 py-28 md:py-36">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left column: text -->
      <div>
        <h1 id="hero-heading" class="text-5xl font-bold tracking-tight text-foreground leading-[1.1] md:text-6xl lg:text-7xl">
          Sourcing
          <br />
          <span data-marker-line>lives in email.</span>
        </h1>
        <p id="hero-subtext" class="mt-10 mb-2 text-lg text-muted-foreground md:text-xl leading-relaxed">
          Half your team's week disappears in there. So do the answers about your seasons, your vendors, your team.
        </p>
        <div id="hero-cta" class="mt-10 flex flex-wrap items-center gap-6">
          <a
            href="https://info.onmarker.com/book-a-demo"
            class="btn-molding inline-flex h-11 items-center justify-center px-8 text-sm font-semibold tracking-wide text-primary transition-colors cursor-pointer"
          >
            Book a Demo
          </a>
        </div>

        <!-- Trust badges -->
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <span class="trust-badge">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            SOC 2 in progress
          </span>
          <span class="trust-badge">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            ISO 27001 in progress
          </span>
        </div>
      </div>

      <!-- Right column: faux inbox snapshot — bleeds off right edge -->
      <div class="hero-inbox-wrap" role="img" aria-label="Decorative sourcing inbox illustration with Marker annotations">
        <div class="hero-inbox-frame" aria-hidden="true">

          <!-- Window chrome -->
          <div class="inbox-chrome">
            <div class="chrome-dots">
              <span class="chrome-dot"></span>
              <span class="chrome-dot"></span>
              <span class="chrome-dot"></span>
            </div>
            <span class="chrome-title">Sourcing inbox</span>
            <span class="chrome-divider">/</span>
            <span class="chrome-sub">SS26 wovens</span>
            <span class="chrome-spacer"></span>
            <span class="chrome-count">87 threads</span>
          </div>

          <!-- Filter rail -->
          <div class="inbox-filters">
            <span class="filter-pill is-active">All <em>87</em></span>
            <span class="filter-pill is-marker">
              <svg viewBox="0 0 20 20" class="filter-icon" aria-hidden="true">
                <path d="M 13 3 L 17 7 L 7 17 L 3 13 Z" fill="currentColor"/>
                <path d="M 13 3 L 17 7 L 15 9 L 11 5 Z" fill="currentColor" opacity="0.55"/>
              </svg>
              Marker handling <em>54</em>
            </span>
            <span class="filter-pill">Needs you <em>13</em></span>
            <span class="filter-pill">Snoozed <em>20</em></span>
          </div>

          <!-- Thread list -->
          <ul class="inbox-list">

            <!-- 1. Atelier Verde — extracted: FOB underline + AUC chip -->
            <li class="thread thread-extracted" style="--thread-i:0">
              <span class="thread-avatar" style="--av:#7E8B6F">AV</span>
              <div class="thread-body">
                <div class="thread-row1">
                  <span class="thread-from">Maria Lopes <em>· Atelier Verde</em></span>
                  <span class="thread-time">9:42</span>
                </div>
                <div class="thread-row2">
                  <span class="thread-subj">Updated quote — linen blend, SS26-W-014</span>
                  <span class="thread-snip"> — Per our call, revised to <span class="anno-mark anno-mark-fob"><span class="anno-target">FOB&nbsp;$14.20</span><svg class="anno-svg anno-svg-underline" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d="M 5 9 L 11 1 Q 100 0, 195 3 L 199 11 Q 100 13, 5 9 Z" fill="currentColor"/></svg></span> on 1200 yds…</span>
                </div>
              </div>
              <div class="thread-marks">
                <span class="anno-chip anno-chip-warn" style="--chip-delay:1850ms">
                  <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M 6 1 L 11 10 L 1 10 Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M 6 5 L 6 7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="6" cy="9" r="0.7" fill="currentColor"/></svg>
                  +9% over target AUC
                </span>
              </div>
            </li>

            <!-- 2. Suzhou Lin — handled -->
            <li class="thread thread-handled" style="--thread-i:1">
              <span class="thread-avatar" style="--av:#A87C5D">SL</span>
              <div class="thread-body">
                <div class="thread-row1">
                  <span class="thread-from">Daniel Wu <em>· Suzhou Lin Mills</em></span>
                  <span class="thread-time">9:14</span>
                </div>
                <div class="thread-row2">
                  <span class="thread-subj">Re: SS26 oxford — bulk production schedule</span>
                  <span class="thread-snip"> — Confirming we can hit the 6/15 ship date if PO lands by EOW…</span>
                </div>
              </div>
              <div class="thread-marks">
                <span class="mark-handled" style="--mark-delay:1700ms">
                  <span class="mark-handled-tick" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><polyline points="5 12 10 17 19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  Marker drafted reply
                </span>
              </div>
            </li>

            <!-- 3. Hangzhou Silk — extracted: "14d slip" circled + chip -->
            <li class="thread thread-extracted" style="--thread-i:2">
              <span class="thread-avatar" style="--av:#9E6E5C">HS</span>
              <div class="thread-body">
                <div class="thread-row1">
                  <span class="thread-from">Lin Zhao <em>· Hangzhou Silk Co.</em></span>
                  <span class="thread-time">8:58</span>
                </div>
                <div class="thread-row2">
                  <span class="thread-subj">Sample 3 <span class="anno-mark anno-mark-slip"><span class="anno-target">delayed&nbsp;14d</span><svg class="anno-svg anno-svg-circle" viewBox="0 0 200 36" preserveAspectRatio="none" aria-hidden="true"><path d="M 18 14 Q 5 22, 36 30 Q 100 36, 168 28 Q 195 22, 165 12 Q 100 2, 18 14 Z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span> — SS26-W-009 now 6/30</span>
                  <span class="thread-snip"> — Logistics issue at Ningbo, full tracking attached…</span>
                </div>
              </div>
              <div class="thread-marks">
                <span class="anno-chip anno-chip-alert" style="--chip-delay:2100ms">
                  <svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M 6 4 L 6 6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="6" cy="8" r="0.7" fill="currentColor"/></svg>
                  3rd slip this season
                </span>
              </div>
            </li>

            <!-- 4. Anastasia Kim — active (Marker working) -->
            <li class="thread thread-active" style="--thread-i:3">
              <span class="thread-avatar" style="--av:#8B7558">AK</span>
              <div class="thread-body">
                <div class="thread-row1">
                  <span class="thread-from">Anastasia Kim <em>· PD, internal</em></span>
                  <span class="thread-time">8:41</span>
                </div>
                <div class="thread-row2">
                  <span class="thread-subj">Q on bulk approval — ribbed crewneck</span>
                  <span class="thread-snip"> — Need confirmation on the trim swap before I send back…</span>
                </div>
              </div>
              <div class="thread-marks">
                <span class="mark-handled mark-active">
                  <span class="mark-active-pulse" aria-hidden="true">
                    <span></span><span></span><span></span>
                  </span>
                  Marker composing reply
                </span>
              </div>
            </li>

            <!-- 5. Bharat Textiles — extracted: MOQ underline + chip -->
            <li class="thread thread-extracted" style="--thread-i:4">
              <span class="thread-avatar" style="--av:#A07246">BT</span>
              <div class="thread-body">
                <div class="thread-row1">
                  <span class="thread-from">Rajiv Mehta <em>· Bharat Textiles</em></span>
                  <span class="thread-time">8:22</span>
                </div>
                <div class="thread-row2">
                  <span class="thread-subj">Counter offer: <span class="anno-mark anno-mark-moq"><span class="anno-target">1500 MOQ</span><svg class="anno-svg anno-svg-underline" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d="M 5 9 L 11 1 Q 100 0, 195 3 L 199 11 Q 100 13, 5 9 Z" fill="currentColor"/></svg></span> at $11.80</span>
                  <span class="thread-snip"> — As discussed, lower MOQ available if FOB +$0.40…</span>
                </div>
              </div>
              <div class="thread-marks">
                <span class="anno-chip anno-chip-good" style="--chip-delay:2350ms">
                  <svg viewBox="0 0 12 12" aria-hidden="true"><polyline points="2 7 5 10 10 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  MOQ −40% vs current
                </span>
              </div>
            </li>

            <!-- 6. Carla Restrepo — handled -->
            <li class="thread thread-handled" style="--thread-i:5">
              <span class="thread-avatar" style="--av:#8B7558">CR</span>
              <div class="thread-body">
                <div class="thread-row1">
                  <span class="thread-from">Carla Restrepo <em>· TD, internal</em></span>
                  <span class="thread-time">7:55</span>
                </div>
                <div class="thread-row2">
                  <span class="thread-subj">Tech pack v2 — SS26-W-004</span>
                  <span class="thread-snip"> — Updated POMs based on fit comments, sleeve length tweaked…</span>
                </div>
              </div>
              <div class="thread-marks">
                <span class="mark-handled" style="--mark-delay:2500ms">
                  <span class="mark-handled-tick" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><polyline points="5 12 10 17 19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  Marker filed in PLM
                </span>
              </div>
            </li>

            <!-- 7. Daegu Knit — handled, fade tail -->
            <li class="thread thread-handled thread-tail" style="--thread-i:6">
              <span class="thread-avatar" style="--av:#9E7748">DK</span>
              <div class="thread-body">
                <div class="thread-row1">
                  <span class="thread-from">Min-Joo Park <em>· Daegu Knit Works</em></span>
                  <span class="thread-time">Yesterday</span>
                </div>
                <div class="thread-row2">
                  <span class="thread-subj">Re: Lead time confirmation — SS26 cardigans</span>
                  <span class="thread-snip"> — Confirmed 60-day cycle from PO, holiday closures noted…</span>
                </div>
              </div>
              <div class="thread-marks">
                <span class="mark-handled" style="--mark-delay:2700ms">
                  <span class="mark-handled-tick" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><polyline points="5 12 10 17 19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  Marker confirmed lead time
                </span>
              </div>
            </li>

          </ul>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Trust badges */
  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-foreground, #7D6B4F);
    opacity: 0.7;
  }

  /* ── Inbox shell ── */
  .hero-inbox-wrap {
    opacity: 0;
    animation: inbox-fade-in 0.8s ease-out 0.15s forwards;
    overflow: hidden;
    filter: drop-shadow(0 14px 44px rgba(45, 36, 24, 0.18))
            drop-shadow(0 4px 12px rgba(45, 36, 24, 0.06));
    max-width: 596px;
    position: relative;
  }

  @keyframes inbox-fade-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-inbox-frame {
    background: #FDFAF5;
    border: 1px solid #E8DFD0;
    border-radius: 14px 0 0 14px;
    border-right: none;
    overflow: hidden;
    font-family: var(--font-sans, "Plus Jakarta Sans", system-ui, sans-serif);
    color: #2D2418;
    width: 100%;
  }

  /* Window chrome */
  .inbox-chrome {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    background: #F5EDE0;
    border-bottom: 1px solid #E8DFD0;
  }
  .chrome-dots {
    display: flex;
    gap: 5px;
    margin-right: 6px;
  }
  .chrome-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #E0D3BC;
    box-shadow: inset 0 0 0 0.5px rgba(45, 36, 24, 0.05);
  }
  .chrome-dot:nth-child(1) { background: #E5C9B7; }
  .chrome-dot:nth-child(2) { background: #E9DBB5; }
  .chrome-dot:nth-child(3) { background: #C8D9BB; }

  .chrome-title {
    font-size: 11.5px;
    font-weight: 600;
    color: #2D2418;
    letter-spacing: 0.005em;
  }
  .chrome-divider {
    color: #B5A687;
    font-weight: 400;
  }
  .chrome-sub {
    font-size: 11.5px;
    font-weight: 500;
    color: #7D6B4F;
  }
  .chrome-spacer {
    flex: 1;
  }
  .chrome-count {
    font-size: 10.5px;
    color: #9A8B6E;
    font-feature-settings: "tnum" 1;
    letter-spacing: 0.04em;
  }

  /* Filter rail */
  .inbox-filters {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background: #FBF6EC;
    border-bottom: 1px solid #EFE5D2;
  }
  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 22px;
    padding: 0 9px;
    border-radius: 999px;
    background: transparent;
    border: 1px solid #E0D3BC;
    font-size: 10.5px;
    font-weight: 500;
    color: #6B5C44;
    letter-spacing: 0.005em;
    white-space: nowrap;
  }
  .filter-pill em {
    font-style: normal;
    font-weight: 600;
    color: #9A8B6E;
    font-feature-settings: "tnum" 1;
  }
  .filter-pill.is-active {
    background: #2D2418;
    border-color: #2D2418;
    color: #FDFAF5;
  }
  .filter-pill.is-active em {
    color: #C9BFA8;
  }
  .filter-pill.is-marker {
    background: #EAF2E5;
    border-color: #B7CFA9;
    color: #2D5C3D;
  }
  .filter-pill.is-marker em {
    color: #4A8865;
  }
  .filter-icon {
    width: 11px;
    height: 11px;
    color: #3A7D56;
  }

  /* Thread list */
  .inbox-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .thread {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 16px 12px 16px;
    border-bottom: 1px solid #EFE5D2;
    background: #FDFAF5;
    /* Cascade in after frame fade */
    opacity: 0;
    transform: translateY(4px);
    animation: thread-in 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: calc(0.55s + var(--thread-i) * 70ms);
  }
  .thread:last-child {
    border-bottom: none;
  }
  .thread.thread-tail {
    mask-image: linear-gradient(to bottom, #000 0%, #000 30%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 30%, transparent 100%);
  }

  @keyframes thread-in {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Avatar */
  .thread-avatar {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--av, #B5A687);
    color: #FDFAF5;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  /* Body */
  .thread-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .thread-row1 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    line-height: 1.2;
  }
  .thread-from {
    font-size: 12px;
    font-weight: 600;
    color: #2D2418;
    letter-spacing: 0.005em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .thread-from em {
    font-style: normal;
    font-weight: 400;
    color: #8B7B5D;
  }
  .thread-time {
    flex-shrink: 0;
    font-size: 10px;
    color: #A89878;
    font-feature-settings: "tnum" 1;
    letter-spacing: 0.02em;
  }

  .thread-row2 {
    font-size: 11.5px;
    line-height: 1.45;
    color: #2D2418;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .thread-subj {
    font-weight: 500;
  }
  .thread-snip {
    color: #8B7B5D;
    font-weight: 400;
  }

  /* ── Right-side mark column ── */
  .thread-marks {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    margin-left: 4px;
    padding-left: 8px;
    border-left: 1px dashed #E0D3BC;
    align-self: stretch;
  }

  /* Handled badge — sage check pill */
  .mark-handled {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px 4px 6px;
    border-radius: 999px;
    background: #EAF2E5;
    border: 1px solid #C5DCB3;
    font-size: 10px;
    font-weight: 600;
    color: #2D5C3D;
    letter-spacing: 0.005em;
    white-space: nowrap;
    opacity: 0;
    animation: mark-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: var(--mark-delay, 1500ms);
  }
  @keyframes mark-in {
    from { opacity: 0; transform: translateX(4px) scale(0.96); }
    to { opacity: 1; transform: translateX(0) scale(1); }
  }
  .mark-handled-tick {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #3A7D56;
    color: #FDFAF5;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .mark-handled-tick svg {
    width: 9px;
    height: 9px;
  }

  /* Active state: pulsing */
  .mark-active {
    background: #FFFBEC;
    border-color: #E8D7A0;
    color: #6B5224;
    opacity: 1;
    animation: none;
  }
  .mark-active-pulse {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    width: 14px;
    height: 14px;
    justify-content: center;
  }
  .mark-active-pulse span {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #B8860B;
    animation: dot-pulse 1.2s ease-in-out infinite;
  }
  .mark-active-pulse span:nth-child(2) { animation-delay: 0.18s; }
  .mark-active-pulse span:nth-child(3) { animation-delay: 0.36s; }
  @keyframes dot-pulse {
    0%, 80%, 100% { opacity: 0.25; transform: scale(0.85); }
    40% { opacity: 1; transform: scale(1); }
  }

  .thread.thread-active {
    background: linear-gradient(90deg, #FDFAF5 0%, #FBF4DD 88%, #FBF4DD 100%);
  }
  .thread.thread-active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #B8860B;
    opacity: 0.45;
    animation: active-bar 1.6s ease-in-out infinite;
  }
  @keyframes active-bar {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.7; }
  }

  /* ── Marker annotations ── */
  .anno-mark {
    position: relative;
    display: inline-block;
    color: #3A7D56;
    font-weight: 600;
  }
  .anno-target {
    position: relative;
    z-index: 1;
  }
  .anno-svg {
    position: absolute;
    pointer-events: none;
    color: #3A7D56;
    /* Reveal left-to-right via clip-path */
    clip-path: inset(0 100% 0 0);
    animation: anno-reveal 0.62s cubic-bezier(0.25, 0.7, 0.25, 1) forwards;
  }
  @keyframes anno-reveal {
    to { clip-path: inset(0 -2% 0 0); }
  }

  /* Underline variant */
  .anno-svg-underline {
    left: -3px;
    right: -3px;
    bottom: -3px;
    width: calc(100% + 6px);
    height: 9px;
    opacity: 0.78;
  }

  /* Circle variant — wraps the word, slight downward sit */
  .anno-mark-slip {
    color: #B8860B;
  }
  .anno-svg-circle {
    left: -8px;
    right: -8px;
    top: -4px;
    width: calc(100% + 16px);
    height: calc(100% + 8px);
    opacity: 0.78;
  }

  /* Per-annotation timing — sequence the draw-ins */
  .thread:nth-child(1) .anno-svg { animation-delay: 1500ms; }
  .thread:nth-child(3) .anno-svg { animation-delay: 1750ms; }
  .thread:nth-child(5) .anno-svg { animation-delay: 2000ms; }

  /* Subtle "ink wet" shimmer on freshly-drawn marks */
  .thread:nth-child(1) .anno-target,
  .thread:nth-child(3) .anno-target,
  .thread:nth-child(5) .anno-target {
    transition: color 0.4s 1.9s;
  }

  /* Pull-out callout chips — extracted data */
  .anno-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px 4px 7px;
    border-radius: 999px;
    background: #FFFBF5;
    border: 1px solid #E0D3BC;
    font-size: 10px;
    font-weight: 600;
    color: #2D2418;
    letter-spacing: 0.005em;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(4px);
    animation: chip-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: var(--chip-delay, 1900ms);
    box-shadow: 0 1px 2px rgba(45, 36, 24, 0.04);
  }
  .anno-chip svg {
    width: 11px;
    height: 11px;
  }
  @keyframes chip-in {
    to { opacity: 1; transform: translateX(0); }
  }

  .anno-chip-warn {
    background: #FBF4DD;
    border-color: #E8D7A0;
    color: #6B5224;
  }
  .anno-chip-alert {
    background: #FBEFE6;
    border-color: #E8C4A4;
    color: #7A3F1A;
  }
  .anno-chip-good {
    background: #EAF2E5;
    border-color: #C5DCB3;
    color: #2D5C3D;
  }

  /* ── Mobile: stack and bleed right ── */
  @media (max-width: 767px) {
    .hero-inbox-wrap {
      margin-top: 2.5rem;
      margin-right: -2rem;
      max-width: none;
    }
    .hero-inbox-frame {
      min-width: 0;
      width: 100%;
    }
    .thread-marks {
      display: none;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-inbox-wrap,
    .thread,
    .mark-handled,
    .anno-chip,
    .anno-svg {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      clip-path: none !important;
    }
    .mark-active-pulse span,
    .thread.thread-active::before {
      animation: none !important;
    }
  }
</style>

<script>
  import { drawCleanUnderline } from '../lib/marker-background.js';

  const HIGHLIGHT_COLOR = '#3A7D56';

  function getStrokeParams(section: HTMLElement) {
    const sectionRect = section.getBoundingClientRect();
    const lines = section.querySelectorAll('[data-marker-line]');
    if (!lines.length) return [];

    const angleRad = -0.3 * (Math.PI / 180);

    return Array.from(lines).map((line) => {
      const rect = line.getBoundingClientRect();
      const thickness = 14;
      const cy = rect.bottom - sectionRect.top + 2;
      const sx = rect.left - sectionRect.left - 8;
      const ex = rect.right - sectionRect.left + 8;
      const strokeLen = ex - sx;
      const rise = Math.sin(angleRad) * strokeLen * 0.5;

      return {
        sx,
        sy: cy - rise,
        ex,
        ey: cy + rise,
        color: HIGHLIGHT_COLOR,
        thickness,
        opacity: 1,
      };
    });
  }

  // Instant render (used on resize and when motion is reduced)
  function renderFull() {
    const canvas = document.getElementById('hero-marker-canvas') as HTMLCanvasElement;
    const section = canvas?.closest('section');
    if (!canvas || !section) return;

    const dpr = window.devicePixelRatio || 1;
    const W = section.clientWidth;
    const H = section.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    getStrokeParams(section).forEach(p => drawCleanUnderline(ctx, p));
  }

  // Animated draw-in: strokes reveal left-to-right like a hand drawing them
  function renderAnimated() {
    const canvas = document.getElementById('hero-marker-canvas') as HTMLCanvasElement;
    const section = canvas?.closest('section');
    if (!canvas || !section) return;

    const dpr = window.devicePixelRatio || 1;
    const W = section.clientWidth;
    const H = section.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const params = getStrokeParams(section);

    // Render each stroke to its own offscreen canvas (prevents vertical overlap bleed)
    const offscreens = params.map(p => {
      const off = document.createElement('canvas');
      off.width = canvas.width;
      off.height = canvas.height;
      const octx = off.getContext('2d')!;
      octx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawCleanUnderline(octx, p);
      return off;
    });

    const DURATION = 650;
    const STAGGER = 500;
    const INITIAL_DELAY = 1000; // wait for inbox fade-in to finish first
    const startTime = performance.now() + INITIAL_DELAY;

    function ease(t: number) {
      return t < 0.15
        ? t * t / 0.15
        : 1 - Math.pow(1 - t, 2.5);
    }

    function animate(now: number) {
      ctx.clearRect(0, 0, W, H);
      let allDone = true;

      params.forEach((p, i) => {
        const elapsed = now - startTime - i * STAGGER;
        if (elapsed <= 0) { allDone = false; return; }
        const t = Math.min(1, elapsed / DURATION);
        if (t < 1) allDone = false;
        const eased = ease(t);

        const revealWidth = (p.ex - p.sx) * eased;
        if (revealWidth <= 0) return;

        ctx.save();
        ctx.beginPath();
        ctx.rect(p.sx - 2, 0, revealWidth + 4, H);
        ctx.clip();
        ctx.drawImage(offscreens[i], 0, 0, offscreens[i].width, offscreens[i].height, 0, 0, W, H);
        ctx.restore();
      });

      if (!allDone) {
        requestAnimationFrame(animate);
      }
    }

    requestAnimationFrame(animate);
  }

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    renderFull();
  } else {
    renderAnimated();
  }
  window.addEventListener('resize', renderFull);

  // ── Inbox right-edge clipping ──
  // The wrap bleeds to the viewport edge via JS-set offset.
  // The frame is intentionally wider than the wrap so its right edge clips.
  function clipInbox() {
    const wrap = document.querySelector('.hero-inbox-wrap') as HTMLElement;
    if (!wrap) return;
    wrap.style.left = '0px';
    const rect = wrap.getBoundingClientRect();
    const shift = window.innerWidth - rect.right;
    wrap.style.left = shift + 'px';
  }
  clipInbox();
  window.addEventListener('resize', clipInbox);
</script>
