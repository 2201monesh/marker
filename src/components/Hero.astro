---

---

<section class="relative overflow-visible hero-bloom">
  <canvas
    id="hero-marker-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none"
    aria-hidden="true"
  ></canvas>
  <div class="relative z-10 mx-auto max-w-7xl px-8 py-32 md:py-44">
    <div class="max-w-3xl">
      <h1 id="hero-heading" class="text-5xl font-bold tracking-tight text-foreground leading-[1.1] md:text-6xl lg:text-7xl">
        <span data-marker-line>Your always-on</span>
        <br />
        <span class="text-accent-light"><span data-marker-line>supply chain</span>
        <br />
        <span data-marker-line>coordinator</span></span>
      </h1>
      <p class="mt-8 text-lg text-muted-foreground md:text-xl leading-relaxed">
        Marker is an AI-powered orchestrator that keeps things moving before
        you have to. It syncs data across your systems, tracks handoffs and
        deadlines, and moves work forward autonomously.
      </p>
      <div class="mt-12 flex flex-wrap items-center gap-4">
        <!-- A: Letterpress — textured cardstock, debossed text -->
        <a
          href="https://info.onmarker.com/book-a-demo"
          class="btn-a inline-flex h-12 items-center justify-center px-10 text-sm font-semibold uppercase tracking-[0.08em] text-primary-foreground transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 cursor-pointer"
        >
          Book a Demo
        </a>
        <!-- B: Framed invitation — cream, green text, double rule -->
        <a
          href="https://info.onmarker.com/book-a-demo"
          class="btn-b inline-flex h-12 items-center justify-center px-10 text-sm font-semibold uppercase tracking-[0.08em] text-primary transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 cursor-pointer" style="background-color: #FFFCF7;"
        >
          Book a Demo
        </a>
        <!-- C: Engraved — green fill, inset double frame, letterpress text -->
        <a
          href="https://info.onmarker.com/book-a-demo"
          class="btn-c inline-flex h-12 items-center justify-center bg-primary px-10 text-sm font-semibold uppercase tracking-[0.08em] text-primary-foreground transition-all hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 cursor-pointer"
        >
          Book a Demo
        </a>
      </div>
    </div>
  </div>

</section>

<script>
  import { drawHighlightStroke } from '../lib/marker-background.js';

  const COLORS = ['#e8dcc8', '#dfd3bc', '#ede2d0'];

  function render() {
    const canvas = document.getElementById('hero-marker-canvas') as HTMLCanvasElement;
    const section = canvas?.closest('section');
    if (!canvas || !section) return;

    const lines = section.querySelectorAll('[data-marker-line]');
    if (!lines.length) return;

    const dpr = window.devicePixelRatio || 1;
    const sectionRect = section.getBoundingClientRect();

    // Size canvas to section
    canvas.width = sectionRect.width * dpr;
    canvas.height = sectionRect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, sectionRect.width, sectionRect.height);

    lines.forEach((line, i) => {
      const rect = line.getBoundingClientRect();
      // Position relative to the section
      const x = rect.left - sectionRect.left;
      const y = rect.top - sectionRect.top;
      const centerY = y + rect.height * 0.55;
      const color = COLORS[i % COLORS.length];
      const overshoot = rect.width * 0.06;

      drawHighlightStroke(ctx, {
        sx: x - overshoot,
        sy: centerY,
        ex: x + rect.width + overshoot,
        ey: centerY,
        color,
        thickness: rect.height * 1.3,
        opacity: 0.35,
      });
    });
  }

  render();
  window.addEventListener('resize', render);
</script>
