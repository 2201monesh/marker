---
const steps = [
  {
    number: "1",
    title: "Connect the tools you already use",
    description:
      "Simple integrations with your ERPs, PLM systems, spreadsheets, instant messengers, and email. No migration, no behavior change.",
  },
  {
    number: "2",
    title: "Marker learns your workflows",
    description:
      "It maps how work moves across your systems — who's responsible, what's due, and where things get stuck.",
  },
  {
    number: "3",
    title: "Work moves forward on its own",
    description:
      "Marker syncs data, tracks deadlines, and keeps things moving autonomously, shaving weeks off your timelines.",
  },
];
---

<section class="relative bg-muted bg-paper-strong py-24 md:py-32 section-inset" aria-labelledby="how-it-works-heading">
  <div class="mx-auto max-w-7xl px-8">
    <h2 id="how-it-works-heading" class="text-3xl font-bold tracking-tight text-foreground leading-[1.15] md:text-4xl">
      How it works
    </h2>
    <div class="mt-12 grid gap-10 md:grid-cols-3">
      {steps.map((step) => (
        <div class="flex flex-col">
          <div class="circle-raised flex h-10 w-10 items-center justify-center rounded-full bg-accent-light text-sm font-bold text-accent-light-foreground">
            {step.number}
          </div>
          <h3 class="mt-4 text-lg font-semibold text-foreground">{step.title}</h3>
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
