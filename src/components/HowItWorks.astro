---
const steps = [
  {
    number: "1",
    title: "Connect",
    description:
      "Plug in your ERPs, PLM, spreadsheets, messengers, and email. Setup takes days, not months.",
  },
  {
    number: "2",
    title: "Design",
    description:
      "Map your workflows with triggers, gates, and handoffs. We help you get the first ones running.",
  },
  {
    number: "3",
    title: "Run",
    description:
      "Marker executes 24/7. Your team reviews, approves, and decides — nothing else.",
  },
];
---

<section id="how-it-works" class="relative pt-24 pb-12 md:pt-32 md:pb-16" aria-labelledby="how-it-works-heading">
  <div class="mx-auto max-w-7xl px-8">
    <p class="ink-reveal text-xs font-semibold uppercase tracking-[0.12em] text-primary/70 mb-4">
      Getting started
    </p>
    <h2 id="how-it-works-heading" class="ink-reveal text-3xl font-bold tracking-tight text-foreground leading-[1.15] md:text-4xl">
      How it works
    </h2>
    <div class="mt-12 grid gap-10 md:grid-cols-3">
      {steps.map((step, i) => (
        <div class="ink-reveal flex flex-col" style={`--reveal-delay: ${120 + i * 100}`}>
          <div class="circle-raised flex h-10 w-10 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-foreground">
            {step.number}
          </div>
          <h3 class="mt-4 text-lg font-semibold text-foreground">{step.title}</h3>
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
