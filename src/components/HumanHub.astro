---
/*  Human Hub → Marker Hub — scroll-driven morph.
    Single graphic. Person at center slides down to become a 7th node
    on the ring, revealing the Marker "M" icon behind it. System nodes
    redistribute evenly to make room. Lines go solid green. */

interface SystemNode {
  name: string;
  icon: string;
}

const systems: SystemNode[] = [
  {
    name: "ERP",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="3" y1="9" x2="21" y2="9" stroke="currentColor" stroke-width="1.5"/><line x1="3" y1="15" x2="21" y2="15" stroke="currentColor" stroke-width="1.5"/><line x1="9" y1="3" x2="9" y2="21" stroke="currentColor" stroke-width="1.5"/>`,
  },
  {
    name: "PLM",
    icon: `<rect x="4" y="4" width="16" height="16" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="7" y="7" width="10" height="10" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="10" y="10" width="4" height="4" rx="0.5" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  },
  {
    name: "Email",
    icon: `<rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><polyline points="2,4 12,13 22,4" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  },
  {
    name: "Spreadsheets",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="3" y1="9" x2="21" y2="9" stroke="currentColor" stroke-width="1.5"/><line x1="3" y1="15" x2="21" y2="15" stroke="currentColor" stroke-width="1.5"/><line x1="9" y1="3" x2="9" y2="21" stroke="currentColor" stroke-width="1.5"/><line x1="15" y1="3" x2="15" y2="21" stroke="currentColor" stroke-width="1.5"/>`,
  },
  {
    name: "Messenger",
    icon: `<path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  },
  {
    name: "Costing",
    icon: `<rect x="4" y="2" width="16" height="20" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="8" y1="6" x2="16" y2="6" stroke="currentColor" stroke-width="1.5"/><line x1="8" y1="10" x2="16" y2="10" stroke="currentColor" stroke-width="1.5"/><line x1="8" y1="14" x2="12" y2="14" stroke="currentColor" stroke-width="1.5"/><circle cx="14" cy="17" r="2" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  },
];

/* ── Geometry ── */
const R_PCT = 37.5;  // ring radius as % of container
const R_SVG = 150;   // ring radius in SVG units (400×400 viewBox)

const startAngles = [-60, 0, 60, 120, 180, 240]; // 6 nodes, 60° apart

// Insert human at 90° (bottom). Redistribute 7 nodes evenly (360/7 ≈ 51.43°).
// Offset chosen so human lands at exactly 90° with minimal movement for others.
const humanEndAngle = 90;
const endAngles = [-64.29, -12.86, 38.57, 141.43, 192.86, 244.29];

function angleToPct(deg: number) {
  const rad = (deg * Math.PI) / 180;
  return { left: 50 + Math.cos(rad) * R_PCT, top: 50 + Math.sin(rad) * R_PCT };
}
function angleToSvg(deg: number) {
  const rad = (deg * Math.PI) / 180;
  return { x: 200 + Math.cos(rad) * R_SVG, y: 200 + Math.sin(rad) * R_SVG };
}

const startPositions = startAngles.map(angleToPct);
const humanEndPct = angleToPct(humanEndAngle);
const humanEndSvg = angleToSvg(humanEndAngle);
---

<div class="hub-wrap ink-reveal" style="--reveal-delay: 200" aria-hidden="true">
  <!-- Phase label -->
  <div class="hub-phase-label" id="hub-phase-label">Today</div>

  <div class="hub-graphic">
    <!-- SVG connector lines: 6 system + 1 human -->
    <svg class="hub-svg-layer" viewBox="0 0 400 400" fill="none">
      {startAngles.map((deg, i) => {
        const s = angleToSvg(deg);
        return (
          <line class="hub-line" data-line-idx={i}
            x1="200" y1="200" x2={s.x} y2={s.y}
            stroke="#E8DFD0" stroke-width="1" stroke-dasharray="4 4" />
        );
      })}
      <!-- 7th line: to human's end position, starts hidden -->
      <line class="hub-line" data-line-idx="human"
        x1="200" y1="200" x2={humanEndSvg.x} y2={humanEndSvg.y}
        stroke="#E8DFD0" stroke-width="1" stroke-dasharray="4 4" opacity="0" />
    </svg>

    <!-- Marker M at center (sits behind person, always here) -->
    <div class="hub-center-m" id="hub-center-m">
      <div class="hub-marker-icon">
        <span class="hub-marker-letter">m</span>
      </div>
    </div>

    <!-- Person node (starts at center, slides to ring) -->
    <div class="hub-person-node" id="hub-person-node" style="left:50%;top:50%">
      <div class="hub-person-icon" id="hub-person-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 21v-1a6 6 0 0112 0v1"/>
        </svg>
      </div>
      <span class="hub-person-label" id="hub-person-label">Your team</span>
    </div>

    <!-- Traveling dot (Phase 1 hop animation) -->
    <div class="hub-dot" id="hub-dot"></div>

    <!-- 6 system nodes -->
    {systems.map((sys, i) => {
      const pos = startPositions[i];
      return (
        <div class="hub-node" style={`left:${pos.left}%;top:${pos.top}%`} data-hub-node={i}>
          <div class="hub-node-icon">
            <svg viewBox="0 0 24 24" set:html={sys.icon} />
          </div>
          <span class="hub-node-label">{sys.name}</span>
        </div>
      );
    })}
  </div>

  <!-- Story title (Phase 1) -->
  <div class="hub-story-title" id="hub-story-title"></div>

  <!-- Caption -->
  <div class="hub-caption" id="hub-caption"></div>
</div>

<script is:inline define:vars={{ startPositions, startAngles, endAngles, humanEndAngle }}>
  window.__hubStartPositions = startPositions;
  window.__hubStartAngles = startAngles;
  window.__hubEndAngles = endAngles;
  window.__hubHumanEndAngle = humanEndAngle;
</script>

<script>
  const R_PCT = 37.5;
  const R_SVG = 150;

  function angleToPct(deg: number) {
    const rad = (deg * Math.PI) / 180;
    return { left: 50 + Math.cos(rad) * R_PCT, top: 50 + Math.sin(rad) * R_PCT };
  }
  function angleToSvg(deg: number) {
    const rad = (deg * Math.PI) / 180;
    return { x: 200 + Math.cos(rad) * R_SVG, y: 200 + Math.sin(rad) * R_SVG };
  }
  function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

  /* ── Data from server ── */
  const startPositions: { left: number; top: number }[] = (window as any).__hubStartPositions;
  const startAngles: number[] = (window as any).__hubStartAngles;
  const endAngles: number[] = (window as any).__hubEndAngles;
  const humanEndAngle: number = (window as any).__hubHumanEndAngle;

  /* ── DOM refs ── */
  const dot = document.getElementById('hub-dot')!;
  const caption = document.getElementById('hub-caption')!;
  const storyTitle = document.getElementById('hub-story-title')!;
  const phaseLabel = document.getElementById('hub-phase-label')!;
  const personNode = document.getElementById('hub-person-node')!;
  const personIcon = document.getElementById('hub-person-icon')!;
  const personLabel = document.getElementById('hub-person-label')!;
  const centerM = document.getElementById('hub-center-m')!;
  const spacer = document.querySelector('.problem-scroll-spacer') as HTMLElement;
  const sysNodes = document.querySelectorAll<HTMLElement>('[data-hub-node]');
  const sysLines = document.querySelectorAll<SVGLineElement>('.hub-line[data-line-idx]');
  const humanLine = document.querySelector('.hub-line[data-line-idx="human"]') as SVGLineElement;

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const CENTER = { left: 50, top: 50 };

  /* ── Phase 1: hop animation ── */
  const stories = [
    {
      title: "One spec field changes",
      hops: [
        { sys: 4, label: "Read the change request" },
        { sys: 1, label: "Rebuild the entire tech pack from scratch" },
        { sys: 5, label: "Re-enter the updated material yield" },
        { sys: 2, label: "Re-send the spec to three factories" },
        { sys: 3, label: "Key each factory's response into the tracker" },
      ],
    },
    {
      title: "A vendor submits costing",
      hops: [
        { sys: 2, label: "Download the vendor's numbers" },
        { sys: 3, label: "Find their row in the cost tracker" },
        { sys: 5, label: "Key the numbers in by hand" },
        { sys: 3, label: "Open a second sheet to check target margins" },
        { sys: 0, label: "Verify the part number matches" },
        { sys: 3, label: "Open a third sheet to compare last season" },
        { sys: 4, label: "Flag a $0.12 discrepancy to the team" },
      ],
    },
  ];

  function moveDot(pos: { left: number; top: number }) {
    dot.style.left = `${pos.left}%`;
    dot.style.top = `${pos.top}%`;
  }

  function highlightNode(sysIndex: number | null) {
    sysNodes.forEach((n) => {
      n.classList.toggle('hub-node--active', n.dataset.hubNode === String(sysIndex));
    });
  }

  function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  moveDot(CENTER);

  let hopCancelled = false;

  async function runHopLoop() {
    while (!hopCancelled) {
      for (const story of stories) {
        if (hopCancelled) break;
        storyTitle.textContent = story.title;
        storyTitle.style.opacity = '1';
        await sleep(800);
        if (hopCancelled) break;

        dot.style.opacity = '0.8';

        for (const hop of story.hops) {
          if (hopCancelled) break;
          caption.textContent = hop.label;
          caption.style.opacity = '1';
          moveDot(startPositions[hop.sys]);
          highlightNode(hop.sys);

          await sleep(reducedMotion ? 0 : 450);
          if (hopCancelled) break;
          await sleep(1200);
          if (hopCancelled) break;

          moveDot(CENTER);
          highlightNode(null);

          await sleep(reducedMotion ? 0 : 450);
          if (hopCancelled) break;
          caption.style.opacity = '0';
          await sleep(250);
        }

        if (hopCancelled) break;
        dot.style.opacity = '0';
        storyTitle.style.opacity = '0';
        await sleep(1400);
      }
    }

    // Clean up
    dot.style.opacity = '0';
    caption.style.opacity = '0';
    storyTitle.style.opacity = '0';
    highlightNode(null);
  }

  /* ── Scroll-driven morph ── */
  function getScrollProgress(): number {
    if (!spacer) return 0;
    const rect = spacer.getBoundingClientRect();
    const scrollRange = spacer.offsetHeight - window.innerHeight;
    if (scrollRange <= 0) return 0;
    return Math.max(0, Math.min(1, -rect.top / scrollRange));
  }

  let lastP = 0;

  function onScroll() {
    const p = getScrollProgress();

    // Kill hop animation once scroll starts
    if (p > 0.05 && !hopCancelled) {
      hopCancelled = true;
    }

    // Ease the progress for smoother feel
    const t = p;

    /* ── Person: slide from center to ring bottom ── */
    const humanEnd = angleToPct(humanEndAngle);
    const pLeft = lerp(50, humanEnd.left, t);
    const pTop = lerp(50, humanEnd.top, t);
    personNode.style.left = `${pLeft}%`;
    personNode.style.top = `${pTop}%`;

    // Scale: 1.3 (52px apparent) → 1.0 (40px)
    const pScale = lerp(1.3, 1.0, t);
    personIcon.style.transform = `scale(${pScale})`;

    // Shadow rings fade out as person moves to ring
    const ringAlpha = 1 - t;
    personIcon.style.boxShadow = `
      0 0 0 ${lerp(4, 0, t)}px rgba(58, 125, 86, ${0.2 * ringAlpha}),
      0 0 0 ${lerp(8, 0, t)}px rgba(58, 125, 86, ${0.08 * ringAlpha}),
      0 2px 8px rgba(45, 36, 24, ${0.12 * ringAlpha})
    `;

    // Person label fades in
    personLabel.style.opacity = String(Math.max(0, (t - 0.6) / 0.4));

    /* ── M center: revealed as person moves away ── */
    // Shadow rings grow in
    const mAlpha = t;
    centerM.style.opacity = '1';
    const mIcon = centerM.querySelector('.hub-marker-icon') as HTMLElement;
    if (mIcon) {
      mIcon.style.boxShadow = `
        0 0 0 ${lerp(0, 4, t)}px rgba(58, 125, 86, ${0.25 * mAlpha}),
        0 0 0 ${lerp(0, 8, t)}px rgba(58, 125, 86, ${0.1 * mAlpha}),
        0 2px 8px rgba(45, 36, 24, ${0.12 * mAlpha})
      `;
    }

    /* ── System nodes: interpolate positions ── */
    sysNodes.forEach((node, i) => {
      const sAngle = startAngles[i];
      const eAngle = endAngles[i];
      const angle = lerp(sAngle, eAngle, t);
      const pos = angleToPct(angle);
      node.style.left = `${pos.left}%`;
      node.style.top = `${pos.top}%`;

      // Connected styling
      node.classList.toggle('hub-node--connected', t > 0.5);
    });

    /* ── Connector lines: update endpoints ── */
    sysLines.forEach((line) => {
      const idx = line.dataset.lineIdx;
      if (idx === 'human') return;

      const i = Number(idx);
      const angle = lerp(startAngles[i], endAngles[i], t);
      const svgPos = angleToSvg(angle);
      line.setAttribute('x2', String(svgPos.x));
      line.setAttribute('y2', String(svgPos.y));
    });

    // Human connector line fades in
    if (humanLine) {
      humanLine.style.opacity = String(t);
    }

    /* ── Phase label ── */
    if (t < 0.15) {
      phaseLabel.textContent = 'Today';
      phaseLabel.style.opacity = '1';
    } else if (t > 0.35) {
      phaseLabel.textContent = 'With Marker';
      phaseLabel.style.opacity = '1';
    } else {
      phaseLabel.style.opacity = '0';
    }

    /* ── Caption ── */
    if (t > 0.7) {
      caption.textContent = 'Marker handles the busywork. Your team handles the thinking.';
      caption.style.opacity = String(Math.min(1, (t - 0.7) / 0.2));
    } else if (!hopCancelled || t > 0.05) {
      caption.style.opacity = '0';
    }

    /* ── Dot: hide during transition ── */
    if (t > 0.05) {
      dot.style.opacity = '0';
      storyTitle.style.opacity = '0';
    }

    lastP = p;
  }

  /* ── Init ── */
  const section = document.getElementById('problem-section');

  if (section && spacer) {
    window.addEventListener('scroll', onScroll, { passive: true });

    const obs = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          obs.disconnect();
          runHopLoop();
        }
      },
      { threshold: 0.1 }
    );
    obs.observe(section);
  }
</script>

<style>
  .hub-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  /* ── Phase label ── */
  .hub-phase-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #7D6B4F;
    text-align: center;
    min-height: 1.4em;
    padding: 3px 10px 2px;
    border: 1px solid #D4C9B8;
    border-radius: 3px;
    background: rgba(245, 237, 224, 0.6);
    transition: opacity 0.3s ease;
  }

  /* ── Story title ── */
  .hub-story-title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #7D6B4F;
    text-align: center;
    opacity: 0;
    transition: opacity 0.4s ease;
    min-height: 1.4em;
  }

  .hub-graphic {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1;
  }

  .hub-svg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ── Traveling dot ── */
  .hub-dot {
    position: absolute;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: #3A7D56;
    opacity: 0;
    z-index: 5;
    pointer-events: none;
    transition: left 0.45s ease-in-out, top 0.45s ease-in-out, opacity 0.3s ease;
    left: 50%;
    top: 50%;
  }

  /* ── Marker M at center ── */
  .hub-center-m {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .hub-marker-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #3A7D56;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: none;
    transition: box-shadow 0.3s ease;
  }

  .hub-marker-letter {
    font-size: 24px;
    font-weight: 800;
    font-style: italic;
    color: #fff;
    line-height: 1;
    /* Nudge to optically center the italic lowercase m */
    margin-top: 1px;
    margin-left: 1px;
  }

  /* ── Person node (starts at center) ── */
  .hub-person-node {
    position: absolute;
    z-index: 4;
    transform: translate(-50%, -50%);
  }


  .hub-person-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #3A7D56;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: scale(1.3);
    box-shadow:
      0 0 0 4px rgba(58, 125, 86, 0.2),
      0 0 0 8px rgba(58, 125, 86, 0.08),
      0 2px 8px rgba(45, 36, 24, 0.12);
  }

  .hub-person-icon svg {
    width: 20px;
    height: 20px;
  }

  .hub-person-label {
    position: absolute;
    top: 100%;
    margin-top: 4px;
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #7D6B4F;
    white-space: nowrap;
    opacity: 0;
  }

  /* ── System nodes ── */
  .hub-node {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    z-index: 3;
    transition: transform 0.2s ease;
  }

  .hub-node--active {
    transform: translate(-50%, -50%) scale(1.12);
  }

  .hub-node--active .hub-node-icon {
    border-color: #3A7D56;
    box-shadow: 0 0 0 3px rgba(58, 125, 86, 0.15), 0 1px 3px rgba(45, 36, 24, 0.08);
  }

  .hub-node--connected {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .hub-node--connected .hub-node-icon {
    border-color: #3A7D56;
    background: #EBF5EF;
    box-shadow: 0 0 0 3px rgba(58, 125, 86, 0.18), 0 1px 3px rgba(45, 36, 24, 0.08);
  }

  .hub-node--connected .hub-node-icon svg {
    color: #3A7D56;
  }

  .hub-node-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #F5EDE0;
    border: 1px solid #E8DFD0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 3px rgba(45, 36, 24, 0.08);
    transition: border-color 0.4s ease, box-shadow 0.4s ease, background 0.4s ease;
  }

  .hub-node-icon svg {
    width: 18px;
    height: 18px;
    color: #7D6B4F;
    transition: color 0.4s ease;
  }

  .hub-node-label {
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #7D6B4F;
    white-space: nowrap;
  }

  /* ── Caption ── */
  .hub-caption {
    height: 1.6em;
    width: 100%;
    max-width: 420px;
    text-align: center;
    font-size: 12px;
    font-style: italic;
    font-weight: 400;
    color: #6B5638;
    line-height: 1.4;
    transition: opacity 0.25s ease;
    opacity: 0;
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .hub-dot,
    .hub-node,
    .hub-node-icon,
    .hub-node-icon svg,
    .hub-caption,
    .hub-marker-icon,
    .hub-phase-label {
      transition: none;
    }
  }

  /* ── Responsive ── */
  @media (max-width: 767px) {
    .hub-graphic {
      max-width: 320px;
    }
    .hub-caption {
      max-width: 320px;
    }
  }
</style>
