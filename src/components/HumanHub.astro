---
/*  Human Hub — radial diagram showing a person at the center of 6 systems,
    with a single dot tracing multi-system journeys that illustrate the
    human as "glue" between disconnected tools. */

interface SystemNode {
  name: string;
  icon: string;
}

const systems: SystemNode[] = [
  {
    name: "ERP",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="3" y1="9" x2="21" y2="9" stroke="currentColor" stroke-width="1.5"/><line x1="3" y1="15" x2="21" y2="15" stroke="currentColor" stroke-width="1.5"/><line x1="9" y1="3" x2="9" y2="21" stroke="currentColor" stroke-width="1.5"/>`,
  },
  {
    name: "PLM",
    icon: `<rect x="4" y="4" width="16" height="16" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="7" y="7" width="10" height="10" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="10" y="10" width="4" height="4" rx="0.5" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  },
  {
    name: "Email",
    icon: `<rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><polyline points="2,4 12,13 22,4" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  },
  {
    name: "Spreadsheets",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="3" y1="9" x2="21" y2="9" stroke="currentColor" stroke-width="1.5"/><line x1="3" y1="15" x2="21" y2="15" stroke="currentColor" stroke-width="1.5"/><line x1="9" y1="3" x2="9" y2="21" stroke="currentColor" stroke-width="1.5"/><line x1="15" y1="3" x2="15" y2="21" stroke="currentColor" stroke-width="1.5"/>`,
  },
  {
    name: "Messenger",
    icon: `<path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  },
  {
    name: "Costing",
    icon: `<rect x="4" y="2" width="16" height="20" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="8" y1="6" x2="16" y2="6" stroke="currentColor" stroke-width="1.5"/><line x1="8" y1="10" x2="16" y2="10" stroke="currentColor" stroke-width="1.5"/><line x1="8" y1="14" x2="12" y2="14" stroke="currentColor" stroke-width="1.5"/><circle cx="14" cy="17" r="2" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  },
];

// Positions for 6 nodes around a circle (in degrees)
const angleOffsetDeg = -60;
const nodeAngles = systems.map((_, i) => (i * 60 + angleOffsetDeg));

// Precompute node positions as percentages (for the dot and highlight)
const nodePositions = nodeAngles.map((deg) => {
  const rad = (deg * Math.PI) / 180;
  return {
    left: 50 + Math.cos(rad) * 37.5,
    top: 50 + Math.sin(rad) * 37.5,
  };
});
---

<div class="hub-wrap ink-reveal" style="--reveal-delay: 200" aria-hidden="true">
  <!-- Phase label -->
  <div class="hub-phase-label">Today</div>

  <div class="hub-graphic">

    <!-- Connector lines -->
    <svg class="hub-svg-layer" viewBox="0 0 400 400" fill="none">
      {nodeAngles.map((deg) => {
        const rad = (deg * Math.PI) / 180;
        return (
          <line
            x1="200" y1="200"
            x2={200 + Math.cos(rad) * 150} y2={200 + Math.sin(rad) * 150}
            stroke="#E8DFD0"
            stroke-width="1"
            stroke-dasharray="4 4"
          />
        );
      })}
    </svg>

    <!-- Traveling dot (HTML div, positioned via JS) -->
    <div class="hub-dot" id="hub-dot"></div>

    <!-- Center person icon -->
    <div class="hub-center">
      <div class="hub-person">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 21v-1a6 6 0 0112 0v1"/>
        </svg>
      </div>
    </div>

    <!-- System nodes -->
    {systems.map((sys, i) => {
      const pos = nodePositions[i];
      return (
        <div class="hub-node" style={`left:${pos.left}%;top:${pos.top}%`} data-hub-node={i}>
          <div class="hub-node-icon">
            <svg viewBox="0 0 24 24" set:html={sys.icon} />
          </div>
          <span class="hub-node-label">{sys.name}</span>
        </div>
      );
    })}
  </div>

  <!-- Story title above the diagram -->
  <div class="hub-story-title" id="hub-story-title"></div>

  <!-- Caption below the diagram -->
  <div class="hub-caption" id="hub-caption"></div>
</div>

<!-- Pass node positions to client JS -->
<script is:inline define:vars={{ nodePositions }}>
  window.__hubNodePositions = nodePositions;
</script>

<script>
  const stories = [
    {
      title: "One spec field changes",
      hops: [
        { sys: 4, label: "Read the change request" },
        { sys: 1, label: "Rebuild the entire tech pack from scratch" },
        { sys: 5, label: "Re-enter the updated material yield" },
        { sys: 2, label: "Re-send the spec to three factories" },
        { sys: 3, label: "Key each factory's response into the tracker" },
      ],
    },
    {
      title: "A vendor submits costing",
      hops: [
        { sys: 2, label: "Download the vendor's numbers" },
        { sys: 3, label: "Find their row in the cost tracker" },
        { sys: 5, label: "Key the numbers in by hand" },
        { sys: 3, label: "Open a second sheet to check target margins" },
        { sys: 0, label: "Verify the part number matches" },
        { sys: 3, label: "Open a third sheet to compare last season" },
        { sys: 4, label: "Flag a $0.12 discrepancy to the team" },
      ],
    },
  ];

  const dot = document.getElementById('hub-dot');
  const caption = document.getElementById('hub-caption');
  const storyTitle = document.getElementById('hub-story-title');
  const nodes = document.querySelectorAll<HTMLElement>('[data-hub-node]');
  const positions: { left: number; top: number }[] = (window as any).__hubNodePositions;

  if (!dot || !caption || !storyTitle || !positions) throw new Error('Hub elements missing');

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Center position
  const CENTER = { left: 50, top: 50 };

  function moveDot(pos: { left: number; top: number }) {
    dot.style.left = `${pos.left}%`;
    dot.style.top = `${pos.top}%`;
  }

  function highlightNode(sysIndex: number | null) {
    nodes.forEach((n) => {
      n.classList.toggle('hub-node--active', n.dataset.hubNode === String(sysIndex));
    });
  }

  function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  // Start at center, hidden
  moveDot(CENTER);

  async function runLoop() {
    while (true) {
      for (const story of stories) {
        // Show story title first, let it breathe
        storyTitle.textContent = story.title;
        storyTitle.style.opacity = '1';
        await sleep(800);

        // Then fade dot in and start hops
        dot.style.opacity = '0.8';

        for (const hop of story.hops) {
          const target = positions[hop.sys];

          // Show caption and travel to system
          caption.textContent = hop.label;
          caption.style.opacity = '1';
          moveDot(target);
          highlightNode(hop.sys);

          await sleep(reducedMotion ? 0 : 450); // travel time (CSS transition)
          await sleep(1200); // hold at system

          // Travel back to center
          moveDot(CENTER);
          highlightNode(null);

          await sleep(reducedMotion ? 0 : 450); // travel back
          caption.style.opacity = '0';
          await sleep(250); // brief pause at center
        }

        // Fade dot and title out between stories
        dot.style.opacity = '0';
        storyTitle.style.opacity = '0';
        await sleep(1400);
      }
    }
  }

  // Start when visible
  const section = dot.closest('section') || dot.closest('.hub-wrap');
  if (section) {
    const obs = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          obs.disconnect();
          runLoop();
        }
      },
      { threshold: 0.2 }
    );
    obs.observe(section);
  } else {
    runLoop();
  }
</script>

<style>
  .hub-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  /* ── Phase label ── */
  .hub-phase-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #7D6B4F;
    text-align: center;
    min-height: 1.4em;
    padding: 3px 10px 2px;
    border: 1px solid #D4C9B8;
    border-radius: 3px;
    background: rgba(245, 237, 224, 0.6);
  }

  /* ── Story title above diagram ── */
  .hub-story-title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #7D6B4F;
    text-align: center;
    opacity: 0;
    transition: opacity 0.4s ease;
    min-height: 1.4em;
  }

  .hub-graphic {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1;
  }

  /* ── SVG layer ── */
  .hub-svg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ── Traveling dot ── */
  .hub-dot {
    position: absolute;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: #3A7D56;
    opacity: 0;
    z-index: 1;
    pointer-events: none;
    transition: left 0.45s ease-in-out, top 0.45s ease-in-out, opacity 0.3s ease;
    left: 50%;
    top: 50%;
  }

  /* ── Center person ── */
  .hub-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
  }

  .hub-person {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #3A7D56;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 0 4px rgba(58, 125, 86, 0.2),
      0 0 0 8px rgba(58, 125, 86, 0.08),
      0 2px 8px rgba(45, 36, 24, 0.12);
  }

  .hub-person svg {
    width: 24px;
    height: 24px;
  }

  /* ── System nodes ── */
  .hub-node {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    z-index: 2;
    transition: transform 0.2s ease;
  }

  .hub-node--active {
    transform: translate(-50%, -50%) scale(1.12);
  }

  .hub-node--active .hub-node-icon {
    border-color: #3A7D56;
    box-shadow: 0 0 0 3px rgba(58, 125, 86, 0.15), 0 1px 3px rgba(45, 36, 24, 0.08);
  }

  .hub-node-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #F5EDE0;
    border: 1px solid #E8DFD0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 3px rgba(45, 36, 24, 0.08);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hub-node-icon svg {
    width: 18px;
    height: 18px;
    color: #7D6B4F;
  }

  .hub-node-label {
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #7D6B4F;
    white-space: nowrap;
  }

  /* ── Caption below diagram ── */
  .hub-caption {
    height: 1.6em;
    width: 100%;
    max-width: 420px;
    text-align: center;
    font-size: 12px;
    font-style: italic;
    font-weight: 400;
    color: #6B5638;
    line-height: 1.4;
    transition: opacity 0.25s ease;
    opacity: 0;
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .hub-dot {
      transition: none;
    }
    .hub-node {
      transition: none;
    }
    .hub-node-icon {
      transition: none;
    }
    .hub-caption {
      transition: none;
    }
  }

  /* ── Responsive ── */
  @media (max-width: 767px) {
    .hub-graphic {
      max-width: 320px;
    }
    .hub-caption {
      max-width: 320px;
    }
  }
</style>
