---
interface Props {
  pathPrefix?: string;
  showBookDemo?: boolean;
}
const { pathPrefix = "", showBookDemo = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer-molding py-12">
  <div class="mx-auto max-w-7xl px-8">
    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted-foreground" aria-label="Footer">
      {showBookDemo && (
        <a href="https://info.onmarker.com/book-a-demo" class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Book a call</a>
      )}
      <a href={`${pathPrefix}/privacy`} class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Privacy Policy</a>
      <a href={`${pathPrefix}/cookies`} class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Cookie Policy</a>
      <a href={`${pathPrefix}/terms`} class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Terms of Service</a>
      <a href="https://trust.onmarker.com/" class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Trust Center</a>
      <a href={`${pathPrefix}/privacy#privacyrights`} class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Do Not Sell My Personal Information</a>
      <a href="#" onclick="if(window.displayPreferenceModal){window.displayPreferenceModal();return false;}" class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Manage Cookies</a>
    </nav>
    <nav class="mt-4 flex flex-wrap justify-center gap-3" aria-label="Social media">
      <a
        href="https://www.linkedin.com/company/112296703/"
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn"
        class="social-raised inline-flex h-10 w-10 items-center justify-center rounded-full bg-muted text-muted-foreground transition-all hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a
        href="https://www.youtube.com/channel/UCfTEGXwS-TNobRvV1sT603A"
        target="_blank"
        rel="noreferrer"
        aria-label="YouTube"
        class="social-raised inline-flex h-10 w-10 items-center justify-center rounded-full bg-muted text-muted-foreground transition-all hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
      </a>
      <a
        href="https://x.com/markerhq"
        target="_blank"
        rel="noreferrer"
        aria-label="X"
        class="social-raised inline-flex h-10 w-10 items-center justify-center rounded-full bg-muted text-muted-foreground transition-all hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.847h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.153h7.594l5.243 6.932zm-1.29 19.494h2.039L6.486 3.238H4.298z" />
        </svg>
      </a>
    </nav>
    <p class="mt-4 text-center text-sm text-muted-foreground">
      &copy; {year} Widari Inc. All rights reserved.
    </p>
    <p class="mt-2 text-center text-xs text-muted-foreground">
      We are committed to making this website accessible to all users. If you experience any accessibility issues, please contact <a href="mailto:privacy@onmarker.com" class="text-primary underline">privacy@onmarker.com</a>.
    </p>
  </div>
</footer>
