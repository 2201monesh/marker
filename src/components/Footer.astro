---
import { Linkedin, Youtube } from "lucide-react";
import FooterNewsletter from "./FooterNewsletter";

const year = new Date().getFullYear();
---

<footer class="footer-molding py-12">
  <div class="mx-auto max-w-7xl px-8">
    <div class="flex justify-center mb-6">
      <FooterNewsletter client:visible />
    </div>
    <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
      <span class="footer-trust-badge">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        SOC 2 Type II
      </span>
      <span class="footer-trust-badge">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        ISO 27001
      </span>
      <span class="footer-trust-badge">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="2" y="5" width="20" height="14" rx="2" fill="currentColor" opacity="0.15" />
          <text x="12" y="15" text-anchor="middle" font-size="10" font-weight="bold" fill="currentColor">Y</text>
        </svg>
        Backed by Y Combinator
      </span>
    </div>
    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted-foreground" aria-label="Footer">
      <a href="https://info.onmarker.com/book-a-demo" class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Book a Demo</a>
      <a href="/privacy" class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Privacy Policy</a>
      <a href="/cookies" class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Cookie Policy</a>
      <a href="/terms" class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Terms of Service</a>
      <a href="https://trust.onmarker.com/" class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Trust Center</a>
      <a href="/privacy#privacyrights" class="hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded">Do Not Sell My Personal Information</a>
    </nav>
    <nav class="mt-4 flex flex-wrap justify-center gap-3" aria-label="Social media">
      <a
        href="https://www.linkedin.com/company/112296703/"
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn"
        class="social-raised inline-flex h-10 w-10 items-center justify-center rounded-full bg-muted text-muted-foreground transition-all hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <Linkedin className="h-5 w-5" aria-hidden="true" />
      </a>
      <a
        href="https://www.youtube.com/channel/UCfTEGXwS-TNobRvV1sT603A"
        target="_blank"
        rel="noreferrer"
        aria-label="YouTube"
        class="social-raised inline-flex h-10 w-10 items-center justify-center rounded-full bg-muted text-muted-foreground transition-all hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <Youtube className="h-5 w-5" aria-hidden="true" />
      </a>
      <a
        href="https://x.com/markerhq"
        target="_blank"
        rel="noreferrer"
        aria-label="X"
        class="social-raised inline-flex h-10 w-10 items-center justify-center rounded-full bg-muted text-muted-foreground transition-all hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.847h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.153h7.594l5.243 6.932zm-1.29 19.494h2.039L6.486 3.238H4.298z" />
        </svg>
      </a>
    </nav>
    <p class="mt-4 text-center text-sm text-muted-foreground">
      &copy; {year} Widari Inc. All rights reserved.
    </p>
    <p class="mt-2 text-center text-xs text-muted-foreground">
      We are committed to making this website accessible to all users. If you experience any accessibility issues, please contact <a href="mailto:privacy@onmarker.com" class="text-primary underline">privacy@onmarker.com</a>.
    </p>
  </div>
</footer>

<style>
  .footer-trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-foreground, #7D6B4F);
    opacity: 0.6;
  }
</style>
