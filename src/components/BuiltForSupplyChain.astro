---

---

<section class="relative py-24 md:py-32" aria-labelledby="built-for-heading">
  <div class="relative z-10 mx-auto max-w-7xl px-8">
    <div class="max-w-3xl">
      <p class="ink-reveal text-xs font-semibold uppercase tracking-[0.12em] text-primary/70 mb-4">
        Domain expertise
      </p>
      <h2 id="built-for-heading" class="ink-reveal text-3xl font-bold tracking-tight text-foreground leading-[1.15] md:text-4xl">
        Built exclusively for retail supply chain.
      </h2>
      <p class="ink-reveal mt-6 text-muted-foreground md:text-lg leading-relaxed" style="--reveal-delay: 120">
        Years inside the systems, processes, and edge cases that make retail supply chains uniquely complex. Every vendor handoff. Every approval chain. Every exception that doesn't fit in a template.
      </p>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      <div class="ink-reveal built-for-card" style="--reveal-delay: 200">
        <div class="built-for-icon">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
          </svg>
        </div>
        <h3 class="mt-4 text-base font-semibold text-foreground">Your systems, connected</h3>
        <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
          ERPs, PLM, spreadsheets, vendor portals, email — we know how they talk to each other in retail, and where they don't.
        </p>
      </div>

      <div class="ink-reveal built-for-card" style="--reveal-delay: 300">
        <div class="built-for-icon">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
          </svg>
        </div>
        <h3 class="mt-4 text-base font-semibold text-foreground">Your handoffs, handled</h3>
        <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
          Handoffs between design, PD, merchandising, TD, and production — where things fall through the cracks. We've mapped every one.
        </p>
      </div>

      <div class="ink-reveal built-for-card" style="--reveal-delay: 400">
        <div class="built-for-icon">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="mt-4 text-base font-semibold text-foreground">Your exceptions, expected</h3>
        <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
          Late shipments, spec changes mid-season, vendor substitutions — the exceptions we built for first.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .built-for-card {
    padding: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid #E8DFD0;
    background: #FAF6F0;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .built-for-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 16px #E8DFD060;
  }

  .built-for-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    background: #3A7D5610;
    color: #3A7D56;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
