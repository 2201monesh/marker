---
const integrations = [
  {
    category: "PLM",
    brands: ["Centric", "Bamboo Rose", "Backbone"],
  },
  {
    category: "ERP",
    brands: ["NetSuite", "SAP", "MS Dynamics 365"],
  },
  {
    category: "Email",
    brands: ["Gmail", "Outlook"],
  },
  {
    category: "Comms",
    brands: ["Slack", "Microsoft Teams"],
  },
  {
    category: "Drives",
    brands: ["Google Drive", "OneDrive", "Dropbox"],
  },
];
---

<section
  class="relative bg-muted bg-paper py-24 md:py-32 mat-bevel"
  aria-labelledby="built-for-heading"
>
  <div class="relative z-10 mx-auto max-w-7xl px-8">
    <div class="max-w-3xl">
      <p
        class="ink-reveal text-xs font-semibold uppercase tracking-[0.12em] text-primary/70 mb-4"
      >
        Domain expertise
      </p>
      <h2
        id="built-for-heading"
        class="ink-reveal text-3xl font-bold tracking-tight text-foreground leading-[1.15] md:text-4xl"
      >
        Built exclusively for retail supply chain teams.
      </h2>
      <p
        class="ink-reveal mt-6 text-muted-foreground md:text-lg leading-relaxed"
        style="--reveal-delay: 120"
      >
        Years inside the systems, handoffs, and exceptions of retail supply chains. Built for the complexity, not around it.
      </p>
    </div>

    <div class="mt-16 md:mt-20">
      <p
        class="ink-reveal text-xs font-semibold uppercase tracking-[0.12em] text-primary/70 mb-8"
        style="--reveal-delay: 200"
      >
        Plays nicely with everything you already use
      </p>
      <div class="ink-reveal integrations-grid" style="--reveal-delay: 300">
        {integrations.map((cat) => (
          <div class="integration-col">
            <p class="integration-category">{cat.category}</p>
            <ul class="integration-brands">
              {cat.brands.map((brand) => (
                <li class="integration-brand">{brand}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p
        class="ink-reveal mt-8 text-sm text-muted-foreground italic"
        style="--reveal-delay: 400"
      >
        …and whatever else your team uses.
      </p>
    </div>
  </div>
</section>

<style>
  .integrations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 2.5rem;
    padding: 2rem 0;
    border-top: 1px solid #e8dfd0;
    border-bottom: 1px solid #e8dfd0;
  }
  @media (min-width: 768px) {
    .integrations-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 0;
    }
    .integration-col + .integration-col {
      border-left: 1px solid #e8dfd0;
      padding-left: 2rem;
    }
  }

  .integration-category {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #7d6b4f;
    margin-bottom: 1rem;
  }

  .integration-brands {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .integration-brand {
    font-size: 0.95rem;
    font-weight: 500;
    color: #2d2418;
    line-height: 1.3;
  }
</style>
