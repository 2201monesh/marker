---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import DoMore from "../components/DoMore.astro";
import SeeMore from "../components/SeeMore.astro";
import ScoreLine from "../components/ScoreLine.astro";
import BuiltForSupplyChain from "../components/BuiltForSupplyChain.astro";
import EnterpriseSecurity from "../components/EnterpriseSecurity.astro";
import WorksWhereYouDo from "../components/WorksWhereYouDo.astro";
import GrainLayer from "../components/GrainLayer.astro";
import NewsletterForm from "../components/NewsletterForm";
import Footer from "../components/Footer.astro";
---

<MarketingLayout title="Marker - Your Always-On Retail Supply Chain Coordinator">
  <Navbar />
  <main id="main-content">
    <div class="relative">
      <GrainLayer />
      <Hero />
    </div>
    <Problem />
    <div class="relative">
      <GrainLayer />
      <DoMore />
      <ScoreLine />
      <SeeMore />
    </div>
    <BuiltForSupplyChain />
    <div class="relative">
      <GrainLayer />
      <EnterpriseSecurity />
    </div>
    <WorksWhereYouDo />
    <div class="relative">
      <GrainLayer />
      <NewsletterForm client:load />
    </div>
  </main>
  <div class="relative">
    <GrainLayer />
    <Footer />
  </div>

</MarketingLayout>
