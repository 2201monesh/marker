---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import WorkflowStrip from "../components/WorkflowStrip.astro";
import SwimLane from "../components/SwimLane.astro";
import BuiltForSupplyChain from "../components/BuiltForSupplyChain.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ScoreLine from "../components/ScoreLine.astro";
import EnterpriseSecurity from "../components/EnterpriseSecurity.astro";
import WorksWhereYouDo from "../components/WorksWhereYouDo.astro";
import GrainLayer from "../components/GrainLayer.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
import Footer from "../components/Footer.astro";
---

<MarketingLayout title="Marker - Your Always-On Retail Supply Chain Coordinator">
  <Navbar />
  <main id="main-content">
    <Hero />
    <Problem />
    <div class="relative">
      <GrainLayer />
      <HowItWorks />
      <ScoreLine />
      <WorkflowStrip />
      <ScoreLine />
      <SwimLane />
    </div>
    <BuiltForSupplyChain />
    <div class="relative">
      <GrainLayer />
      <EnterpriseSecurity />
    </div>
    <WorksWhereYouDo />
    <div class="relative">
      <GrainLayer />
      <ClosingCTA />
    </div>
  </main>
  <Footer />

</MarketingLayout>
