---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import WorkflowStrip from "../components/WorkflowStrip.astro";
import SwimLane from "../components/SwimLane.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
import Footer from "../components/Footer.astro";
---

<MarketingLayout title="Marker - Your Always-On Retail Supply Chain Coordinator">
  <Navbar />
  <main id="main-content">
    <Hero />
    <Problem />
    <WorkflowStrip />
    <SwimLane />
    <HowItWorks />
    <ClosingCTA />
  </main>
  <Footer />
</MarketingLayout>
