---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Hero from "../../components/Hero.astro";
import Credibility from "../../components/Credibility.astro";
import Stakes from "../../components/Stakes.astro";
import WhatWeDo from "../../components/WhatWeDo.astro";
import HowItRuns from "../../components/HowItRuns.astro";
import EndState from "../../components/EndState.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import GrainLayer from "../../components/GrainLayer.astro";
import NewsletterForm from "../../components/NewsletterForm";
import Footer from "../../components/Footer.astro";
---

<MarketingLayout noindex={true} title="Marker - We make enterprises AI-native">
  <Navbar ctaLabel="Book a call" />
  <main id="main-content">
    <div class="relative">
      <GrainLayer />
      <Hero />
    </div>
    <Credibility />
    <div class="relative">
      <GrainLayer />
      <Stakes />
    </div>
    <WhatWeDo />
    <div class="relative">
      <GrainLayer />
      <HowItRuns />
    </div>
    <EndState />
    <FinalCTA />
    <div class="relative">
      <GrainLayer />
      <NewsletterForm client:load />
    </div>
  </main>
  <div class="relative">
    <GrainLayer />
    <Footer />
  </div>

</MarketingLayout>
