---
// Trade show loop — simplified hierarchy
// headline -> green line -> team/company -> subtext (original summary)

function companyTypeFromIndustry(industry: string) {
  if (industry.startsWith("Fortune 500")) return "Fortune 500";
  if (industry.startsWith("DTC")) return "DTC";
  if (industry.startsWith("Multi-Brand")) return "Multi-Brand";
  if (industry.startsWith("Global")) return "Global";
  if (industry.startsWith("Luxury")) return "Luxury";
  if (industry.startsWith("Premium")) return "Premium";
  if (industry.startsWith("Lifestyle")) return "Lifestyle";
  if (industry.startsWith("Office")) return "Office";
  return industry.split(" ")[0] ?? industry;
}

const studies = [
  // Planning & Demand Signals
  { team: "Planning & Demand Signals", industry: "Fortune 500 Automotive", title: "54% turnover.<br>Zero knowledge lost.", summary: "Marker keeps supplier relationships, decisions, and context when team members move on." },

  // Design & Costing
  { team: "Design & Costing", industry: "Premium Menswear", title: "Designers picking $200 fabric<br>for a $50 shirt? Fixed.", summary: "Marker shows cost signals while designs are made, not three rounds of costing later." },
  { team: "Design & Costing", industry: "Premium Activewear", title: "\"Why did that cost go up?\"<br>Finally, an answer.", summary: "Marker tracks every costing round so margin drift is visible, explainable, and actionable." },
  { team: "Design & Costing", industry: "Premium Menswear", title: "Rate card says $12.<br>Quote says $14. Caught.", summary: "Marker checks quotes against rate cards across POs, catching overages before they stack up." },
  { team: "Design & Costing", industry: "Premium Menswear", title: "70 emails a day?<br>Try zero.", summary: "Marker replaces email back-and-forth with shared workflows that keep teams and vendors aligned." },

  // Sourcing & Negotiation
  { team: "Sourcing & Negotiation", industry: "Multi-Brand Apparel", title: "Same supplier, same product,<br>different costs. Busted.", summary: "Marker lets holding companies see cross-brand pricing so they stop bidding against themselves." },
  { team: "Sourcing & Negotiation", industry: "Outdoor Apparel", title: "~50 vendors. Tiny team.<br>No sweat.", summary: "Marker automates follow-ups and status checks so lean teams handle big vendor rosters." },

  // Order Management
  { team: "Order Management", industry: "Multi-Brand Sports Retail", title: "39 adoption meetings.<br>Instant roll-ups for all of them.", summary: "Marker rolls brand-level work into portfolio views so leaders see adoption and risk fast." },
  { team: "Order Management", industry: "DTC Furniture", title: "\"Where's my PO?\"<br>Ask Marker, not the factory.", summary: "Marker tracks POs from issue to delivery so the answer is in one place, not scattered chats." },

  // Production & Delivery
  { team: "Production & Delivery", industry: "Lifestyle Apparel", title: "Half your day, one supplier email.<br>How about half a minute, every supplier email?", summary: "Marker turns long email threads into structured actions so every supplier touch is faster." },
  { team: "Production & Delivery", industry: "Premium Menswear", title: "Ship date moved?<br>Everyone knows. Instantly.", summary: "Marker cascades ship date changes to downstream teams so plans change with reality." },
  { team: "Production & Delivery", industry: "Lifestyle Apparel", title: "Deadlines don't get missed.<br>They get flagged.", summary: "Marker flags at-risk milestones early using real communication, not stale status decks." },
  { team: "Production & Delivery", industry: "DTC Footwear", title: "Shipment slipped. 50k marketing<br>emails already sent. Never again.", summary: "Marker connects production and marketing so campaigns move when ship dates move." },

  // Compliance & Continuous Improvement
  { team: "Compliance & Continuous Improvement", industry: "Fortune 500 Retail", title: "12 tools deployed.<br>Everyone still uses Excel.", summary: "Marker replaces tool sprawl with one system people trust enough to actually adopt." },
  { team: "Compliance & Continuous Improvement", industry: "Global Apparel Manufacturing", title: "Dozens of systems.<br>One workflow.", summary: "Marker unifies work across portals and tools so thin-margin teams stop context switching." },
  { team: "Compliance & Continuous Improvement", industry: "Outdoor Apparel", title: "\"Why was that shipment late?\"<br>Ask Marker, not your team.", summary: "Marker reconstructs the real delivery story from messages so postmortems stop guessing." },
];
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Marker — Trade Show Loop</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --primary: #2e7d57;
      --bg: #ffffff;
      --text: #1a1a1a;
      --text-muted: #6b7280;
      --border: #e5e7eb;
    }
    html, body {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: var(--bg);
      font-family: 'Inter', system-ui, sans-serif;
      color: var(--text);
      cursor: default;
    }
    .scene { position: fixed; inset: 0; }
    .slide {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      opacity: 0;
      transform: scale(0.94);
      transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
                  transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
      padding: 14vh 7vw 0;
    }
    .slide.active { opacity: 1; transform: scale(1); pointer-events: auto; }
    .slide.zoom-out { opacity: 0; transform: scale(1.08); }

    .case-header {
      position: fixed;
      top: 5vh;
      left: 7vw;
      right: 7vw;
      display: flex;
      align-items: baseline;
      gap: 28px;
      z-index: 150;
    }
    .brand-name {
      font-size: clamp(2rem, 5.2vh, 4.75rem);
      font-weight: 700;
      font-style: italic;
      color: var(--text);
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .brand-separator {
      font-size: clamp(1.6rem, 4.4vh, 4rem);
      font-weight: 300;
      color: #c7ccd1;
      line-height: 1;
    }
    .brand-tagline {
      font-size: clamp(1.2rem, 3.3vh, 3rem);
      font-weight: 500;
      color: var(--text);
      letter-spacing: -0.005em;
      line-height: 1;
    }
    .brand-tagline .accent { color: var(--primary); font-weight: 600; }

    .headline {
      font-size: clamp(3rem, min(8.75vw, 9.5vh), 8.44rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.15;
      max-width: 92%;
      margin-bottom: clamp(1.5rem, 5vh, 6rem);
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s 0.25s ease, transform 0.5s 0.25s ease;
    }

    .teamline-row {
      display: flex;
      align-items: center;
      gap: clamp(8px, 1.5vh, 18px);
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s 0.38s ease, transform 0.5s 0.38s ease;
    }

    .greenline {
      width: clamp(28px, 4.5vh, 56px);
      height: 4px;
      background: var(--primary);
      border-radius: 999px;
      flex: 0 0 auto;
    }

    .teamline {
      font-size: clamp(1rem, 3vh, 2.7rem);
      font-weight: 800;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: var(--primary);
      opacity: 1;
      transform: none;
    }

    .teamline-connector {
      font-weight: 500;
      letter-spacing: 0;
      font-size: 0.85em;
      margin: 0 0.2em;
      position: relative;
      top: -0.05em;
    }

    .subtext {
      font-size: 1.8rem;
      color: var(--text-muted);
      line-height: 1.5;
      max-width: 85%;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s 0.5s ease, transform 0.5s 0.5s ease;
    }

    .slide.active .headline,
    .slide.active .teamline-row,
    .slide.active .subtext {
      opacity: 1;
      transform: translateY(0);
    }

    .progress-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      height: 10px;
      background: var(--primary);
      z-index: 100;
      width: 0%;
      transition: none;
    }

    .debug-controls {
      position: fixed;
      left: 50%;
      bottom: 28px;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(14px);
      box-shadow: 0 12px 32px rgba(26, 26, 26, 0.08);
      z-index: 200;
    }
    .debug-button, .debug-status {
      border-radius: 999px;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .debug-button {
      border: 1px solid var(--border);
      background: #fff;
      color: var(--text);
      padding: 10px 16px;
      cursor: pointer;
    }
    .debug-button.is-primary { background: var(--primary); border-color: var(--primary); color: #fff; }
    .debug-status {
      padding: 10px 14px;
      background: rgba(46, 125, 87, 0.08);
      color: var(--primary);
      white-space: nowrap;
    }

    @media (max-width: 1100px) {
      .case-header { left: 24px; right: 24px; }
      .slide { padding: 14vh 24px 0; }
      .subtext { max-width: 100%; }
    }
  </style>
</head>
<body>
  <div class="progress-bar" id="progress"></div>
  <div class="debug-controls">
    <button class="debug-button" id="prevButton" type="button">Prev</button>
    <button class="debug-button is-primary" id="playPauseButton" type="button">Autoplay Off</button>
    <button class="debug-button" id="nextButton" type="button">Next</button>
    <div class="debug-status" id="slideStatus">Slide 1</div>
  </div>

  <div class="case-header">
    <span class="brand-name">marker</span>
    <span class="brand-separator" aria-hidden="true">|</span>
    <span class="brand-tagline">Your always-on <span class="accent">supply chain coordinator</span></span>
  </div>

  <div class="scene">
    {studies.map((study) => {
      const isOrderMultiBrand =
        study.team === "Order Management" && study.industry === "Multi-Brand Sports Retail";
      const isSourcingOutdoor =
        study.team === "Sourcing & Negotiation" && study.industry === "Outdoor Apparel";

      const extraClasses = [
        isOrderMultiBrand ? "slide-order-multi-brand" : "",
        isSourcingOutdoor ? "slide-sourcing-outdoor" : "",
      ]
        .filter(Boolean)
        .join(" ");

      return (
        <div class={`slide${extraClasses ? " " + extraClasses : ""}`} data-duration="6000">
        <h2 class="headline" set:html={study.title} />
        <div class="teamline-row">
          <div class="greenline"></div>
          <div class="teamline">
            {study.team} <span class="teamline-connector">@</span> {study.industry}
          </div>
        </div>
          {/* <p class="subtext">{study.summary}</p> */}
        </div>
      );
    })}
  </div>

  <script>
    const slides = document.querySelectorAll('.slide');
    const progress = document.getElementById('progress');
    const prevButton = document.getElementById('prevButton');
    const nextButton = document.getElementById('nextButton');
    const playPauseButton = document.getElementById('playPauseButton');
    const slideStatus = document.getElementById('slideStatus');
    let current = 0;
    let slideTimer = null;
    let slideDuration = 0;
    let isAutoplayEnabled = false;

    function clearSlideTimer() {
      clearTimeout(slideTimer);
      slideTimer = null;
    }
    function resetProgress() {
      progress.style.transition = 'none';
      progress.style.width = '0%';
      progress.offsetWidth;
    }
    function updateControls() {
      playPauseButton.textContent = isAutoplayEnabled ? 'Autoplay On' : 'Autoplay Off';
      playPauseButton.classList.toggle('is-primary', !isAutoplayEnabled);
      slideStatus.textContent = `Slide ${current + 1} of ${slides.length}`;
    }
    function startAutoplay() {
      slideDuration = parseInt(slides[current].dataset.duration, 10);
      progress.style.transition = `width ${slideDuration}ms linear`;
      progress.style.width = '100%';
      clearSlideTimer();
      slideTimer = setTimeout(() => showSlide((current + 1) % slides.length), slideDuration);
    }
    function showSlide(index) {
      clearSlideTimer();
      slides.forEach((slide, i) => {
        if (i === current && i !== index) {
          slide.classList.remove('active');
          slide.classList.add('zoom-out');
          setTimeout(() => slide.classList.remove('zoom-out'), 700);
        }
      });
      current = index;
      resetProgress();
      setTimeout(() => slides[current].classList.add('active'), 80);
      updateControls();
      if (isAutoplayEnabled) startAutoplay();
    }
    function stepTo(offset) {
      showSlide((current + offset + slides.length) % slides.length);
    }
    function toggleAutoplay() {
      isAutoplayEnabled = !isAutoplayEnabled;
      if (isAutoplayEnabled) startAutoplay();
      else { clearSlideTimer(); resetProgress(); }
      updateControls();
    }
    prevButton.addEventListener('click', () => stepTo(-1));
    nextButton.addEventListener('click', () => stepTo(1));
    playPauseButton.addEventListener('click', toggleAutoplay);
    window.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') stepTo(-1);
      else if (event.key === 'ArrowRight') stepTo(1);
      else if (event.key === ' ' || event.key === 'Spacebar') { event.preventDefault(); toggleAutoplay(); }
    });
    showSlide(0);
  </script>
</body>
</html>
