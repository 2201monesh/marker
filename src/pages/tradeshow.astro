// Trade show loop — simplified hierarchy
// headline -> green line -> team/company -> subtext (original summary)

function companyTypeFromIndustry(industry: string) {
  if (industry.startsWith("Fortune 500")) return "Fortune 500";
  if (industry.startsWith("DTC")) return "DTC";
  if (industry.startsWith("Multi-Brand")) return "Multi-Brand";
  if (industry.startsWith("Global")) return "Global";
  if (industry.startsWith("Luxury")) return "Luxury";
  if (industry.startsWith("Premium")) return "Premium";
  if (industry.startsWith("Lifestyle")) return "Lifestyle";
  if (industry.startsWith("Office")) return "Office";
  return industry.split(" ")[0] ?? industry;
}

const studies = [
  { team: "Planning & Demand Signals", industry: "Global Apparel Manufacturing", title: "\"We're flying blind on demand\" — not anymore", summary: "Marker now surfaces brand demand signals directly to the factory floor, so production financing decisions are backed by real data instead of gut feel and stale spreadsheets." },
  { team: "Planning & Demand Signals", industry: "Fortune 500 Automotive", title: "54% turnover. Zero knowledge lost.", summary: "Marker captures every supplier relationship, negotiation, and decision as it happens — so when people leave, the institutional knowledge stays. $2B in annual spend, fully preserved." },
  { team: "Planning & Demand Signals", industry: "Fortune 500 Retail", title: "No clean data? No problem.", summary: "Marker started delivering value on day one — no six-month data cleanup project required. It builds the data foundation as teams use it, not as a prerequisite." },
  { team: "Supplier Selection & Onboarding", industry: "Lifestyle Apparel", title: "New vendor? Onboarded before lunch.", summary: "Marker auto-maps supplier capabilities, certifications, and capacity from existing communication — turning a weeks-long onboarding scramble into a structured, searchable profile from day one." },
  { team: "Supplier Selection & Onboarding", industry: "Luxury Beauty Retail", title: "Emails in, scorecards out.", summary: "Marker mines every supplier interaction — responsiveness, follow-through, commitment accuracy — and builds live scorecards automatically. Compliance finally has structured data without chasing anyone." },
  { team: "Supplier Selection & Onboarding", industry: "DTC Furniture", title: "\"They said Thursday.\" Now there's a receipt.", summary: "Marker timestamps and logs every vendor commitment, date change, and term shift. When tariffs forced re-sourcing, the team had hard data on who delivers and who doesn't." },
  { team: "Design & Costing", industry: "Premium Menswear", title: "Designers picking $200 fabric for a $50 shirt? Fixed.", summary: "Marker puts cost data in front of designers at the moment of fabric selection — killing unviable styles early instead of after three rounds of costing theater." },
  { team: "Design & Costing", industry: "Premium Activewear", title: "\"Why did that cost go up?\" Finally, an answer.", summary: "Marker tracks every costing round across ~50 vendors and multiple seasons, revealing pricing drift before it eats your margins. No more guessing from email timestamps." },
  { team: "Design & Costing", industry: "Premium Menswear", title: "Rate card says $12. Quote says $14. Caught.", summary: "Marker auto-validates supplier quotes against contracted rate cards across hundreds of POs — catching the small overcharges that compound into serious margin leakage at ~70% margins." },
  { team: "Design & Costing", industry: "Premium Menswear", title: "70 emails a day? Try zero.", summary: "Marker replaced 70-80 daily supplier emails with structured workflows and internal collaboration threads — so the team reviews and responds together instead of playing broken telephone." },
  { team: "Sourcing & Negotiation", industry: "Fortune 500 Retail", title: "Same company. Five RFQ systems. Now one.", summary: "Marker unified RFQ workflows across every division into a single platform — so associates stop toggling between disconnected tools and actually see the full sourcing picture." },
  { team: "Sourcing & Negotiation", industry: "Multi-Brand Apparel", title: "Two brands. Same factory. Different prices. Busted.", summary: "Marker gives the holding company a unified view across 5+ acquired brands — so they negotiate as one portfolio instead of accidentally bidding against themselves." },
  { team: "Sourcing & Negotiation", industry: "Outdoor Apparel", title: "~50 vendors. Tiny team. No sweat.", summary: "Marker automates the follow-ups, status checks, and coordination overhead across email, WhatsApp, and Slack — so a lean sourcing team punches way above its weight." },
  { team: "Sourcing & Negotiation", industry: "Premium Activewear", title: "Startup speed, enterprise infrastructure.", summary: "Marker gave a fast-growing brand real sourcing infrastructure from the start — without the bloated systems, migration headaches, and process debt that slow down the incumbents." },
  { team: "Order Management", industry: "Office & Business Supply Chain", title: "\"Every customer emails orders differently.\" Solved.", summary: "Marker parses unstructured email orders across 50 fulfillment centers — every format, every customer — into clean, actionable data that flows straight into OMS and WMS." },
  { team: "Order Management", industry: "Multi-Brand Sports Retail", title: "560 budget meetings. Zero spreadsheet errors.", summary: "Marker replaced the manual Excel gauntlet across 20 brands with automated reconciliation — eliminating the copy-paste errors that compounded across seasons and cost real money." },
  { team: "Order Management", industry: "DTC Furniture", title: "\"Where's my PO?\" Ask Marker, not the factory.", summary: "Marker auto-tracks every PO from issue to delivery — pulling status updates from factory communication so the team sees a live dashboard instead of chasing WhatsApp threads." },
  { team: "Order Management", industry: "DTC Footwear", title: "Your analysts have better things to do.", summary: "Marker automated invoice reconciliation, payment tracking, and return processing — freeing supply chain analysts to finally spend their days on cost optimization and vendor strategy." },
  { team: "Production & Delivery", industry: "Premium Menswear", title: "Ship date moved? Everyone knows. Instantly.", summary: "Marker auto-cascades every ship date change to logistics, merchants, and marketing in real time — no more manually forwarded emails that arrive after downstream teams have already planned around the old date." },
  { team: "Production & Delivery", industry: "Lifestyle Apparel", title: "Deadlines don't get missed. They get flagged.", summary: "Marker connects communication history to every milestone across a multi-quarter calendar — surfacing at-risk deadlines before they're missed, not after." },
  { team: "Production & Delivery", industry: "DTC Footwear", title: "WeChat. WhatsApp. Email. One timeline.", summary: "Marker pulls 50+ scattered message threads into a single, searchable supplier timeline — so critical material updates and ship dates never get lost between channels again." },
  { team: "Compliance & Continuous Improvement", industry: "Luxury Beauty Retail", title: "Compliance and sourcing, finally in the same room.", summary: "Marker links audit findings directly to sourcing workflows — so risk information reaches decision-makers in context and on time, not as a disconnected PDF three weeks later." },
  { team: "Compliance & Continuous Improvement", industry: "Fortune 500 Retail", title: "12 tools deployed. Everyone still uses Excel.", summary: "Marker replaced the tool sprawl with one transparent platform that shows its work — so associates actually adopted it instead of defaulting back to the spreadsheet they trust." },
  { team: "Compliance & Continuous Improvement", industry: "Global Apparel Manufacturing", title: "Dozens of brand portals. One workflow.", summary: "Marker replaced the daily portal-hopping across dozens of brand PLMs with communication-first workflows — giving thin-margin manufacturers their time back where it matters most." },
  { team: "Compliance & Continuous Improvement", industry: "Outdoor Apparel", title: "\"Why was that shipment late?\" Receipts included.", summary: "Marker auto-generates end-of-season hindsight reports from real communication data — replacing memory-and-anecdote postmortems with timestamped, searchable delivery timelines." },
];
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Marker — Trade Show Loop</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --primary: #2e7d57;
      --bg: #ffffff;
      --text: #1a1a1a;
      --text-muted: #6b7280;
      --border: #e5e7eb;
    }
    html, body {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: var(--bg);
      font-family: 'Inter', system-ui, sans-serif;
      color: var(--text);
      cursor: default;
    }
    .scene { position: fixed; inset: 0; }
    .slide {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      opacity: 0;
      transform: scale(0.94);
      transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
                  transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
      padding: 48px 7vw 64px;
    }
    .slide.active { opacity: 1; transform: scale(1); pointer-events: auto; }
    .slide.zoom-out { opacity: 0; transform: scale(1.08); }

    .case-header {
      position: absolute;
      top: 36px;
      left: 7vw;
      right: 7vw;
      display: flex;
      align-items: center;
      gap: 18px;
    }
    .brand-logo { height: 40px; width: auto; filter: brightness(0); }
    .brand-tagline { font-size: 1.15rem; font-weight: 500; color: var(--text-muted); letter-spacing: -0.01em; }
    .brand-tagline .accent { color: var(--primary); }

    .headline {
      font-size: clamp(4rem, 7vw, 6.75rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.02;
      max-width: 92%;
      margin-bottom: 22px;
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s 0.25s ease, transform 0.5s 0.25s ease;
    }

    .greenline {
      width: 88px;
      height: 6px;
      background: var(--primary);
      border-radius: 999px;
      margin-bottom: 18px;
      opacity: 0;
      transform: scaleX(0);
      transform-origin: left;
      transition: opacity 0.4s 0.15s ease, transform 0.4s 0.15s ease;
    }

    .teamline {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--primary);
      margin-bottom: 16px;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s 0.38s ease, transform 0.5s 0.38s ease;
    }

    .subtext {
      font-size: 1.8rem;
      color: var(--text-muted);
      line-height: 1.5;
      max-width: 85%;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s 0.5s ease, transform 0.5s 0.5s ease;
    }

    .slide.active .headline,
    .slide.active .teamline,
    .slide.active .subtext {
      opacity: 1;
      transform: translateY(0);
    }
    .slide.active .greenline {
      opacity: 1;
      transform: scaleX(1);
    }

    .progress-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      height: 10px;
      background: var(--primary);
      z-index: 100;
      width: 0%;
      transition: none;
    }

    .debug-controls {
      position: fixed;
      left: 50%;
      bottom: 28px;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(14px);
      box-shadow: 0 12px 32px rgba(26, 26, 26, 0.08);
      z-index: 200;
    }
    .debug-button, .debug-status {
      border-radius: 999px;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .debug-button {
      border: 1px solid var(--border);
      background: #fff;
      color: var(--text);
      padding: 10px 16px;
      cursor: pointer;
    }
    .debug-button.is-primary { background: var(--primary); border-color: var(--primary); color: #fff; }
    .debug-status {
      padding: 10px 14px;
      background: rgba(46, 125, 87, 0.08);
      color: var(--primary);
      white-space: nowrap;
    }

    @media (max-width: 1100px) {
      .case-header { top: 28px; left: 40px; right: 40px; }
      .slide { padding: 44px 40px 52px; }
      .brand-logo { height: 32px; }
      .brand-tagline { font-size: 1rem; }
      .teamline { font-size: 1.05rem; }
      .subtext { font-size: 1.2rem; max-width: 100%; }
    }
  </style>
</head>
<body>
  <div class="progress-bar" id="progress"></div>
  <div class="debug-controls">
    <button class="debug-button" id="prevButton" type="button">Prev</button>
    <button class="debug-button is-primary" id="playPauseButton" type="button">Autoplay Off</button>
    <button class="debug-button" id="nextButton" type="button">Next</button>
    <div class="debug-status" id="slideStatus">Slide 1</div>
  </div>

  <div class="scene">
    {studies.map((study) => (
      <div class="slide" data-duration="9750">
        <div class="case-header">
          <img src="/logo.png" alt="Marker" class="brand-logo" />
          <span class="brand-tagline">Your always-on <span class="accent">supply chain coordinator</span></span>
        </div>
        <h2 class="headline">{study.title}</h2>
        <div class="greenline"></div>
        <div class="teamline">{study.team} | {companyTypeFromIndustry(study.industry)}</div>
        <p class="subtext">{study.summary}</p>
      </div>
    ))}
  </div>

  <script>
    const slides = document.querySelectorAll('.slide');
    const progress = document.getElementById('progress');
    const prevButton = document.getElementById('prevButton');
    const nextButton = document.getElementById('nextButton');
    const playPauseButton = document.getElementById('playPauseButton');
    const slideStatus = document.getElementById('slideStatus');
    let current = 0;
    let slideTimer = null;
    let slideDuration = 0;
    let isAutoplayEnabled = false;

    function clearSlideTimer() {
      clearTimeout(slideTimer);
      slideTimer = null;
    }
    function resetProgress() {
      progress.style.transition = 'none';
      progress.style.width = '0%';
      progress.offsetWidth;
    }
    function updateControls() {
      playPauseButton.textContent = isAutoplayEnabled ? 'Autoplay On' : 'Autoplay Off';
      playPauseButton.classList.toggle('is-primary', !isAutoplayEnabled);
      slideStatus.textContent = `Slide ${current + 1} of ${slides.length}`;
    }
    function startAutoplay() {
      slideDuration = parseInt(slides[current].dataset.duration, 10);
      progress.style.transition = `width ${slideDuration}ms linear`;
      progress.style.width = '100%';
      clearSlideTimer();
      slideTimer = setTimeout(() => showSlide((current + 1) % slides.length), slideDuration);
    }
    function showSlide(index) {
      clearSlideTimer();
      slides.forEach((slide, i) => {
        if (i === current && i !== index) {
          slide.classList.remove('active');
          slide.classList.add('zoom-out');
          setTimeout(() => slide.classList.remove('zoom-out'), 700);
        }
      });
      current = index;
      resetProgress();
      setTimeout(() => slides[current].classList.add('active'), 80);
      updateControls();
      if (isAutoplayEnabled) startAutoplay();
    }
    function stepTo(offset) {
      showSlide((current + offset + slides.length) % slides.length);
    }
    function toggleAutoplay() {
      isAutoplayEnabled = !isAutoplayEnabled;
      if (isAutoplayEnabled) startAutoplay();
      else { clearSlideTimer(); resetProgress(); }
      updateControls();
    }
    prevButton.addEventListener('click', () => stepTo(-1));
    nextButton.addEventListener('click', () => stepTo(1));
    playPauseButton.addEventListener('click', toggleAutoplay);
    window.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') stepTo(-1);
      else if (event.key === 'ArrowRight') stepTo(1);
      else if (event.key === ' ' || event.key === 'Spacebar') { event.preventDefault(); toggleAutoplay(); }
    });
    showSlide(0);
  </script>
</body>
</html>
