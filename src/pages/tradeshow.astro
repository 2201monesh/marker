---
// Trade show marketing loop — auto-playing animation
// Designed for 27" booth display at Shoptalk 2026
// Light theme matching marker-site brand
// Logo + tagline interstitial every 5 case study slides

const studies = [
  // Phase 1: Planning & Demand Signals
  { phase: 1, phaseName: "Planning & Demand Signals", industry: "Global Apparel Manufacturing", title: "\"We're flying blind on demand\" — not anymore", summary: "Marker now surfaces brand demand signals directly to the factory floor, so production financing decisions are backed by real data instead of gut feel and stale spreadsheets." },
  { phase: 1, phaseName: "Planning & Demand Signals", industry: "Fortune 500 Automotive", title: "54% turnover. Zero knowledge lost.", summary: "Marker captures every supplier relationship, negotiation, and decision as it happens — so when people leave, the institutional knowledge stays. $2B in annual spend, fully preserved." },
  { phase: 1, phaseName: "Planning & Demand Signals", industry: "Fortune 500 Retail", title: "No clean data? No problem.", summary: "Marker started delivering value on day one — no six-month data cleanup project required. It builds the data foundation as teams use it, not as a prerequisite." },
  // Phase 2: Supplier Selection & Onboarding
  { phase: 2, phaseName: "Supplier Selection & Onboarding", industry: "Lifestyle Apparel", title: "New vendor? Onboarded before lunch.", summary: "Marker auto-maps supplier capabilities, certifications, and capacity from existing communication — turning a weeks-long onboarding scramble into a structured, searchable profile from day one." },
  { phase: 2, phaseName: "Supplier Selection & Onboarding", industry: "Luxury Beauty Retail", title: "Emails in, scorecards out.", summary: "Marker mines every supplier interaction — responsiveness, follow-through, commitment accuracy — and builds live scorecards automatically. Compliance finally has structured data without chasing anyone." },
  { phase: 2, phaseName: "Supplier Selection & Onboarding", industry: "DTC Furniture", title: "\"They said Thursday.\" Now there's a receipt.", summary: "Marker timestamps and logs every vendor commitment, date change, and term shift. When tariffs forced re-sourcing, the team had hard data on who delivers and who doesn't." },
  // Phase 3: Design & Costing
  { phase: 3, phaseName: "Design & Costing", industry: "Premium Menswear", title: "Designers picking $200 fabric for a $50 shirt? Fixed.", summary: "Marker puts cost data in front of designers at the moment of fabric selection — killing unviable styles early instead of after three rounds of costing theater." },
  { phase: 3, phaseName: "Design & Costing", industry: "Premium Activewear", title: "\"Why did that cost go up?\" Finally, an answer.", summary: "Marker tracks every costing round across ~50 vendors and multiple seasons, revealing pricing drift before it eats your margins. No more guessing from email timestamps." },
  { phase: 3, phaseName: "Design & Costing", industry: "Premium Menswear", title: "Rate card says $12. Quote says $14. Caught.", summary: "Marker auto-validates supplier quotes against contracted rate cards across hundreds of POs — catching the small overcharges that compound into serious margin leakage at ~70% margins." },
  { phase: 3, phaseName: "Design & Costing", industry: "Premium Menswear", title: "70 emails a day? Try zero.", summary: "Marker replaced 70-80 daily supplier emails with structured workflows and internal collaboration threads — so the team reviews and responds together instead of playing broken telephone." },
  // Phase 4: Sourcing & Negotiation
  { phase: 4, phaseName: "Sourcing & Negotiation", industry: "Fortune 500 Retail", title: "Same company. Five RFQ systems. Now one.", summary: "Marker unified RFQ workflows across every division into a single platform — so associates stop toggling between disconnected tools and actually see the full sourcing picture." },
  { phase: 4, phaseName: "Sourcing & Negotiation", industry: "Multi-Brand Apparel", title: "Two brands. Same factory. Different prices. Busted.", summary: "Marker gives the holding company a unified view across 5+ acquired brands — so they negotiate as one portfolio instead of accidentally bidding against themselves." },
  { phase: 4, phaseName: "Sourcing & Negotiation", industry: "Outdoor Apparel", title: "~50 vendors. Tiny team. No sweat.", summary: "Marker automates the follow-ups, status checks, and coordination overhead across email, WhatsApp, and Slack — so a lean sourcing team punches way above its weight." },
  { phase: 4, phaseName: "Sourcing & Negotiation", industry: "Premium Activewear", title: "Startup speed, enterprise infrastructure.", summary: "Marker gave a fast-growing brand real sourcing infrastructure from the start — without the bloated systems, migration headaches, and process debt that slow down the incumbents." },
  { phase: 5, phaseName: "Order Management", industry: "Office & Business Supply Chain", title: "\"Every customer emails orders differently.\" Solved.", summary: "Marker parses unstructured email orders across 50 fulfillment centers — every format, every customer — into clean, actionable data that flows straight into OMS and WMS." },
  // Phase 5 cont'd
  { phase: 5, phaseName: "Order Management", industry: "Multi-Brand Sports Retail", title: "560 budget meetings. Zero spreadsheet errors.", summary: "Marker replaced the manual Excel gauntlet across 20 brands with automated reconciliation — eliminating the copy-paste errors that compounded across seasons and cost real money." },
  { phase: 5, phaseName: "Order Management", industry: "DTC Furniture", title: "\"Where's my PO?\" Ask Marker, not the factory.", summary: "Marker auto-tracks every PO from issue to delivery — pulling status updates from factory communication so the team sees a live dashboard instead of chasing WhatsApp threads." },
  { phase: 5, phaseName: "Order Management", industry: "DTC Footwear", title: "Your analysts have better things to do.", summary: "Marker automated invoice reconciliation, payment tracking, and return processing — freeing supply chain analysts to finally spend their days on cost optimization and vendor strategy." },
  // Phase 6: Production & Delivery
  { phase: 6, phaseName: "Production & Delivery", industry: "Premium Menswear", title: "Ship date moved? Everyone knows. Instantly.", summary: "Marker auto-cascades every ship date change to logistics, merchants, and marketing in real time — no more manually forwarded emails that arrive after downstream teams have already planned around the old date." },
  { phase: 6, phaseName: "Production & Delivery", industry: "Lifestyle Apparel", title: "Deadlines don't get missed. They get flagged.", summary: "Marker connects communication history to every milestone across a multi-quarter calendar — surfacing at-risk deadlines before they're missed, not after." },
  { phase: 6, phaseName: "Production & Delivery", industry: "DTC Footwear", title: "WeChat. WhatsApp. Email. One timeline.", summary: "Marker pulls 50+ scattered message threads into a single, searchable supplier timeline — so critical material updates and ship dates never get lost between channels again." },
  // Phase 7: Compliance & Continuous Improvement
  { phase: 7, phaseName: "Compliance & Continuous Improvement", industry: "Luxury Beauty Retail", title: "Compliance and sourcing, finally in the same room.", summary: "Marker links audit findings directly to sourcing workflows — so risk information reaches decision-makers in context and on time, not as a disconnected PDF three weeks later." },
  { phase: 7, phaseName: "Compliance & Continuous Improvement", industry: "Fortune 500 Retail", title: "12 tools deployed. Everyone still uses Excel.", summary: "Marker replaced the tool sprawl with one transparent platform that shows its work — so associates actually adopted it instead of defaulting back to the spreadsheet they trust." },
  { phase: 7, phaseName: "Compliance & Continuous Improvement", industry: "Global Apparel Manufacturing", title: "Dozens of brand portals. One workflow.", summary: "Marker replaced the daily portal-hopping across dozens of brand PLMs with communication-first workflows — giving thin-margin manufacturers their time back where it matters most." },
  { phase: 7, phaseName: "Compliance & Continuous Improvement", industry: "Outdoor Apparel", title: "\"Why was that shipment late?\" Receipts included.", summary: "Marker auto-generates end-of-season hindsight reports from real communication data — replacing memory-and-anecdote postmortems with timestamped, searchable delivery timelines." },
];
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Marker — Trade Show Loop</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --primary: #2e7d57;
      --bg: #ffffff;
      --bg-muted: #f9fafb;
      --text: #1a1a1a;
      --text-muted: #6b7280;
      --border: #e5e7eb;
    }

    html, body {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: var(--bg);
      font-family: 'Inter', system-ui, sans-serif;
      color: var(--text);
      cursor: none;
    }

    .scene { position: fixed; inset: 0; }

    .slide {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transform: scale(0.94);
      transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
                  transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
      padding: 48px 80px;
    }

    .slide.active {
      opacity: 1;
      transform: scale(1);
      pointer-events: auto;
    }

    .slide.zoom-out {
      opacity: 0;
      transform: scale(1.08);
    }

    /* ── Logo slides ── */
    .logo-slide { gap: 36px; background: var(--bg); }

    .logo-img { height: 80px; width: auto; filter: brightness(0); }

    .tagline {
      font-size: 4.5rem; /* scaled up from Hero lg:text-6xl for booth visibility */
      font-weight: 700; /* matches font-bold from Hero */
      letter-spacing: -0.025em; /* matches tracking-tight */
      line-height: 1.1;
      text-align: center;
      color: var(--text);
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.6s 0.3s ease, transform 0.6s 0.3s ease;
    }
    .tagline .accent {
      color: var(--primary);
    }
    .slide.active .tagline { opacity: 1; transform: translateY(0); }

    .shoptalk-badge {
      position: absolute;
      bottom: 48px;
      font-size: 1.05rem;
      color: var(--text-muted);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      opacity: 0;
      transition: opacity 0.6s 0.8s ease;
    }
    .slide.active .shoptalk-badge { opacity: 1; }

    .lifecycle-hint {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-top: 24px;
      opacity: 0;
      transition: opacity 0.6s 1s ease;
    }
    .slide.active .lifecycle-hint { opacity: 1; }

    .lifecycle-dot {
      width: 10px; height: 10px;
      border-radius: 50%;
      background: var(--primary);
    }
    .lifecycle-dot:nth-child(1) { opacity: 0.15; }
    .lifecycle-dot:nth-child(2) { opacity: 0.25; }
    .lifecycle-dot:nth-child(3) { opacity: 0.4; }
    .lifecycle-dot:nth-child(4) { opacity: 0.55; }
    .lifecycle-dot:nth-child(5) { opacity: 0.7; }
    .lifecycle-dot:nth-child(6) { opacity: 0.85; }
    .lifecycle-dot:nth-child(7) { opacity: 1; }

    /* ── Ambient decoration ── */
    .bg-circle {
      position: fixed;
      border-radius: 50%;
      pointer-events: none;
      z-index: -1;
    }
    .bg-circle-1 {
      width: 500px; height: 500px;
      top: -180px; right: -120px;
      background: radial-gradient(circle, rgba(46,125,87,0.06) 0%, transparent 70%);
      animation: drift1 22s ease-in-out infinite;
    }
    .bg-circle-2 {
      width: 400px; height: 400px;
      bottom: -150px; left: -100px;
      background: radial-gradient(circle, rgba(46,125,87,0.05) 0%, transparent 70%);
      animation: drift2 26s ease-in-out infinite;
    }
    @keyframes drift1 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(-40px, 30px); }
    }
    @keyframes drift2 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(30px, -40px); }
    }

    /* ── Case study slides ── */
    .case-slide {
      text-align: left;
      align-items: flex-start;
      justify-content: center;
      padding: 0 7vw 40px;
      gap: 0;
    }

    .corner-bar {
      position: absolute;
      top: 0; left: 0; right: 0;
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 32px 40px;
    }

    .corner-logo {
      height: 48px;
      filter: brightness(0); /* force black */
    }

    .corner-tagline {
      font-size: 1.2rem;
      font-weight: 500;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    .corner-tagline .accent {
      color: var(--primary);
    }

    .case-meta {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 28px;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s 0.15s ease, transform 0.5s 0.15s ease;
    }

    .phase-badge {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .phase-number {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px; height: 48px;
      border-radius: 50%;
      background: var(--primary);
      color: #fff;
      font-size: 1.1rem;
      font-weight: 700;
      flex-shrink: 0;
    }

    .phase-name {
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--primary);
    }

    .meta-divider {
      width: 1px;
      height: 28px;
      background: var(--border);
    }

    .industry-tag {
      display: inline-block;
      padding: 6px 18px;
      background: var(--bg-muted);
      border: 1px solid var(--border);
      border-radius: 100px;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .case-title {
      font-size: 5rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.08;
      color: var(--text);
      max-width: 95%;
      margin-bottom: 36px;
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s 0.3s ease, transform 0.5s 0.3s ease;
    }

    .case-summary {
      font-size: 1.8rem;
      color: var(--text-muted);
      line-height: 1.5;
      max-width: 85%;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s 0.5s ease, transform 0.5s 0.5s ease;
    }

    .case-accent-line {
      width: 64px;
      height: 4px;
      background: var(--primary);
      border-radius: 2px;
      margin-bottom: 28px;
      opacity: 0;
      transform: scaleX(0);
      transform-origin: left;
      transition: opacity 0.4s 0.25s ease, transform 0.4s 0.25s ease;
    }

    .slide.active .case-meta,
    .slide.active .case-title,
    .slide.active .case-summary {
      opacity: 1;
      transform: translateY(0);
    }

    .slide.active .case-accent-line {
      opacity: 1;
      transform: scaleX(1);
    }

    /* ── Counter ── */
    .slide-counter {
      position: absolute;
      bottom: 44px;
      right: 48px;
      font-size: 1rem;
      font-weight: 500;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      opacity: 0;
      transition: opacity 0.5s 0.6s ease;
    }
    .slide.active .slide-counter { opacity: 1; }

    /* ── Progress bar ── */
    .progress-bar {
      position: fixed;
      bottom: 0; left: 0;
      height: 10px;
      background: var(--primary);
      z-index: 100;
      width: 0%;
      transition: none;
    }

    /* ── Dot nav ── */
    .dot-nav {
      position: fixed;
      right: 28px;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 100;
    }

    .dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--border);
      transition: background 0.4s ease, transform 0.4s ease;
    }
    .dot.active {
      background: var(--primary);
      transform: scale(1.5);
    }
    .dot.is-logo {
      width: 8px; height: 8px;
      border-radius: 2px;
    }
  </style>
</head>
<body>
  <div class="bg-circle bg-circle-1"></div>
  <div class="bg-circle bg-circle-2"></div>
  <div class="progress-bar" id="progress"></div>
  <div class="dot-nav" id="dotNav"></div>

  <div class="scene">
    <!-- Opening logo -->
    <div class="slide logo-slide" data-duration="7500" data-type="logo">
      <img src="/logo.png" alt="Marker" class="logo-img" />
      <div class="tagline">Your always-on<br /><span class="accent">supply chain coordinator</span></div>
      <div class="lifecycle-hint">
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
      </div>
      <div class="shoptalk-badge">Shoptalk 2026 &bull; Las Vegas</div>
    </div>

    {studies.map((study, i) => (
      <>
        <div class="slide case-slide" data-duration="9750">
          <div class="corner-bar">
            <img src="/logo.png" alt="Marker" class="corner-logo" />
            <span class="corner-tagline">Your always-on <span class="accent">supply chain coordinator</span></span>
          </div>
          <div class="case-meta">
            <div class="phase-badge">
              <div class="phase-number">{study.phase}</div>
              <span class="phase-name">{study.phaseName}</span>
            </div>
            <div class="meta-divider"></div>
            <span class="industry-tag">{study.industry}</span>
          </div>
          <div class="case-accent-line"></div>
          <h2 class="case-title">{study.title}</h2>
          <p class="case-summary">{study.summary}</p>
          <div class="slide-counter">{i + 1} / {studies.length}</div>
        </div>

        {/* Insert logo interstitial after every 5th case study (but not after the last one) */}
        {((i + 1) % 5 === 0 && i < studies.length - 1) && (
          <div class="slide logo-slide" data-duration="6000" data-type="logo">
            <img src="/logo.png" alt="Marker" class="logo-img" />
            <div class="tagline">Your always-on<br /><span class="accent">supply chain coordinator</span></div>
            <div class="lifecycle-hint">
              <div class="lifecycle-dot"></div>
              <div class="lifecycle-dot"></div>
              <div class="lifecycle-dot"></div>
              <div class="lifecycle-dot"></div>
              <div class="lifecycle-dot"></div>
              <div class="lifecycle-dot"></div>
              <div class="lifecycle-dot"></div>
            </div>
            <div class="shoptalk-badge">Shoptalk 2026 &bull; Las Vegas</div>
          </div>
        )}
      </>
    ))}

    <!-- Closing logo -->
    <div class="slide logo-slide" data-duration="7500" data-type="logo">
      <img src="/logo.png" alt="Marker" class="logo-img" />
      <div class="tagline">Your always-on<br /><span class="accent">supply chain coordinator</span></div>
      <div class="lifecycle-hint">
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
        <div class="lifecycle-dot"></div>
      </div>
      <div class="shoptalk-badge">Visit us &bull; Shoptalk 2026 &bull; Las Vegas</div>
    </div>
  </div>

  <script>
    const slides = document.querySelectorAll('.slide');
    const progress = document.getElementById('progress');
    const dotNav = document.getElementById('dotNav');
    let current = 0;
    let slideTimer = null;
    let slideStart = 0;
    let slideDuration = 0;
    let rafId = null;

    // Create dots
    slides.forEach((s) => {
      const dot = document.createElement('div');
      dot.className = 'dot' + (s.dataset.type === 'logo' ? ' is-logo' : '');
      dotNav.appendChild(dot);
    });
    const dots = dotNav.querySelectorAll('.dot');

    function showSlide(index) {
      slides.forEach((s, i) => {
        if (i === current && i !== index) {
          s.classList.remove('active');
          s.classList.add('zoom-out');
          setTimeout(() => s.classList.remove('zoom-out'), 700);
        }
      });

      current = index;

      // Reset progress bar instantly, then animate
      progress.style.transition = 'none';
      progress.style.width = '0%';
      // Force reflow so the reset takes effect before the transition starts
      progress.offsetWidth;

      slideDuration = parseInt(slides[current].dataset.duration, 10);
      progress.style.transition = `width ${slideDuration}ms linear`;
      progress.style.width = '100%';

      setTimeout(() => {
        slides[current].classList.add('active');
      }, 80);

      dots.forEach((d, i) => d.classList.toggle('active', i === current));

      clearTimeout(slideTimer);
      slideTimer = setTimeout(() => {
        const next = (current + 1) % slides.length;
        showSlide(next);
      }, slideDuration);
    }

    showSlide(0);
  </script>
</body>
</html>
