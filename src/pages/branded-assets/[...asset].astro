---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import BusinessCardStudio from "../../components/BusinessCardStudio";
import ConferencePostcardStudio from "../../components/ConferencePostcardStudio";
import { readFileSync } from "node:fs";

const ASSETS = [
  {
    slug: "business-card",
    title: "Business Card",
    description: "Will and Richard business card front and back exports.",
  },
  {
    slug: "conference-postcard",
    title: "Conference Postcard",
    description: "Postcard-size conference handout front and back exports.",
  },
] as const;

export function getStaticPaths() {
  if (process.env.NODE_ENV !== "development") return [];

  const assetSlugs = ["business-card", "conference-postcard"];

  return [
    { params: { asset: undefined } },
    ...assetSlugs.map((asset) => ({ params: { asset } })),
  ];
}

const asset = Astro.params.asset;
const isIndex = !asset;
const isKnownAsset =
  asset === "business-card" || asset === "conference-postcard";
const businessCardGuideSrc = `data:image/jpeg;base64,${readFileSync(
  new URL(
    "../../../.context/attachments/US Sized Business Cards-Square-Landscape-Artwork Guidelines.jpg",
    import.meta.url
  )
).toString("base64")}`;
const postcardGuideSrc = `data:image/jpeg;base64,${readFileSync(
  new URL(
    "../../../.context/attachments/Standard Postcard-Landscape-Artwork Guidelines.jpg",
    import.meta.url
  )
).toString("base64")}`;
---

<Layout title="Marker Branded Assets" noindex fontSource="local">
  <Navbar />
  <main id="main-content">
    {!isIndex && isKnownAsset ? (
      <section class="mx-auto max-w-7xl px-6 pt-8 md:pt-10">
        <a
          href="/branded-assets"
          class="inline-flex items-center rounded-full border border-border bg-white px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary/40 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          Back to Branded Assets
        </a>
      </section>
    ) : null}
    {isIndex ? (
      <section class="mx-auto max-w-5xl px-6 py-16 md:py-20">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-primary">
            Branded Assets
          </p>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-foreground md:text-5xl">
            Local-only asset pages for print and conference materials.
          </h1>
          <p class="mt-5 text-lg text-muted-foreground md:text-xl">
            These pages are available during local development and intentionally
            excluded from production builds.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {ASSETS.map((entry) => (
            <a
              href={`/branded-assets/${entry.slug}`}
              class="rounded-[24px] border border-border bg-white p-6 transition-colors hover:border-primary/40 hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
                Asset
              </p>
              <h2 class="mt-3 text-2xl font-semibold tracking-tight text-foreground">
                {entry.title}
              </h2>
              <p class="mt-3 text-base text-muted-foreground">
                {entry.description}
              </p>
            </a>
          ))}
        </div>
      </section>
    ) : asset === "business-card" ? (
      <BusinessCardStudio client:load mooGuideSrc={businessCardGuideSrc} />
    ) : asset === "conference-postcard" ? (
      <ConferencePostcardStudio client:load mooGuideSrc={postcardGuideSrc} />
    ) : (
      <section class="mx-auto max-w-4xl px-6 py-16 md:py-20">
        <h1 class="text-3xl font-bold tracking-tight text-foreground">
          Asset not found
        </h1>
      </section>
    )}
  </main>
  <Footer />
</Layout>
