// Trade show marketing loop — original imported version (with debug controls)
// Designed for booth display; includes manual navigation + optional autoplay.

const studies = [
  // Phase 1: Planning & Demand Signals
  { phaseName: "Planning & Demand Signals", industry: "Global Apparel Manufacturing", title: "\"We're flying blind on demand\" — not anymore", summary: "Marker now surfaces brand demand signals directly to the factory floor, so production financing decisions are backed by real data instead of gut feel and stale spreadsheets." },
  { phaseName: "Planning & Demand Signals", industry: "Fortune 500 Automotive", title: "54% turnover. Zero knowledge lost.", summary: "Marker captures every supplier relationship, negotiation, and decision as it happens — so when people leave, the institutional knowledge stays. $2B in annual spend, fully preserved." },
  { phaseName: "Planning & Demand Signals", industry: "Fortune 500 Retail", title: "No clean data? No problem.", summary: "Marker started delivering value on day one — no six-month data cleanup project required. It builds the data foundation as teams use it, not as a prerequisite." },
  // Phase 2: Supplier Selection & Onboarding
  { phaseName: "Supplier Selection & Onboarding", industry: "Lifestyle Apparel", title: "New vendor? Onboarded before lunch.", summary: "Marker auto-maps supplier capabilities, certifications, and capacity from existing communication — turning a weeks-long onboarding scramble into a structured, searchable profile from day one." },
  { phaseName: "Supplier Selection & Onboarding", industry: "Luxury Beauty Retail", title: "Emails in, scorecards out.", summary: "Marker mines every supplier interaction — responsiveness, follow-through, commitment accuracy — and builds live scorecards automatically. Compliance finally has structured data without chasing anyone." },
  { phaseName: "Supplier Selection & Onboarding", industry: "DTC Furniture", title: "\"They said Thursday.\" Now there's a receipt.", summary: "Marker timestamps and logs every vendor commitment, date change, and term shift. When tariffs forced re-sourcing, the team had hard data on who delivers and who doesn't." },
  // Phase 3: Design & Costing
  { phaseName: "Design & Costing", industry: "Premium Menswear", title: "Designers picking $200 fabric for a $50 shirt? Fixed.", summary: "Marker puts cost data in front of designers at the moment of fabric selection — killing unviable styles early instead of after three rounds of costing theater." },
  { phaseName: "Design & Costing", industry: "Premium Activewear", title: "\"Why did that cost go up?\" Finally, an answer.", summary: "Marker tracks every costing round across ~50 vendors and multiple seasons, revealing pricing drift before it eats your margins. No more guessing from email timestamps." },
  { phaseName: "Design & Costing", industry: "Premium Menswear", title: "Rate card says $12. Quote says $14. Caught.", summary: "Marker auto-validates supplier quotes against contracted rate cards across hundreds of POs — catching the small overcharges that compound into serious margin leakage at ~70% margins." },
  { phaseName: "Design & Costing", industry: "Premium Menswear", title: "70 emails a day? Try zero.", summary: "Marker replaced 70-80 daily supplier emails with structured workflows and internal collaboration threads — so the team reviews and responds together instead of playing broken telephone." },
  // Phase 4: Sourcing & Negotiation
  { phaseName: "Sourcing & Negotiation", industry: "Fortune 500 Retail", title: "Same company. Five RFQ systems. Now one.", summary: "Marker unified RFQ workflows across every division into a single platform — so associates stop toggling between disconnected tools and actually see the full sourcing picture." },
  { phaseName: "Sourcing & Negotiation", industry: "Multi-Brand Apparel", title: "Two brands. Same factory. Different prices. Busted.", summary: "Marker gives the holding company a unified view across 5+ acquired brands — so they negotiate as one portfolio instead of accidentally bidding against themselves." },
  { phaseName: "Sourcing & Negotiation", industry: "Outdoor Apparel", title: "~50 vendors. Tiny team. No sweat.", summary: "Marker automates the follow-ups, status checks, and coordination overhead across email, WhatsApp, and Slack — so a lean sourcing team punches way above its weight." },
  { phaseName: "Sourcing & Negotiation", industry: "Premium Activewear", title: "Startup speed, enterprise infrastructure.", summary: "Marker gave a fast-growing brand real sourcing infrastructure from the start — without the bloated systems, migration headaches, and process debt that slow down the incumbents." },
  // Phase 5: Order Management
  { phaseName: "Order Management", industry: "Office & Business Supply Chain", title: "\"Every customer emails orders differently.\" Solved.", summary: "Marker parses unstructured email orders across 50 fulfillment centers — every format, every customer — into clean, actionable data that flows straight into OMS and WMS." },
  { phaseName: "Order Management", industry: "Multi-Brand Sports Retail", title: "560 budget meetings. Zero spreadsheet errors.", summary: "Marker replaced the manual Excel gauntlet across 20 brands with automated reconciliation — eliminating the copy-paste errors that compounded across seasons and cost real money." },
  { phaseName: "Order Management", industry: "DTC Furniture", title: "\"Where's my PO?\" Ask Marker, not the factory.", summary: "Marker auto-tracks every PO from issue to delivery — pulling status updates from factory communication so the team sees a live dashboard instead of chasing WhatsApp threads." },
  { phaseName: "Order Management", industry: "DTC Footwear", title: "Your analysts have better things to do.", summary: "Marker automated invoice reconciliation, payment tracking, and return processing — freeing supply chain analysts to finally spend their days on cost optimization and vendor strategy." },
  // Phase 6: Production & Delivery
  { phaseName: "Production & Delivery", industry: "Premium Menswear", title: "Ship date moved? Everyone knows. Instantly.", summary: "Marker auto-cascades every ship date change to logistics, merchants, and marketing in real time — no more manually forwarded emails that arrive after downstream teams have already planned around the old date." },
  { phaseName: "Production & Delivery", industry: "Lifestyle Apparel", title: "Deadlines don't get missed. They get flagged.", summary: "Marker connects communication history to every milestone across a multi-quarter calendar — surfacing at-risk deadlines before they're missed, not after." },
  { phaseName: "Production & Delivery", industry: "DTC Footwear", title: "WeChat. WhatsApp. Email. One timeline.", summary: "Marker pulls 50+ scattered message threads into a single, searchable supplier timeline — so critical material updates and ship dates never get lost between channels again." },
  // Phase 7: Compliance & Continuous Improvement
  { phaseName: "Compliance & Continuous Improvement", industry: "Luxury Beauty Retail", title: "Compliance and sourcing, finally in the same room.", summary: "Marker links audit findings directly to sourcing workflows — so risk information reaches decision-makers in context and on time, not as a disconnected PDF three weeks later." },
  { phaseName: "Compliance & Continuous Improvement", industry: "Fortune 500 Retail", title: "12 tools deployed. Everyone still uses Excel.", summary: "Marker replaced the tool sprawl with one transparent platform that shows its work — so associates actually adopted it instead of defaulting back to the spreadsheet they trust." },
  { phaseName: "Compliance & Continuous Improvement", industry: "Global Apparel Manufacturing", title: "Dozens of brand portals. One workflow.", summary: "Marker replaced the daily portal-hopping across dozens of brand PLMs with communication-first workflows — giving thin-margin manufacturers their time back where it matters most." },
  { phaseName: "Compliance & Continuous Improvement", industry: "Outdoor Apparel", title: "\"Why was that shipment late?\" Receipts included.", summary: "Marker auto-generates end-of-season hindsight reports from real communication data — replacing memory-and-anecdote postmortems with timestamped, searchable delivery timelines." },
];
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Marker — Trade Show Loop (Original)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --primary: #2e7d57;
      --bg: #ffffff;
      --bg-muted: #f9fafb;
      --text: #1a1a1a;
      --text-muted: #6b7280;
      --border: #e5e7eb;
    }

    html, body {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: var(--bg);
      font-family: 'Inter', system-ui, sans-serif;
      color: var(--text);
    }

    .scene { position: fixed; inset: 0; }

    .slide {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transform: scale(0.94);
      transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
                  transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
      padding: 48px 80px;
    }

    .slide.active {
      opacity: 1;
      transform: scale(1);
      pointer-events: auto;
    }

    .slide.zoom-out {
      opacity: 0;
      transform: scale(1.08);
    }

    .logo-slide { gap: 36px; background: var(--bg); }
    .logo-img { height: 80px; width: auto; filter: brightness(0); }

    .tagline {
      font-size: 4.5rem;
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.1;
      text-align: center;
      color: var(--text);
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.6s 0.3s ease, transform 0.6s 0.3s ease;
    }

    .tagline .accent { color: var(--primary); }
    .slide.active .tagline { opacity: 1; transform: translateY(0); }

    .shoptalk-badge {
      position: absolute;
      bottom: 48px;
      font-size: 1.05rem;
      color: var(--text-muted);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      opacity: 0;
      transition: opacity 0.6s 0.8s ease;
    }
    .slide.active .shoptalk-badge { opacity: 1; }

    .bg-circle { position: fixed; border-radius: 50%; pointer-events: none; z-index: -1; }
    .bg-circle-1 {
      width: 500px; height: 500px;
      top: -180px; right: -120px;
      background: radial-gradient(circle, rgba(46,125,87,0.06) 0%, transparent 70%);
      animation: drift1 22s ease-in-out infinite;
    }
    .bg-circle-2 {
      width: 400px; height: 400px;
      bottom: -150px; left: -100px;
      background: radial-gradient(circle, rgba(46,125,87,0.05) 0%, transparent 70%);
      animation: drift2 26s ease-in-out infinite;
    }
    @keyframes drift1 { 0%,100% { transform: translate(0,0);} 50% { transform: translate(-40px,30px);} }
    @keyframes drift2 { 0%,100% { transform: translate(0,0);} 50% { transform: translate(30px,-40px);} }

    .case-slide {
      text-align: left;
      align-items: flex-start;
      justify-content: center;
      padding: 0 7vw 40px;
      gap: 0;
    }

    .corner-bar {
      position: absolute;
      top: 0; left: 0; right: 0;
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 32px 40px;
    }
    .corner-logo { height: 48px; filter: brightness(0); }
    .corner-tagline { font-size: 1.2rem; font-weight: 500; color: var(--text); letter-spacing: -0.01em; }
    .corner-tagline .accent { color: var(--primary); }

    .case-meta {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 28px;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s 0.15s ease, transform 0.5s 0.15s ease;
    }

    .phase-name {
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--primary);
    }

    .meta-divider { width: 1px; height: 28px; background: var(--border); }

    .industry-tag {
      display: inline-block;
      padding: 6px 18px;
      background: var(--bg-muted);
      border: 1px solid var(--border);
      border-radius: 100px;
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .case-title {
      font-size: 5rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.08;
      color: var(--text);
      max-width: 95%;
      margin-bottom: 36px;
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s 0.3s ease, transform 0.5s 0.3s ease;
    }

    .case-summary {
      font-size: 1.8rem;
      color: var(--text-muted);
      line-height: 1.5;
      max-width: 85%;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s 0.5s ease, transform 0.5s 0.5s ease;
    }

    .case-accent-line {
      width: 64px;
      height: 4px;
      background: var(--primary);
      border-radius: 2px;
      margin-bottom: 28px;
      opacity: 0;
      transform: scaleX(0);
      transform-origin: left;
      transition: opacity 0.4s 0.25s ease, transform 0.4s 0.25s ease;
    }

    .slide.active .case-meta,
    .slide.active .case-title,
    .slide.active .case-summary {
      opacity: 1;
      transform: translateY(0);
    }

    .slide.active .case-accent-line {
      opacity: 1;
      transform: scaleX(1);
    }

    .progress-bar {
      position: fixed;
      bottom: 0; left: 0;
      height: 10px;
      background: var(--primary);
      z-index: 100;
      width: 0%;
      transition: none;
    }

    .debug-controls {
      position: fixed;
      left: 50%;
      bottom: 28px;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(14px);
      box-shadow: 0 12px 32px rgba(26, 26, 26, 0.08);
      z-index: 200;
    }

    .debug-button,
    .debug-status {
      border-radius: 999px;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .debug-button {
      border: 1px solid var(--border);
      background: #fff;
      color: var(--text);
      padding: 10px 16px;
      cursor: pointer;
    }

    .debug-button.is-primary {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }

    .debug-status {
      padding: 10px 14px;
      background: rgba(46, 125, 87, 0.08);
      color: var(--primary);
      white-space: nowrap;
    }
  </style>
</head>
<body>
  <div class="bg-circle bg-circle-1"></div>
  <div class="bg-circle bg-circle-2"></div>
  <div class="progress-bar" id="progress"></div>
  <div class="debug-controls">
    <button class="debug-button" id="prevButton" type="button">Prev</button>
    <button class="debug-button is-primary" id="playPauseButton" type="button">Autoplay Off</button>
    <button class="debug-button" id="nextButton" type="button">Next</button>
    <div class="debug-status" id="slideStatus">Slide 1</div>
  </div>

  <div class="scene">
    <div class="slide logo-slide" data-duration="7500" data-type="logo">
      <img src="/logo.png" alt="Marker" class="logo-img" />
      <div class="tagline">Your always-on<br /><span class="accent">supply chain coordinator</span></div>
      <div class="shoptalk-badge">Shoptalk 2026 &bull; Las Vegas</div>
    </div>

    {studies.map((study, i) => (
      <>
        <div class="slide case-slide" data-duration="9750">
          <div class="corner-bar">
            <img src="/logo.png" alt="Marker" class="corner-logo" />
            <span class="corner-tagline">Your always-on <span class="accent">supply chain coordinator</span></span>
          </div>
          <div class="case-meta">
            <span class="phase-name">{study.phaseName}</span>
            <div class="meta-divider"></div>
            <span class="industry-tag">{study.industry}</span>
          </div>
          <div class="case-accent-line"></div>
          <h2 class="case-title">{study.title}</h2>
          <p class="case-summary">{study.summary}</p>
        </div>

        {((i + 1) % 5 === 0 && i < studies.length - 1) && (
          <div class="slide logo-slide" data-duration="6000" data-type="logo">
            <img src="/logo.png" alt="Marker" class="logo-img" />
            <div class="tagline">Your always-on<br /><span class="accent">supply chain coordinator</span></div>
            <div class="shoptalk-badge">Shoptalk 2026 &bull; Las Vegas</div>
          </div>
        )}
      </>
    ))}

    <div class="slide logo-slide" data-duration="7500" data-type="logo">
      <img src="/logo.png" alt="Marker" class="logo-img" />
      <div class="tagline">Your always-on<br /><span class="accent">supply chain coordinator</span></div>
      <div class="shoptalk-badge">Visit us &bull; Shoptalk 2026 &bull; Las Vegas</div>
    </div>
  </div>

  <script>
    const slides = document.querySelectorAll('.slide');
    const progress = document.getElementById('progress');
    const prevButton = document.getElementById('prevButton');
    const nextButton = document.getElementById('nextButton');
    const playPauseButton = document.getElementById('playPauseButton');
    const slideStatus = document.getElementById('slideStatus');
    let current = 0;
    let slideTimer = null;
    let slideDuration = 0;
    let isAutoplayEnabled = false;

    function clearSlideTimer() {
      clearTimeout(slideTimer);
      slideTimer = null;
    }

    function resetProgress() {
      progress.style.transition = 'none';
      progress.style.width = '0%';
      progress.offsetWidth;
    }

    function updateControls() {
      playPauseButton.textContent = isAutoplayEnabled ? 'Autoplay On' : 'Autoplay Off';
      playPauseButton.classList.toggle('is-primary', !isAutoplayEnabled);
      slideStatus.textContent = `Slide ${current + 1} of ${slides.length}`;
    }

    function startAutoplay() {
      slideDuration = parseInt(slides[current].dataset.duration, 10);
      progress.style.transition = `width ${slideDuration}ms linear`;
      progress.style.width = '100%';
      clearSlideTimer();
      slideTimer = setTimeout(() => {
        showSlide((current + 1) % slides.length);
      }, slideDuration);
    }

    function showSlide(index) {
      clearSlideTimer();

      slides.forEach((slide, i) => {
        if (i === current && i !== index) {
          slide.classList.remove('active');
          slide.classList.add('zoom-out');
          setTimeout(() => slide.classList.remove('zoom-out'), 700);
        }
      });

      current = index;
      resetProgress();

      setTimeout(() => {
        slides[current].classList.add('active');
      }, 80);

      updateControls();

      if (isAutoplayEnabled) {
        startAutoplay();
      }
    }

    function stepTo(offset) {
      const nextIndex = (current + offset + slides.length) % slides.length;
      showSlide(nextIndex);
    }

    function toggleAutoplay() {
      isAutoplayEnabled = !isAutoplayEnabled;

      if (isAutoplayEnabled) {
        startAutoplay();
      } else {
        clearSlideTimer();
        resetProgress();
      }

      updateControls();
    }

    prevButton.addEventListener('click', () => stepTo(-1));
    nextButton.addEventListener('click', () => stepTo(1));
    playPauseButton.addEventListener('click', toggleAutoplay);

    window.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        stepTo(-1);
      } else if (event.key === 'ArrowRight') {
        stepTo(1);
      } else if (event.key === ' ' || event.key === 'Spacebar') {
        event.preventDefault();
        toggleAutoplay();
      }
    });

    showSlide(0);
  </script>
</body>
</html>

